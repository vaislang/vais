# expect: 42
# Installable vaisdb CLI package: `scripts/vaisc package` builds dist/bin/vaisdb
# with ingest/query/report subcommands over a disk-first posting index — the
# index argument names a directory holding docs.txt plus term-hash posting
# shards (terms/s<N>.txt), so the on-disk postings are the source of truth
# and per-query state stays inside the 4096 map contract while total index
# vocabulary is unbounded. Run without arguments it executes a deterministic
# self-test (the release-corpus entry); with arguments it dispatches the CLI
# subcommands with the same stdout/exit protocol as the snapshot-era CLI.
import vaisdb.index
import vaisdb.report

fn run_ingest(index_dir: Str, doc_id: Str, doc_path: Str) -> Int {
    if fs_exists(doc_path) != 1 {
        print("error: document not found")
        return 3
    }
    let body = fs_read_text(doc_path)
    let total = ingest_doc(index_dir, doc_id, body, doc_path)
    if total == 0 - 2 {
        print("error: document too large")
        return 3
    }
    if total < 0 {
        print("error: could not write index")
        return 3
    }
    print(f"ingested {doc_id} terms={total}")
    return 0
}

fn run_query(index_dir: Str, doc_id: Str, query_text: Str) -> Int {
    if index_exists(index_dir) != 1 {
        print("error: index not found")
        return 3
    }
    let query: Map<Str,Int> = {}
    let total = doc_terms_guarded_into(query_text, query)
    if total == 0 - 2 {
        print("error: query too large")
        return 1
    }
    if total == 0 {
        print("error: query has no terms")
        return 1
    }
    let score = doc_score(index_dir, doc_id, query)
    print(f"score {doc_id}={score}")
    return score
}

fn run_report(index_dir: Str, query_text: Str) -> Int {
    if index_exists(index_dir) != 1 {
        print("error: index not found")
        return 3
    }
    let query: Map<Str,Int> = {}
    let total = doc_terms_guarded_into(query_text, query)
    if total == 0 - 2 {
        print("error: query too large")
        return 1
    }
    if total == 0 {
        print("error: query has no terms")
        return 1
    }
    let best_score = top_doc_score(index_dir, query)
    if best_score < 0 {
        print("error: index has no documents")
        return 3
    }
    let best_doc = top_doc_id(index_dir, query)
    print(f"top {best_doc}={best_score}")
    return best_score
}

fn run_ingest_dir(index_dir: Str, dir: Str, recurse: Int) -> Int {
    let flow = ingest_dir_into(index_dir, dir, recurse)
    let note = match flow { Ok(count) => count, Err(msg) => msg }
    if flow_failed(note) == 1 {
        print(f"error: {note}")
        return 3
    }
    print(f"ingested {note} documents")
    return 0
}

fn flow_failed(note: Str) -> Int {
    # ingest_dir_into Ok payloads are pure digit counts; error messages are not.
    if note.len() == 0 { return 1 }
    let first = note[0]
    if first >= 48 {
        if first <= 57 { return 0 }
    }
    return 1
}

fn run_reindex(index_dir: Str, dir: Str, recurse: Int) -> Int {
    let flow = reindex_dir_into(index_dir, dir, recurse)
    let note = match flow { Ok(rc) => rc, Err(msg) => msg }
    if flow_failed(note) == 1 {
        print(f"error: {note}")
        return 3
    }
    let parts = note.split(" ")
    if parts.len() != 4 {
        print("error: could not write index")
        return 3
    }
    print(f"reindexed added={parts[0]} updated={parts[1]} removed={parts[2]} skipped={parts[3]}")
    return 0
}

fn run_rank(index_dir: Str, query_text: Str, k: Int) -> Int {
    if index_exists(index_dir) != 1 {
        print("error: index not found")
        return 3
    }
    let query: Map<Str,Int> = {}
    let total = doc_terms_guarded_into(query_text, query)
    if total == 0 - 2 {
        print("error: query too large")
        return 1
    }
    if total == 0 {
        print("error: query has no terms")
        return 1
    }
    if k < 1 {
        print("error: rank count must be positive")
        return 1
    }
    let report = rank_lines(index_dir, query, k)
    print(report)
    return top_doc_score(index_dir, query)
}

fn run_search(index_dir: Str, query_text: Str, k: Int) -> Int {
    if index_exists(index_dir) != 1 {
        print("error: index not found")
        return 3
    }
    let query: Map<Str,Int> = {}
    let total = doc_terms_guarded_into(query_text, query)
    if total == 0 - 2 {
        print("error: query too large")
        return 1
    }
    if total == 0 {
        print("error: query has no terms")
        return 1
    }
    if k < 1 {
        print("error: search count must be positive")
        return 1
    }
    let ranked: List<RankedDoc> = []
    let count = ranked_docs_into(index_dir, query, ranked)
    if count == 0 {
        print("error: index has no documents")
        return 3
    }
    # One registry snapshot resolves every shown hit's source path (the
    # msearch pattern); the per-hit doc_src_path re-read the whole
    # registry k times.
    let reg_ids: List<Str> = []
    let reg_srcs: List<Str> = []
    let reg_stamps: List<Int> = []
    let reg_pos: Map<Str,Int> = {}
    let rn = registry_load_into(index_dir, reg_ids, reg_srcs, reg_stamps, reg_pos)
    let mut limit = k
    if count < k { limit = count }
    let mut shown = 0
    for j in 0..limit {
        let hit = ranked[j]
        if hit.score > 0 {
            shown += 1
            let doc_id = hit.doc_id
            let hp = reg_pos.get(doc_id, 0)
            let mut src = ""
            if hp > 0 { src = reg_srcs[hp - 1] }
            let mut line = f"{shown}. {doc_id}={hit.score}"
            if src != "" and src != "-" {
                line = f"{line} {src}"
            }
            print(line)
            if src != "" and src != "-" and src.exists() {
                let sn = snippet_from_text(src.read(), query)
                if sn.len() > 0 {
                    let marked = highlight_terms(sn, query)
                    print(f"    {marked}")
                }
            }
        }
    }
    return ranked[0].score
}

struct MergedHit {
    label: Str,
    src: Str,
    score: Int,
}

# Cross-index search: rank one query over several indexes, merge by score
# with the source index visible as `<index-basename>/<doc-id>`, and print
# the top-k exactly like `search` (zero scores hidden, source path
# appended when on disk); the exit code is the best merged score.
fn run_msearch(query_text: Str, k: Int, indexes: List<Str>) -> Int {
    for index_dir in indexes {
        if index_exists(index_dir) != 1 {
            print(f"error: index not found: {index_dir}")
            return 3
        }
    }
    let query: Map<Str,Int> = {}
    let total = doc_terms_guarded_into(query_text, query)
    if total == 0 - 2 {
        print("error: query too large")
        return 1
    }
    if total == 0 {
        print("error: query has no terms")
        return 1
    }
    if k < 1 {
        print("error: search count must be positive")
        return 1
    }
    let merged: List<MergedHit> = []
    for index_dir in indexes {
        let tag = path_basename(index_dir)
        let ranked: List<RankedDoc> = []
        let count = ranked_docs_into(index_dir, query, ranked)
        # One registry snapshot per index labels every hit without
        # re-reading docs.txt per document.
        let reg_ids: List<Str> = []
        let reg_srcs: List<Str> = []
        let reg_stamps: List<Int> = []
        let reg_pos: Map<Str,Int> = {}
        let rn = registry_load_into(index_dir, reg_ids, reg_srcs, reg_stamps, reg_pos)
        for hit in ranked {
            let doc_id = hit.doc_id
            let hp = reg_pos.get(doc_id, 0)
            let mut src = ""
            if hp > 0 { src = reg_srcs[hp - 1] }
            merged.push(MergedHit { label: f"{tag}/{doc_id}", src: src, score: hit.score })
        }
    }
    if merged.len() == 0 {
        print("error: indexes have no documents")
        return 3
    }
    merged.sort_by_desc(|h| h.score)
    let mut limit = k
    if merged.len() < k { limit = merged.len() }
    let mut shown = 0
    for j in 0..limit {
        let top = merged[j]
        if top.score > 0 {
            shown += 1
            let mut line = f"{shown}. {top.label}={top.score}"
            if top.src != "" and top.src != "-" {
                line = f"{line} {top.src}"
            }
            print(line)
        }
    }
    merged[0].score
}

struct TermRow {
    term: Str,
    total: Int,
}

struct PhraseRow {
    doc_id: Str,
    hits: Int,
}

# Phrase search over stored sources: every doc's on-disk source text is
# whitespace-normalized and scanned for the phrase on token boundaries
# (non-overlapping count); docs without an on-disk source are skipped —
# there is nothing to verify a word order against. Rows print as
# `N. doc=hits`, highest count first; the exit code is the number shown.
fn run_phrase(index_dir: Str, phrase_text: Str, k: Int) -> Int {
    if index_exists(index_dir) != 1 {
        print("error: index not found")
        return 3
    }
    if k < 1 {
        print("error: phrase count must be positive")
        return 1
    }
    let probe = ws_normalize(phrase_text)
    if probe.len() == 0 {
        print("error: phrase has no terms")
        return 1
    }
    # One registry snapshot supplies every doc's source path; the walk
    # iterates the parallel tables directly.
    let reg_ids: List<Str> = []
    let reg_srcs: List<Str> = []
    let reg_stamps: List<Int> = []
    let reg_pos: Map<Str,Int> = {}
    let rn = registry_load_into(index_dir, reg_ids, reg_srcs, reg_stamps, reg_pos)
    let rows: List<PhraseRow> = []
    for (pi, doc_id) in reg_ids.enumerate() {
        let src = reg_srcs[pi]
        if src.len() > 0 and src != "-" {
            let full = abs_src_path(src)
            if full.exists() {
                let hits = phrase_hits(full.read(), phrase_text)
                if hits > 0 {
                    rows.push(PhraseRow { doc_id: doc_id, hits: hits })
                }
            }
        }
    }
    rows.sort_by_desc(|r| r.hits)
    let mut shown = 0
    for row in rows.take(k) {
        shown += 1
        print(f"{shown}. {row.doc_id}={row.hits}")
    }
    shown
}

# Index-wide top terms: aggregate posting counts across every shard and
# print the k most frequent as `N. term=count` rows (default k = 10);
# the exit code is the number of rows shown.
# Index-wide term frequencies without an index-wide map: every term's
# postings live in one hash shard, so per-shard totals are complete and
# the k best rows fold across shards (min-replace against the current
# k-best, then one final sort). The whole-index vocabulary can exceed
# the 4096 map window freely; only a single shard's vocabulary is
# windowed.
fn run_top(index_dir: Str, k: Int, min_len: Int) -> Int {
    if index_exists(index_dir) != 1 {
        print("error: index not found")
        return 3
    }
    if k < 1 {
        print("error: top count must be positive")
        return 1
    }
    # Keep the k-best list inside the 4095 list contract.
    let mut kk = k
    if kk > 4095 { kk = 4095 }
    let rows: List<TermRow> = []
    let totals: Map<Str,Int> = {}
    let mut distinct = 0
    let sc = shard_count()
    for s in 0..sc {
        totals.clear()
        let dn = shard_totals_into(index_dir, s, totals)
        if dn == 0 - 2 {
            print("error: vocabulary too large")
            return 1
        }
        distinct += dn
        let tn = totals.len()
        for i in 0..tn {
            let term = totals.key_at(i)
            let tv = totals.value_at(i)
            if term.len() < min_len {
                distinct -= 1
            } else if rows.len() < kk {
                rows.push(TermRow { term: term, total: tv })
            } else {
                let mut mi = 0
                let mut mv = rows[0].total
                for j in 0..rows.len() {
                    let cand = rows[j]
                    if cand.total < mv {
                        mv = cand.total
                        mi = j
                    }
                }
                if tv > mv {
                    rows[mi] = TermRow { term: term, total: tv }
                }
            }
        }
    }
    if distinct == 0 {
        print("error: index has no postings")
        return 3
    }
    rows.sort_by_desc(|r| r.total)
    let mut shown = 0
    for row in rows.take(kk) {
        shown += 1
        print(f"{shown}. {row.term}={row.total}")
    }
    shown
}

# More-like-this: rank every indexed document against the stored source
# text of one document, drop the document itself and zero scores, and
# print the top k as `N. doc=score` rows; the exit code is the number of
# similar rows printed. Docs without an on-disk source (stdin ingests,
# pre-v2 lines) error politely instead of guessing.
fn run_similar(index_dir: Str, doc_id: Str, k: Int) -> Int {
    if index_exists(index_dir) != 1 {
        print("error: index not found")
        return 3
    }
    # One registry snapshot answers membership and the source path
    # (doc_known + doc_src_path each re-read the whole registry).
    let reg_ids: List<Str> = []
    let reg_srcs: List<Str> = []
    let reg_stamps: List<Int> = []
    let reg_pos: Map<Str,Int> = {}
    let rn = registry_load_into(index_dir, reg_ids, reg_srcs, reg_stamps, reg_pos)
    let sp = reg_pos.get(doc_id, 0)
    if sp == 0 {
        print("error: doc not found")
        return 3
    }
    if k < 1 {
        print("error: similar count must be positive")
        return 1
    }
    let src = reg_srcs[sp - 1]
    if src == "" or src == "-" {
        print("error: doc has no on-disk source")
        return 3
    }
    let full = abs_src_path(src)
    if not full.exists() {
        print("error: source file missing")
        return 3
    }
    # Per-shard query partition: the source body never builds one
    # whole-document term map, so big-vocabulary sources similar-score
    # instead of erroring (the -2 branch guards the per-shard boundary).
    let scores: Map<Str,Int> = {}
    let total = similar_scores_into(index_dir, full.read(), scores)
    if total == 0 - 2 {
        print("error: source too large")
        return 1
    }
    if total == 0 {
        print("error: source has no terms")
        return 1
    }
    let ranked: List<RankedDoc> = []
    ranked_docs_from_scores_into(index_dir, scores, ranked)
    let others: List<RankedDoc> = []
    for hit in ranked {
        if hit.doc_id != doc_id and hit.score > 0 {
            others.push(RankedDoc { doc_id: hit.doc_id, score: hit.score })
        }
    }
    let mut shown = 0
    for row in others.take(k) {
        shown += 1
        print(f"{shown}. {row.doc_id}={row.score}")
    }
    shown
}

# Relevance debugging: break a document's score for a query into per-term
# contributions (query count times doc count), one line per query term with
# absent terms shown as doc=0, then the total; the exit code is the score,
# matching the rank contract.
fn run_why(index_dir: Str, query_text: Str, doc_id: Str) -> Int {
    if index_exists(index_dir) != 1 {
        print("error: index not found")
        return 3
    }
    let query: Map<Str,Int> = {}
    let total = doc_terms_guarded_into(query_text, query)
    if total == 0 - 2 {
        print("error: query too large")
        return 1
    }
    if total == 0 {
        print("error: query has no terms")
        return 1
    }
    if doc_known(index_dir, doc_id) != 1 {
        print("error: doc not found")
        return 3
    }
    let mut score = 0
    print(f"why {doc_id} query={query_text}")
    let qn = query.len()
    for i in 0..qn {
        let term = query.key_at(i)
        let q = query.value_at(i)
        let d = term_doc_count(index_dir, term, doc_id)
        score += q * d
        print(f"  {term} q={q} doc={d} adds {q * d}")
    }
    print(f"score={score}")
    return score
}

fn run_ingest_stdin(index_dir: Str, doc_id: Str) -> Int {
    let body = stdin_read_all()
    if body.len() == 0 {
        print("error: empty stdin document")
        return 1
    }
    let total = ingest_doc(index_dir, doc_id, body, "-")
    if total == 0 - 2 {
        print("error: document too large")
        return 3
    }
    if total < 0 {
        print("error: could not write index")
        return 3
    }
    print(f"ingested {doc_id} terms={total}")
    return 0
}

fn run_docs(index_dir: Str) -> Int {
    if index_exists(index_dir) != 1 {
        print("error: index not found")
        return 3
    }
    let ids: List<Str> = []
    let count = docs_list_into(index_dir, ids)
    ids.sort()
    for doc_id in ids {
        print(doc_id)
    }
    return count
}

fn run_remove(index_dir: Str, doc_id: Str) -> Int {
    if index_exists(index_dir) != 1 {
        print("error: index not found")
        return 3
    }
    let removed = remove_doc(index_dir, doc_id)
    if removed == 0 {
        print("error: document not found")
        return 3
    }
    if removed < 0 {
        print("error: could not write index")
        return 3
    }
    print(f"removed {doc_id} keys={removed}")
    return 0
}

fn run_stats(index_dir: Str) -> Int {
    if index_exists(index_dir) != 1 {
        print("error: index not found")
        return 3
    }
    let ids: List<Str> = []
    let docs = docs_list_into(index_dir, ids)
    print(f"docs={docs} postings={postings_count(index_dir)}")
    return docs
}

fn usage() -> Int {
    print("usage: vaisdb ingest <index> <doc-id> <doc-file>")
    print("       vaisdb query <index> <doc-id> <query-text>")
    print("       vaisdb report <index> <query-text>")
    print("       vaisdb ingest-dir <index> <doc-dir> [-r]")
    print("       vaisdb reindex <index> <doc-dir> [-r]")
    print("       vaisdb why <index> <query> <doc-id>")
    print("       vaisdb similar <index> <doc-id> [k]")
    print("       vaisdb top <index> [k] [-min <bytes>]")
    print("       vaisdb phrase <index> <phrase-text> [k]")
    print("       vaisdb rank <index> <query-text> <k>")
    print("       vaisdb search <index> <query-text> [k]")
    print("       vaisdb msearch <query-text> <k> <index> [index...]")
    print("       vaisdb ingest-stdin <index> <doc-id>")
    print("       vaisdb docs <index>")
    print("       vaisdb remove <index> <doc-id>")
    print("       vaisdb stats <index>")
    return 1
}

fn self_test() -> Int {
    let root = fs_temp_dir()
    let dir = path_join(root, "vais-e337-selftest-index")
    index_reset(dir)

    let d1_total = ingest_doc(dir, "d1", "ai ai ai cache", "-")
    let d2_total = ingest_doc(dir, "d2", "ai cache cache", "-")
    if d1_total != 4 { return 1 }
    if d2_total != 3 { return 2 }
    if index_exists(dir) != 1 { return 3 }
    if postings_count(dir) != 4 { return 4 }

    let query: Map<Str,Int> = {}
    let query_total = doc_term_counts_into("ai cache", query)
    if query_total != 2 { return 5 }
    let s1 = doc_score(dir, "d1", query)
    let s2 = doc_score(dir, "d2", query)
    if s1 != 4 { return 6 }
    if s2 != 3 { return 7 }
    if top_doc_score(dir, query) != 4 { return 8 }
    if top_doc_id(dir, query) != "d1" { return 9 }

    # Directory ingest and ranked report reuse the same posting layout.
    let docs_dir = path_join(root, "vais-e337-selftest-docs")
    if fs_mkdirs(docs_dir) != 0 { return 10 }
    if fs_write_text(path_join(docs_dir, "d3.txt"), "vector vector cache") != 0 { return 11 }
    let dir_flow = ingest_dir_into(dir, docs_dir, 0)
    let dir_note = match dir_flow { Ok(count) => count, Err(msg) => msg }
    if dir_note != "1" { return 12 }
    let ranked = rank_lines(dir, query, 2)
    let lf = str_byte(10)
    let expected = str_concat("1. d1=4", str_concat(lf, "2. d2=3"))
    if ranked != expected { return 13 }

    # Document management: listing, stats, and removal over the same index.
    let ids: List<Str> = []
    if docs_list_into(dir, ids) != 3 { return 14 }
    if ids.contains("d3") != true { return 15 }
    ids.sort()
    if ids[0] != "d1" { return 20 }
    if ids[2] != "d3" { return 21 }
    let removed = remove_doc(dir, "d2")
    if removed != 2 { return 16 }
    let ids2: List<Str> = []
    if docs_list_into(dir, ids2) != 2 { return 17 }
    if ids2.contains("d2") == true { return 18 }
    if remove_doc(dir, "ghost") != 0 { return 19 }

    # v2 docs entries carry source paths; stdin ingests store `-`.
    if doc_src_path(dir, "d1") != "-" { return 27 }
    let d3_src = doc_src_path(dir, "d3")
    if str_ends_with(d3_src, "d3.txt") != true { return 28 }

    # Snippet extraction: first matching line, trimmed; empty on no match.
    let lf2 = str_byte(10)
    let sbody = str_concat("plain line", str_concat(lf2, str_concat("cache hit line", lf2)))
    let sq: Map<Str,Int> = {}
    let sq_total = doc_terms_guarded_into("cache", sq)
    if sq_total != 1 { return 29 }
    if snippet_from_text(sbody, sq) != "cache hit line" { return 30 }
    let nomatch: Map<Str,Int> = {}
    let nm_total = doc_terms_guarded_into("zzz", nomatch)
    if nm_total != 1 { return 33 }
    if snippet_from_text(sbody, nomatch) != "" { return 31 }

    # UTF-8 trim backs off a continuation byte split at the limit.
    let two = str_concat(str_byte(196), str_byte(145))
    let bpad = str_builder_new()
    let mut bi = 0
    while bi < 79 {
        let bp = str_builder_append(bpad, "x")
        bi = bi + 1
    }
    let bp2 = str_builder_append(bpad, two)
    let padded = str_builder_finish(bpad)
    if padded.len() != 81 { return 34 }
    let trimmed = utf8_trim(padded, 80)
    if trimmed.len() != 79 { return 32 }

    # v3 stamps: dir-ingested docs carry a positive mtime, stdin docs 0,
    # and v2-era two-field lines parse as 0 (always-stale for reindex).
    if doc_mtime(dir, "d3") <= 0 { return 35 }
    if doc_mtime(dir, "d1") != 0 { return 36 }
    let tabb = str_byte(9)
    let legacy = str_concat("legacy", str_concat(tabb, str_concat("-", str_byte(10))))
    if fs_append_text(index_docs_path(dir), legacy) != 0 { return 37 }
    if doc_mtime(dir, "legacy") != 0 { return 38 }
    # Drop the synthetic legacy entry so later doc counts stay exact
    # (zero postings removed, but the docs line is rewritten away).
    if remove_doc(dir, "legacy") != 0 { return 44 }

    # Incremental reindex: a fresh dir adds, an immediate rerun skips.
    let rdir = path_join(root, "vais-e337-selftest-reindex")
    if fs_mkdirs(rdir) != 0 { return 39 }
    if fs_write_text(path_join(rdir, "r1.txt"), "alpha beta") != 0 { return 40 }
    let ridx = path_join(root, "vais-e337-selftest-reindex-idx")
    index_reset(ridx)
    let r_flow = reindex_dir_into(ridx, rdir, 0)
    let r_note = match r_flow { Ok(rc1) => rc1, Err(msg) => msg }
    if r_note != "1 0 0 0" { return 41 }
    let r_flow2 = reindex_dir_into(ridx, rdir, 0)
    let r_note2 = match r_flow2 { Ok(rc2) => rc2, Err(msg) => msg }
    if r_note2 != "0 0 0 1" { return 43 }

    # Deletion sync: a vanished source file leaves the walk as removed=1
    # while the surviving doc still skips.
    let r2 = path_join(rdir, "r2.txt")
    if r2.write("gamma delta") != 0 { return 45 }
    let r_flow3 = reindex_dir_into(ridx, rdir, 0)
    let r_note3 = match r_flow3 { Ok(rc3) => rc3, Err(msg) => msg }
    if r_note3 != "1 0 0 1" { return 46 }
    if fs_remove(r2) != 0 { return 47 }
    let r_flow4 = reindex_dir_into(ridx, rdir, 0)
    let r_note4 = match r_flow4 { Ok(rc4) => rc4, Err(msg) => msg }
    if r_note4 != "0 0 1 1" { return 48 }
    let r_ids: List<Str> = []
    if docs_list_into(ridx, r_ids) != 1 { return 49 }

    # The why breakdown reads exact per-term posting counts: r1 holds
    # "alpha beta", so a doubled beta query scores 1*1 + 2*1 = 3.
    if term_doc_count(ridx, "alpha", "r1") != 1 { return 50 }
    if term_doc_count(ridx, "beta", "r1") != 1 { return 51 }
    if term_doc_count(ridx, "missing", "r1") != 0 { return 52 }
    let wq: Map<Str,Int> = {}
    let wt = doc_terms_guarded_into("alpha beta beta", wq)
    if wt != 3 { return 54 }
    if doc_score(ridx, "r1", wq) != 3 { return 53 }

    # The guarded counter matches builtin tokenization on small bodies.
    let eq: Map<Str,Int> = {}
    if doc_terms_guarded_into("ai ai ai cache", eq) != 4 { return 25 }
    if eq.get("ai", 0) != 3 { return 26 }

    # Compound tokens split on every non-word ASCII byte for indexing
    # and queries alike (single is_word_byte source), so hyphen, dot,
    # and underscore compounds match their parts; bytes >= 128 stay
    # word bytes, keeping multibyte text whole.
    let ct: Map<Str,Int> = {}
    if doc_terms_guarded_into("test-fixpoint-full fixpoint_full.vais", ct) != 6 { return 81 }
    if ct.get("fixpoint", 0) != 2 { return 82 }
    if ct.get("vais", 0) != 1 { return 83 }

    # The whole-document counter still reports -2 past the 4096 window
    # (query and similar sources keep that guard), but ingest tokenizes
    # per shard, so the same 4100-distinct-term document now indexes —
    # its window is the per-shard vocabulary (~1/64) — and its terms
    # score like any other doc.
    let bb = str_builder_new()
    let mut w = 0
    while w < 4100 {
        let a1 = str_builder_append(bb, Str(w))
        let a2 = str_builder_append(bb, " ")
        w = w + 1
    }
    let big = str_builder_finish(bb)
    let probe: Map<Str,Int> = {}
    if doc_terms_guarded_into(big, probe) != 0 - 2 { return 22 }
    if ingest_doc(dir, "huge", big, "-") != 4100 { return 23 }
    let ids3: List<Str> = []
    if docs_list_into(dir, ids3) != 3 { return 24 }
    let hq: Map<Str,Int> = {}
    if doc_terms_guarded_into("4099", hq) != 1 { return 79 }
    if doc_score(dir, "huge", hq) != 1 { return 80 }

    # Cross-index merge: hits from different indexes sort by score while
    # keeping their `<index>/<doc>` labels and source paths.
    let merged: List<MergedHit> = []
    merged.push(MergedHit { label: "a/r1", src: "-", score: 1 })
    merged.push(MergedHit { label: "b/b1", src: "-", score: 3 })
    merged.sort_by_desc(|h| h.score)
    if merged[0].label != "b/b1" { return 55 }
    if merged[1].score != 1 { return 56 }

    # More-like-this: the source doc ranks itself first, so exclusion
    # leaves the overlapping neighbor as the top similar row.
    let sdir = path_join(root, "vais-e337-selftest-similar-docs")
    if fs_mkdirs(sdir) != 0 { return 57 }
    let sf1 = path_join(sdir, "s1.txt")
    let sf2 = path_join(sdir, "s2.txt")
    let sf3 = path_join(sdir, "s3.txt")
    if sf1.write("alpha beta gamma") != 0 { return 58 }
    if sf2.write("alpha beta") != 0 { return 59 }
    if sf3.write("zeta") != 0 { return 60 }
    let sidx = path_join(root, "vais-e337-selftest-similar-idx")
    index_reset(sidx)
    let s_flow = reindex_dir_into(sidx, sdir, 0)
    let s_note = match s_flow { Ok(sc) => sc, Err(smsg) => smsg }
    if s_note != "3 0 0 0" { return 61 }
    let s_query: Map<Str,Int> = {}
    if doc_terms_guarded_into(sf1.read(), s_query) != 3 { return 62 }
    let s_ranked: List<RankedDoc> = []
    ranked_docs_into(sidx, s_query, s_ranked)
    if s_ranked[0].doc_id != "s1" { return 63 }
    if s_ranked[1].doc_id != "s2" { return 64 }
    if s_ranked[1].score != 2 { return 65 }

    # Per-shard totals partition the vocabulary: summing every shard's
    # distinct count and folding its entries reconstructs the exact
    # index-wide totals without one index-wide map.
    let t_shard: Map<Str,Int> = {}
    let mut t_distinct = 0
    let mut t_alpha = 0
    let mut t_zeta = 0
    let t_sc = shard_count()
    for ts in 0..t_sc {
        t_shard.clear()
        let t_dn = shard_totals_into(sidx, ts, t_shard)
        if t_dn < 0 { return 66 }
        t_distinct += t_dn
        t_alpha += t_shard.get("alpha", 0)
        t_zeta += t_shard.get("zeta", 0)
    }
    if t_distinct != 4 { return 66 }
    if t_alpha != 2 { return 67 }
    if t_zeta != 1 { return 68 }

    # Phrase matching: token boundaries, whitespace normalization across
    # line breaks, and non-overlapping counts.
    if phrase_hits("alpha beta gamma", "alpha beta") != 1 { return 69 }
    if phrase_hits("ralpha betas", "alpha beta") != 0 { return 70 }
    if phrase_hits("alpha\n  beta", "alpha beta") != 1 { return 71 }
    if phrase_hits("a a a", "a a") != 1 { return 72 }
    if phrase_hits(sf1.read(), "beta gamma") != 1 { return 73 }

    # Snippet highlighting wraps every query-term occurrence with [ ]
    # markers in one left-to-right pass (substring semantics, like the
    # snippet selection itself).
    let hq: Map<Str,Int> = {}
    if doc_terms_guarded_into("cache ai", hq) != 2 { return 74 }
    if highlight_terms("cache hit ai cache", hq) != "[cache] hit [ai] [cache]" { return 75 }
    if highlight_terms("caches", hq) != "[cache]s" { return 76 }
    if highlight_terms("plain line", hq) != "pl[ai]n line" { return 77 }
    if highlight_terms("plush lump", hq) != "plush lump" { return 78 }

    # 4*10 + 3 - 1 = 42
    return s1 * 10 + s2 - 1
}

fn main() -> Int {
    if proc_argc() == 0 { return self_test() }
    let command = proc_arg(0)
    if command == "ingest" {
        if proc_argc() != 4 { return usage() }
        return run_ingest(proc_arg(1), proc_arg(2), proc_arg(3))
    }
    if command == "query" {
        if proc_argc() != 4 { return usage() }
        return run_query(proc_arg(1), proc_arg(2), proc_arg(3))
    }
    if command == "report" {
        if proc_argc() != 3 { return usage() }
        return run_report(proc_arg(1), proc_arg(2))
    }
    if command == "ingest-dir" {
        if proc_argc() == 3 { return run_ingest_dir(proc_arg(1), proc_arg(2), 0) }
        if proc_argc() == 4 and proc_arg(3) == "-r" { return run_ingest_dir(proc_arg(1), proc_arg(2), 1) }
        return usage()
    }
    if command == "phrase" {
        if proc_argc() == 3 { return run_phrase(proc_arg(1), proc_arg(2), 5) }
        if proc_argc() == 4 { return run_phrase(proc_arg(1), proc_arg(2), parse_int(proc_arg(3))) }
        return usage()
    }
    if command == "top" {
        if proc_argc() == 2 { return run_top(proc_arg(1), 10, 0) }
        if proc_argc() == 3 { return run_top(proc_arg(1), parse_int(proc_arg(2)), 0) }
        if proc_argc() == 4 and proc_arg(2) == "-min" { return run_top(proc_arg(1), 10, parse_int(proc_arg(3))) }
        if proc_argc() == 5 and proc_arg(3) == "-min" { return run_top(proc_arg(1), parse_int(proc_arg(2)), parse_int(proc_arg(4))) }
        return usage()
    }
    if command == "similar" {
        if proc_argc() == 3 { return run_similar(proc_arg(1), proc_arg(2), 5) }
        if proc_argc() == 4 { return run_similar(proc_arg(1), proc_arg(2), parse_int(proc_arg(3))) }
        return usage()
    }
    if command == "why" {
        if proc_argc() != 4 { return usage() }
        return run_why(proc_arg(1), proc_arg(2), proc_arg(3))
    }
    if command == "reindex" {
        if proc_argc() == 3 { return run_reindex(proc_arg(1), proc_arg(2), 0) }
        if proc_argc() == 4 and proc_arg(3) == "-r" { return run_reindex(proc_arg(1), proc_arg(2), 1) }
        return usage()
    }
    if command == "rank" {
        if proc_argc() != 4 { return usage() }
        return run_rank(proc_arg(1), proc_arg(2), parse_int(proc_arg(3)))
    }
    if command == "search" {
        if proc_argc() == 3 { return run_search(proc_arg(1), proc_arg(2), 5) }
        if proc_argc() == 4 { return run_search(proc_arg(1), proc_arg(2), parse_int(proc_arg(3))) }
        return usage()
    }
    if command == "msearch" {
        if proc_argc() < 4 { return usage() }
        let argv = args()
        let indexes: List<Str> = []
        for i in 3..argv.len() {
            indexes.push(argv[i])
        }
        return run_msearch(argv[1], parse_int(argv[2]), indexes)
    }
    if command == "ingest-stdin" {
        if proc_argc() != 3 { return usage() }
        return run_ingest_stdin(proc_arg(1), proc_arg(2))
    }
    if command == "docs" {
        if proc_argc() != 2 { return usage() }
        return run_docs(proc_arg(1))
    }
    if command == "remove" {
        if proc_argc() != 3 { return usage() }
        return run_remove(proc_arg(1), proc_arg(2))
    }
    if command == "stats" {
        if proc_argc() != 2 { return usage() }
        return run_stats(proc_arg(1))
    }
    print("error: unknown subcommand")
    return 2
}

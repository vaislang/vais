# Disk-first index primitives shared by the vaisdb package commands.
#
# Layout: an index is a directory —
#   <index>/docs.txt            one doc id per line (membership + stats)
#   <index>/terms/s<N>.txt      posting shards, lines `term<TAB>doc<TAB>count`
#
# The disk is the source of truth: ingest appends postings per term-hash
# shard (fs_append_text), queries stream-scan only the shards their terms
# hash to, and per-query state lives in maps bounded by the 4096 map
# contract (docs matched per query). Doc ids are capped by the 4095 list
# contract when listed; posting volume per shard is unbounded, so every
# whole-shard walk below stays a byte scan on purpose.
#
# Crash model: whole-file rewrites go temp-then-rename (never a torn
# file), the registry append is each ingest's commit point (a crash
# before it leaves orphan postings that queries never surface, because
# ranking walks registry ids), and scan-side last-wins dedup keeps
# scores exact if a retried ingest duplicates postings until the next
# update rewrites them away. Diagnostic totals (stats/top) may count
# orphan or duplicate lines during such a window.

fn shard_count() -> Int {
    64
}

# Single hash source for shard routing: the Str spelling delegates to
# the byte-range form, so an in-place body scan and an allocated term
# can never drift to different shards (drift would make postings
# invisible to every reader).
fn token_shard_at(text: Str, start: Int, end: Int) -> Int {
    let mut h = 0
    let mut i = start
    while i < end {
        h = (h * 31 + text[i]) % 100003
        i += 1
    }
    h % shard_count()
}

fn term_shard(term: Str) -> Int {
    token_shard_at(term, 0, term.len())
}

fn index_docs_path(index_dir: Str) -> Str {
    path_join(index_dir, "docs.txt")
}

fn index_shard_path(index_dir: Str, shard: Int) -> Str {
    let terms_dir = path_join(index_dir, "terms")
    path_join(terms_dir, f"s{shard}.txt")
}

fn index_exists(index_dir: Str) -> Int {
    fs_exists(index_docs_path(index_dir))
}

fn index_init(index_dir: Str) -> Int {
    fs_mkdirs(path_join(index_dir, "terms"))
}

# Atomic whole-file rewrite: land the full new content in `<path>.tmp`,
# then rename it over the target. POSIX rename replaces atomically
# within one filesystem, so a reader (or a crash) never observes a
# truncated half-written file — the rewrite either fully lands or the
# old content survives, with at worst a stale `.tmp` sibling left for
# index_reset to sweep.
fn write_text_atomic(path: Str, text: Str) -> Int {
    let tmp = f"{path}.tmp"
    if fs_write_text(tmp, text) != 0 { return 1 }
    fs_rename(tmp, path)
}

fn index_reset(index_dir: Str) -> Int {
    fs_remove(index_docs_path(index_dir))
    let docs_tmp = f"{index_docs_path(index_dir)}.tmp"
    fs_remove(docs_tmp)
    let sc = shard_count()
    for s in 0..sc {
        fs_remove(index_shard_path(index_dir, s))
        let shard_tmp = f"{index_shard_path(index_dir, s)}.tmp"
        fs_remove(shard_tmp)
    }
    0
}

# docs.txt lines are `id<TAB>source-path<TAB>mtime` (v3); bare-id and v2
# two-field lines from older
# indexes still parse (snippets/stamps are simply unavailable). This helper
# keeps returning ids only, so every caller stays format-agnostic.
fn docs_list_into(index_dir: Str, out: List<Str>) -> Int {
    let path = index_docs_path(index_dir)
    if not path.exists() { return 0 }
    let tab = "\t"
    let text = path.read()
    let mut pushed = 0
    for line in text.lines() {
        let parts = line.split(tab)
        if parts.len() >= 1 {
            out.push(parts[0])
            pushed += 1
        }
    }
    pushed
}

fn doc_src_path(index_dir: Str, doc_id: Str) -> Str {
    let path = index_docs_path(index_dir)
    if not path.exists() { return "" }
    let tab = "\t"
    let text = path.read()
    for line in text.lines() {
        let parts = line.split(tab)
        if parts.len() >= 2 and parts[0] == doc_id {
            return parts[1]
        }
    }
    ""
}

# Batch registry snapshot: docs.txt loaded once into parallel tables
# (id, source path or "", stamp or 0) plus a 1-based position map for
# id lookups (0 = absent). Per-doc loops thread these down instead of
# re-reading the registry per call — the doc count stays inside the 4095
# list contract, which also keeps the position map inside the 4096 map
# window. Line semantics mirror docs_list_into exactly.
fn registry_load_into(index_dir: Str, ids: List<Str>, srcs: List<Str>, stamps: List<Int>, at: Map<Str,Int>) -> Int {
    let path = index_docs_path(index_dir)
    if not path.exists() { return 0 }
    let tab = "\t"
    let text = path.read()
    let mut count = 0
    for line in text.lines() {
        let parts = line.split(tab)
        if parts.len() >= 1 {
            ids.push(parts[0])
            if parts.len() >= 2 { srcs.push(parts[1]) } else { srcs.push("") }
            if parts.len() >= 3 { stamps.push(parse_int(parts[2])) } else { stamps.push(0) }
            at.insert(parts[0], count + 1)
            count += 1
        }
    }
    count
}

fn abs_src_path(p: Str) -> Str {
    if p.len() == 0 { return "-" }
    if p == "-" { return "-" }
    if p[0] == 47 { return p }
    path_join(fs_cwd(), p)
}

fn doc_known(index_dir: Str, doc_id: Str) -> Int {
    let ids: List<Str> = []
    let n = docs_list_into(index_dir, ids)
    for known_id in ids {
        if known_id == doc_id { return 1 }
    }
    0
}

# Search tokenization: a word is a maximal run of ASCII alphanumerics
# and bytes >= 128 (UTF-8 sequences — Korean text stays whole), so
# hyphen/underscore/dot compounds and markdown punctuation split
# (`test-fixpoint-full` indexes as test/fixpoint/full and a query for
# `fixpoint` hits it). Ingest and query MUST share this predicate —
# an asymmetric split would make indexed terms unreachable. `phrase`
# deliberately keeps its separate whitespace source-text semantics.
fn is_word_byte(c: Int) -> Int {
    if c >= 48 and c <= 57 { return 1 }
    if c >= 65 and c <= 90 { return 1 }
    if c >= 97 and c <= 122 { return 1 }
    if c >= 128 { return 1 }
    0
}

# Streaming word counter with a capacity window: byte-scans word-run
# tokenization (is_word_byte) and guards the map before every fresh
# insert, so a text whose vocabulary exceeds the 4096 map window
# reports -2 instead of trapping the whole process. Query text and
# similar sources keep this whole-text window; ingest runs per shard.
fn doc_terms_guarded_into(body: Str, counts: Map<Str,Int>) -> Int {
    let n = body.len()
    let mut pos = 0
    let mut total = 0
    while pos < n {
        if is_word_byte(body[pos]) == 0 {
            pos += 1
        } else {
            let start = pos
            while pos < n {
                if is_word_byte(body[pos]) == 0 { break }
                pos += 1
            }
            let word = field_copy(body, start, pos)
            if counts.contains(word) {
                let prev = counts.get(word, 0)
                counts.insert(word, prev + 1)
            } else {
                if counts.len() >= 4096 { return 0 - 2 }
                counts.insert(word, 1)
            }
            total += 1
        }
    }
    total
}

# Shard-filtered word counter: tokens hash in place (token_shard_at)
# and only the words routed to `shard` are copied out and counted, so
# one document's map window is its per-shard vocabulary (~1/64 of the
# document) instead of its whole vocabulary — the 4096 window then
# admits ~260k-distinct-term documents. -2 keeps the window contract at
# the (practically unreachable) per-shard boundary. field_copy keeps
# the copy O(word) — the checked str_slice would re-scan the whole body
# per word.
fn doc_terms_shard_into(body: Str, shard: Int, counts: Map<Str,Int>) -> Int {
    let n = body.len()
    let mut pos = 0
    let mut total = 0
    while pos < n {
        if is_word_byte(body[pos]) == 0 {
            pos += 1
        } else {
            let start = pos
            while pos < n {
                if is_word_byte(body[pos]) == 0 { break }
                pos += 1
            }
            if token_shard_at(body, start, pos) == shard {
                let word = field_copy(body, start, pos)
                if counts.contains(word) {
                    let prev = counts.get(word, 0)
                    counts.insert(word, prev + 1)
                } else {
                    if counts.len() >= 4096 { return 0 - 2 }
                    counts.insert(word, 1)
                }
                total += 1
            }
        }
    }
    total
}

# Core ingest with the registry-membership decision passed in, so batch
# callers (reindex) supply it from their snapshot instead of triggering a
# whole-registry read per document. Tokenization runs once per shard
# with the shard filter above, so no whole-document term map ever
# exists; a -2 mid-walk can leave orphan postings for an unregistered
# doc, which the crash model already covers (orphans stay invisible and
# the next reindex converges).
fn ingest_doc_known(index_dir: Str, doc_id: Str, body: Str, src_path: Str, known: Int) -> Int {
    if index_init(index_dir) != 0 { return 0 - 1 }
    # One counts map reused across the shard passes: a let inside the
    # loop keeps its slot's prior contents, so the reset is an explicit
    # clear at the top of every pass.
    let counts: Map<Str,Int> = {}
    let mut total = 0
    let sc = shard_count()
    for s in 0..sc {
        counts.clear()
        let shard_total = doc_terms_shard_into(body, s, counts)
        if shard_total < 0 { return 0 - 2 }
        total += shard_total
        let cn = counts.len()
        if cn > 0 {
            let b = str_builder_new()
            for i in 0..cn {
                let term = counts.key_at(i)
                let ab1 = str_builder_append(b, term)
                let ab2 = str_builder_append(b, "\t")
                let ab3 = str_builder_append(b, doc_id)
                let ab4 = str_builder_append(b, "\t")
                let ab5 = str_builder_append(b, Str(counts.value_at(i)))
                let ab6 = str_builder_append(b, "\n")
            }
            let chunk = str_builder_finish(b)
            if fs_append_text(index_shard_path(index_dir, s), chunk) != 0 { return 0 - 1 }
        }
    }
    if known != 1 {
        let src = abs_src_path(src_path)
        let mut stamp = 0
        if src != "-" { stamp = fs_mtime(src) }
        let entry = f"{doc_id}\t{src}\t{stamp}\n"
        if fs_append_text(index_docs_path(index_dir), entry) != 0 { return 0 - 1 }
    }
    total
}

fn ingest_doc(index_dir: Str, doc_id: Str, body: Str, src_path: Str) -> Int {
    ingest_doc_known(index_dir, doc_id, body, src_path, doc_known(index_dir, doc_id))
}

# Stored ingest-time stamp for a doc; 0 for stdin docs, missing docs, and
# v2-era entries without a stamp (which reindex treats as always-stale).
fn doc_mtime(index_dir: Str, doc_id: Str) -> Int {
    let path = index_docs_path(index_dir)
    if not path.exists() { return 0 }
    let tab = "\t"
    let text = path.read()
    for line in text.lines() {
        let parts = line.split(tab)
        if parts.len() >= 3 and parts[0] == doc_id {
            return parse_int(parts[2])
        }
    }
    0
}

# Byte-window helpers for the shard scanners: copy or parse one field of
# a posting line without slicing it out of the whole shard text. The
# user-level str_slice re-validates its bounds against the full source on
# every call, which made per-line slicing quadratic in the shard size;
# these walk offsets the scan loop already proved in-bounds.
fn field_copy(text: Str, start: Int, end: Int) -> Str {
    let b = str_builder_new()
    let mut i = start
    while i < end {
        let pushed = str_builder_push(b, text[i])
        i += 1
    }
    str_builder_finish(b)
}

fn field_digits(text: Str, start: Int, end: Int) -> Int {
    let mut v = 0
    let mut i = start
    while i < end {
        let c = text[i]
        if c >= 48 and c <= 57 {
            v = v * 10 + (c - 48)
        }
        i += 1
    }
    v
}

# Stream one shard for one query term, folding weight*count into scores.
# (Byte scan: a shard's posting volume is unbounded, so no line list; the
# `term<TAB>` prefix is matched in place, so non-matching lines allocate
# nothing and only real hits copy their doc field out.) Per-doc
# contributions collect in a last-wins map before folding into scores:
# a crash-retried ingest can leave duplicate postings for one (term,
# doc) pair until the next update rewrites them away, and last-wins
# keeps query scores exact through that window instead of double
# counting.
fn scan_term_scores(index_dir: Str, term: Str, weight: Int, scores: Map<Str,Int>) -> Int {
    let path = index_shard_path(index_dir, term_shard(term))
    if not path.exists() { return 0 }
    let text = path.read()
    let n = text.len()
    let tn = term.len()
    let contrib: Map<Str,Int> = {}
    let mut pos = 0
    let mut hits = 0
    while pos < n {
        let mut le = pos
        while le < n {
            if text[le] == 10 { break }
            le += 1
        }
        if pos + tn < le and text[pos + tn] == 9 {
            let mut k = 0
            let mut same = 1
            while k < tn {
                if text[pos + k] != term[k] {
                    same = 0
                    break
                }
                k += 1
            }
            if same == 1 {
                let ds = pos + tn + 1
                let mut de = ds
                while de < le {
                    if text[de] == 9 { break }
                    de += 1
                }
                if de < le {
                    let doc = field_copy(text, ds, de)
                    contrib.insert(doc, weight * field_digits(text, de + 1, le))
                    hits += 1
                }
            }
        }
        pos = le + 1
    }
    let cn = contrib.len()
    for ci in 0..cn {
        let cd = contrib.key_at(ci)
        let prev = scores.get(cd, 0)
        scores.insert(cd, prev + contrib.value_at(ci))
    }
    hits
}

fn query_scores_into(index_dir: Str, query: Map<Str,Int>, scores: Map<Str,Int>) -> Int {
    let n = query.len()
    for i in 0..n {
        let term = query.key_at(i)
        let weight = query.value_at(i)
        scan_term_scores(index_dir, term, weight, scores)
    }
    scores.len()
}

# Bit length of a non-negative Int: floor(log2(v)) + 1, and 0 for 0.
# Backs the integer rarity weight below.
fn bit_len(v: Int) -> Int {
    let mut n = 0
    let mut x = v
    while x > 0 {
        x = x / 2
        n += 1
    }
    n
}

# All-terms ranking: a doc scores only when every query term matched it
# (zero scores stay hidden by the search printer). Survivors rank by
# rarity-weighted saturated counts instead of the plain sum — the
# compound tokenizer made identifier queries drown in common split
# tokens, and even among all-terms survivors a str-heavy document
# outweighed the rare-term evidence by volume alone. Per term:
# contribution = qcount * rarity * min(dcount, 8), with
# rarity = bit_len(N / df) clamped to >= 1 (df = documents matching the
# term, free from the scan; N = registered documents; orphan postings
# can push df past N, hence the clamp). A term matching nothing is
# skipped — no document can then match every term, so the query
# naturally returns empty.
fn query_scores_all_into(index_dir: Str, query: Map<Str,Int>, scores: Map<Str,Int>) -> Int {
    let nids: List<Str> = []
    let ndocs = docs_list_into(index_dir, nids)
    let qn = query.len()
    let matched: Map<Str,Int> = {}
    let tscores: Map<Str,Int> = {}
    for i in 0..qn {
        tscores.clear()
        let hits = scan_term_scores(index_dir, query.key_at(i), 1, tscores)
        let df = tscores.len()
        if df > 0 {
            let mut rarity = bit_len(ndocs / df)
            if rarity < 1 { rarity = 1 }
            let qcount = query.value_at(i)
            for t in 0..df {
                let doc = tscores.key_at(t)
                let mut d = tscores.value_at(t)
                if d > 8 { d = 8 }
                let prev = scores.get(doc, 0)
                scores.insert(doc, prev + qcount * rarity * d)
                matched.insert(doc, matched.get(doc, 0) + 1)
            }
        }
    }
    let sn = scores.len()
    for si in 0..sn {
        let sdoc = scores.key_at(si)
        if matched.get(sdoc, 0) != qn {
            scores.insert(sdoc, 0)
        }
    }
    scores.len()
}

# More-like-this scoring for one source body without a whole-document
# query map: tokens count per shard (the ingest partition) and each
# shard's terms scan their own postings, so a source document of any
# practical vocabulary similar-scores inside the per-shard window.
fn similar_scores_into(index_dir: Str, body: Str, scores: Map<Str,Int>) -> Int {
    let counts: Map<Str,Int> = {}
    let mut total = 0
    let sc = shard_count()
    for s in 0..sc {
        counts.clear()
        let st = doc_terms_shard_into(body, s, counts)
        if st < 0 { return 0 - 2 }
        total += st
        let cn = counts.len()
        for i in 0..cn {
            let hits = scan_term_scores(index_dir, counts.key_at(i), counts.value_at(i), scores)
        }
    }
    total
}

# Whitespace-run normalization for phrase matching: every run of spaces,
# tabs, and newlines collapses to a single space, with no leading or
# trailing space, so a phrase can match across line breaks.
fn ws_normalize(body: Str) -> Str {
    let b = str_builder_new()
    let n = body.len()
    let mut pending = 0
    let mut wrote = 0
    for pos in 0..n {
        let c = body[pos]
        if c == 32 or c == 9 or c == 10 or c == 13 {
            if wrote == 1 { pending = 1 }
        } else {
            if pending == 1 {
                let sp = str_builder_push(b, 32)
                pending = 0
            }
            let ch = str_builder_push(b, c)
            wrote = 1
        }
    }
    str_builder_finish(b)
}

# Non-overlapping occurrences of the normalized phrase inside the
# normalized body, on token boundaries: a match must start at the text
# start or after a space and end at the text end or before one, so
# "alpha beta" never matches inside "ralpha betas".
fn phrase_hits(body: Str, phrase: Str) -> Int {
    let nb = ws_normalize(body)
    let np = ws_normalize(phrase)
    let pn = np.len()
    if pn == 0 { return 0 }
    let n = nb.len()
    let mut hits = 0
    let mut p = 0
    while p + pn <= n {
        let mut boundary = 1
        if p > 0 and nb[p - 1] != 32 { boundary = 0 }
        let mut matched = 0
        if boundary == 1 and nb[p] == np[0] {
            if str_slice(nb, p, pn) == np {
                let e = p + pn
                if e == n or nb[e] == 32 { matched = 1 }
            }
        }
        if matched == 1 {
            hits += 1
            p += pn
        } else {
            p += 1
        }
    }
    hits
}

# Distinct totals for ONE shard's terms; -2 when that shard's
# vocabulary exceeds the 4096 map window (per-shard boundary — the
# whole-index vocabulary never needs one map, because a term's postings
# all live in its own hash shard, so one shard's map already holds the
# complete total for every term in it). Byte scan per shard: posting
# volume is unbounded, the two tabs are walked in place, and only the
# term key is copied out per line. Removed docs never appear because
# remove_doc rewrites their posting lines away; crash-retried duplicate
# lines can inflate these diagnostic totals until the next update
# rewrites them (documented window).
fn shard_totals_into(index_dir: Str, s: Int, totals: Map<Str,Int>) -> Int {
    let path = index_shard_path(index_dir, s)
    if not path.exists() { return 0 }
    let text = path.read()
    let n = text.len()
    let mut pos = 0
    while pos < n {
        let mut le = pos
        while le < n {
            if text[le] == 10 { break }
            le += 1
        }
        let mut t1 = pos
        while t1 < le {
            if text[t1] == 9 { break }
            t1 += 1
        }
        if t1 > pos and t1 < le {
            let mut t2 = t1 + 1
            while t2 < le {
                if text[t2] == 9 { break }
                t2 += 1
            }
            if t2 < le {
                let term = field_copy(text, pos, t1)
                let add = field_digits(text, t2 + 1, le)
                if totals.contains(term) {
                    totals.insert(term, totals.get(term, 0) + add)
                } else {
                    if totals.len() >= 4096 { return 0 - 2 }
                    totals.insert(term, add)
                }
            }
        }
        pos = le + 1
    }
    totals.len()
}

# Count of one term inside one document, read from the term's shard; 0
# when the pair has no posting. Backs the `why` per-term breakdown.
# (An odd `tick and the apostrophe above lock the comment-quote scanner
# regression: whole-text pass gates must never open string state here.
# Both key fields are compared in place, so the lookup allocates
# nothing, and the last matching line wins so `why` agrees with the
# scan-side dedup over crash-retried duplicate postings.)
fn term_doc_count(index_dir: Str, term: Str, doc_id: Str) -> Int {
    let path = index_shard_path(index_dir, term_shard(term))
    if not path.exists() { return 0 }
    let text = path.read()
    let n = text.len()
    let tn = term.len()
    let dn = doc_id.len()
    let mut found = 0
    let mut pos = 0
    while pos < n {
        let mut le = pos
        while le < n {
            if text[le] == 10 { break }
            le += 1
        }
        if pos + tn < le and text[pos + tn] == 9 {
            let mut k = 0
            let mut same = 1
            while k < tn {
                if text[pos + k] != term[k] {
                    same = 0
                    break
                }
                k += 1
            }
            if same == 1 {
                let ds = pos + tn + 1
                if ds + dn < le and text[ds + dn] == 9 {
                    let mut j = 0
                    let mut dsame = 1
                    while j < dn {
                        if text[ds + j] != doc_id[j] {
                            dsame = 0
                            break
                        }
                        j += 1
                    }
                    if dsame == 1 {
                        found = field_digits(text, ds + dn + 1, le)
                    }
                }
            }
        }
        pos = le + 1
    }
    found
}

fn doc_score(index_dir: Str, doc_id: Str, query: Map<Str,Int>) -> Int {
    let scores: Map<Str,Int> = {}
    query_scores_into(index_dir, query, scores)
    scores.get(doc_id, 0)
}

# Rewrite every shard without that doc, returning the removed posting count.
# (Byte scan per shard for the same unbounded-volume reason as scanning;
# the doc field is matched in place and kept lines are copied byte-wise,
# so the rewrite never slices lines out of the whole shard text.)
fn remove_doc(index_dir: Str, doc_id: Str) -> Int {
    if doc_known(index_dir, doc_id) != 1 { return 0 }
    let dn = doc_id.len()
    let mut removed = 0
    let sc = shard_count()
    for s in 0..sc {
        let path = index_shard_path(index_dir, s)
        if path.exists() {
            let text = path.read()
            let b = str_builder_new()
            let n = text.len()
            let mut pos = 0
            while pos < n {
                let mut le = pos
                while le < n {
                    if text[le] == 10 { break }
                    le += 1
                }
                if le > pos {
                    let mut t1 = pos
                    while t1 < le {
                        if text[t1] == 9 { break }
                        t1 += 1
                    }
                    let mut keep = 1
                    if t1 < le {
                        let ds = t1 + 1
                        if ds + dn < le and text[ds + dn] == 9 {
                            let mut j = 0
                            let mut dsame = 1
                            while j < dn {
                                if text[ds + j] != doc_id[j] {
                                    dsame = 0
                                    break
                                }
                                j += 1
                            }
                            if dsame == 1 {
                                keep = 0
                                removed += 1
                            }
                        }
                    }
                    if keep == 1 {
                        let mut ci = pos
                        while ci < le {
                            let cb = str_builder_push(b, text[ci])
                            ci += 1
                        }
                        let nl = str_builder_push(b, 10)
                    }
                }
                pos = le + 1
            }
            let kept = str_builder_finish(b)
            if write_text_atomic(path, kept) != 0 { return 0 - 1 }
        }
    }
    # Rewrite docs.txt preserving full `id<TAB>path` lines.
    let tab = "\t"
    let docs_path = index_docs_path(index_dir)
    let docs_text = docs_path.read()
    let b2 = str_builder_new()
    for entry_line in docs_text.lines() {
        let entry_parts = entry_line.split(tab)
        let mut keep_doc = 1
        if entry_parts.len() >= 1 and entry_parts[0] == doc_id { keep_doc = 0 }
        if keep_doc == 1 {
            let ab9 = str_builder_append(b2, entry_line)
            let ab10 = str_builder_append(b2, "\n")
        }
    }
    let kept_docs = str_builder_finish(b2)
    if write_text_atomic(docs_path, kept_docs) != 0 { return 0 - 1 }
    removed
}

# Total posting lines across shards (streamed byte count, no line lists).
fn postings_count(index_dir: Str) -> Int {
    let mut total = 0
    let sc = shard_count()
    for s in 0..sc {
        let path = index_shard_path(index_dir, s)
        if path.exists() {
            let text = path.read()
            let n = text.len()
            for pos in 0..n {
                if text[pos] == 10 { total += 1 }
            }
        }
    }
    total
}

# Indexable text extensions; returns the suffix length to strip for the
# doc id (0 = not a text document).
fn text_suffix_len(name: Str) -> Int {
    if name.ends(".txt") { return 4 }
    if name.ends(".md") { return 3 }
    if name.ends(".vais") { return 5 }
    if name.ends(".sh") { return 3 }
    if name.ends(".c") { return 2 }
    if name.ends(".toml") { return 5 }
    if name.ends(".tsv") { return 4 }
    0
}

# Recursive variant of the directory walk: collect indexable files as
# prefix-joined relative names (`design/LANGUAGE.md`), depth-first over
# fs_list_dirs (the vaisgrep -r walk shape), so subdirectory documents
# keep collision-free doc ids after the extension strip.
fn collect_text_files(dir: Str, prefix: Str, out: List<Str>) -> Int {
    for name in dir.files() {
        if text_suffix_len(name) > 0 {
            if prefix.len() == 0 {
                out.push(name)
            } else {
                out.push(f"{prefix}/{name}")
            }
        }
    }
    for sub in dir.dirs() {
        let mut next = sub
        if prefix.len() > 0 { next = f"{prefix}/{sub}" }
        let walked = @(path_join(dir, sub), next, out)
    }
    out.len()
}

# Directory listing for the ingest walks: flat keeps the historical
# fs_list_files contract (every file, callers filter), recursive returns
# pre-filtered relative text paths.
fn dir_walk_names(dir: Str, recurse: Int, names: List<Str>) -> Int {
    if recurse == 1 { return collect_text_files(dir, "", names) }
    fs_list_files(dir, names)
}

fn ingest_dir_into(index_dir: Str, dir: Str, recurse: Int) -> Result<Str, Str> {
    let names: List<Str> = []
    let count = dir_walk_names(dir, recurse, names)
    if count == 0 { return Err("no documents in directory") }
    let mut ingested = 0
    let mut failed = 0
    for name in names {
        let ext = text_suffix_len(name)
        if ext > 0 {
            let src = path_join(dir, name)
            let body = src.read()
            let doc_id = str_slice(name, 0, name.len() - ext)
            let total = ingest_doc(index_dir, doc_id, body, src)
            if total == 0 - 2 {
                let w1 = stderr_write(f"skipped (too large): {doc_id}\n")
            } else if total < 0 {
                failed = 1
                ingested += 1
            } else {
                ingested += 1
            }
        }
    }
    if failed == 1 { return Err("could not write index") }
    if ingested == 0 { return Err("no text documents in directory") }
    return Ok(Str(ingested))
}

# Incremental refresh: new files ingest, files whose current mtime moved
# past the stored stamp are removed and re-ingested, unchanged files skip.
# Ok payload is `added updated skipped` as space-separated digits.
fn reindex_dir_into(index_dir: Str, dir: Str, recurse: Int) -> Result<Str, Str> {
    let names: List<Str> = []
    let count = dir_walk_names(dir, recurse, names)
    if count == 0 { return Err("no documents in directory") }
    let mut added = 0
    let mut updated = 0
    let mut skipped = 0
    let mut touched = 0
    let mut failed = 0
    # One registry snapshot serves the whole walk: the deletion sync
    # iterates its parallel tables directly, membership and stamps come
    # from the position map, and each ingest updates the snapshot in
    # place, so no per-doc whole-registry read remains.
    let reg_ids: List<Str> = []
    let reg_srcs: List<Str> = []
    let reg_stamps: List<Int> = []
    let reg_pos: Map<Str,Int> = {}
    let rn = registry_load_into(index_dir, reg_ids, reg_srcs, reg_stamps, reg_pos)
    # Deletion sync: entries whose stored source path vanished are removed
    # before the walk, so deleted files stop surfacing as stale search hits.
    # Docs without an on-disk path (stdin ingests, bare-id/v2 lines) are
    # kept — there is nothing on disk to check them against — and an empty
    # target dir still errors above before any cleanup runs. Removed ids
    # never reappear in the walk (their files are gone), so the snapshot
    # stays truthful for every id the walk can visit.
    let mut removed = 0
    for (ri, doc_id) in reg_ids.enumerate() {
        let src_path = reg_srcs[ri]
        if src_path.len() > 0 and src_path != "-" {
            let full = abs_src_path(src_path)
            if not full.exists() {
                if remove_doc(index_dir, doc_id) < 0 { failed = 1 } else { removed += 1 }
            }
        }
    }
    for name in names {
        let ext = text_suffix_len(name)
        if ext > 0 {
            touched += 1
            let src = path_join(dir, name)
            let full_src = abs_src_path(src)
            let cur = fs_mtime(full_src)
            let walk_id = str_slice(name, 0, name.len() - ext)
            let wp = reg_pos.get(walk_id, 0)
            let mut mode = 0
            if wp > 0 {
                let stored = reg_stamps[wp - 1]
                if stored > 0 and cur <= stored { mode = 2 }
                else { mode = 1 }
            }
            if mode == 2 {
                skipped += 1
            } else {
                if mode == 1 {
                    let dropped = remove_doc(index_dir, walk_id)
                    if dropped < 0 { failed = 1 }
                }
                let body = src.read()
                let total = ingest_doc_known(index_dir, walk_id, body, src, 0)
                if total == 0 - 2 {
                    let w1 = stderr_write(f"skipped (too large): {walk_id}\n")
                } else if total < 0 {
                    failed = 1
                } else {
                    if mode == 1 {
                        updated += 1
                        reg_stamps[wp - 1] = cur
                        reg_srcs[wp - 1] = full_src
                    }
                    if mode == 0 {
                        added += 1
                        reg_ids.push(walk_id)
                        reg_srcs.push(full_src)
                        reg_stamps.push(cur)
                        reg_pos.insert(walk_id, reg_ids.len())
                    }
                }
            }
        }
    }
    if failed == 1 { return Err("could not write index") }
    if touched == 0 { return Err("no text documents in directory") }
    return Ok(f"{added} {updated} {removed} {skipped}")
}

fn utf8_trim(line: Str, limit: Int) -> Str {
    if line.len() <= limit { return line }
    let mut end = limit
    while end > 0 {
        let b = line[end]
        if b >= 128 and b < 192 { end -= 1 } else { break }
    }
    str_slice(line, 0, end)
}

# Wrap every query-term occurrence in a display line with `[` `]` markers:
# one left-to-right pass, the first matching term in query order wins at
# each position, matches never overlap, and the substring semantics mirror
# snippet selection (so a term highlights inside a longer word too). Runs
# on the already-trimmed display slice; a term cut by the trim simply
# stays unmarked.
fn highlight_terms(line: Str, query: Map<Str,Int>) -> Str {
    let qn = query.len()
    let n = line.len()
    let b = str_builder_new()
    let mut p = 0
    while p < n {
        let mut hit_len = 0
        for qi in 0..qn {
            let term = query.key_at(qi)
            let tn = term.len()
            if hit_len == 0 and tn > 0 and p + tn <= n {
                if str_slice(line, p, tn) == term { hit_len = tn }
            }
        }
        if hit_len > 0 {
            let lb = str_builder_push(b, 91)
            let mid = str_builder_append(b, str_slice(line, p, hit_len))
            let rb = str_builder_push(b, 93)
            p += hit_len
        } else {
            let ch = str_builder_push(b, line[p])
            p += 1
        }
    }
    str_builder_finish(b)
}

# First body line containing any query term, trimmed for display; empty
# when nothing matches (case-sensitive, substring semantics). Byte scan:
# the body is a whole document, so no line list here either.
fn snippet_from_text(body: Str, query: Map<Str,Int>) -> Str {
    let n = body.len()
    let qn = query.len()
    let mut pos = 0
    while pos < n {
        let mut le = pos
        while le < n {
            if body[le] == 10 { break }
            le += 1
        }
        if le > pos {
            let line = str_slice(body, pos, le - pos)
            for qi in 0..qn {
                let term = query.key_at(qi)
                if line.has(term) {
                    let shown = line.trim()
                    return utf8_trim(shown, 80)
                }
            }
        }
        pos = le + 1
    }
    ""
}

# Disk-first index primitives shared by the vaisdb package commands.
#
# Layout: an index is a directory —
#   <index>/docs.txt            one doc id per line (membership + stats)
#   <index>/terms/s<N>.txt      posting shards, lines `term<TAB>doc<TAB>count`
#
# The disk is the source of truth: ingest appends postings per term-hash
# shard (fs_append_text), queries stream-scan only the shards their terms
# hash to, and per-query state lives in maps bounded by the 4096 map
# contract (docs matched per query). Doc ids are capped by the 4095 list
# contract when listed; posting volume per shard is unbounded, so every
# whole-shard walk below stays a byte scan on purpose.

fn shard_count() -> Int {
    64
}

fn term_shard(term: Str) -> Int {
    let n = term.len()
    let mut h = 0
    for i in 0..n {
        h = (h * 31 + term[i]) % 100003
    }
    h % shard_count()
}

fn index_docs_path(index_dir: Str) -> Str {
    path_join(index_dir, "docs.txt")
}

fn index_shard_path(index_dir: Str, shard: Int) -> Str {
    let terms_dir = path_join(index_dir, "terms")
    path_join(terms_dir, f"s{shard}.txt")
}

fn index_exists(index_dir: Str) -> Int {
    fs_exists(index_docs_path(index_dir))
}

fn index_init(index_dir: Str) -> Int {
    fs_mkdirs(path_join(index_dir, "terms"))
}

fn index_reset(index_dir: Str) -> Int {
    fs_remove(index_docs_path(index_dir))
    let sc = shard_count()
    for s in 0..sc {
        fs_remove(index_shard_path(index_dir, s))
    }
    0
}

# docs.txt lines are `id<TAB>source-path<TAB>mtime` (v3); bare-id and v2
# two-field lines from older
# indexes still parse (snippets/stamps are simply unavailable). This helper
# keeps returning ids only, so every caller stays format-agnostic.
fn docs_list_into(index_dir: Str, out: List<Str>) -> Int {
    let path = index_docs_path(index_dir)
    if not path.exists() { return 0 }
    let tab = "\t"
    let text = path.read()
    let mut pushed = 0
    for line in text.lines() {
        let parts = line.split(tab)
        if parts.len() >= 1 {
            out.push(parts[0])
            pushed += 1
        }
    }
    pushed
}

fn doc_src_path(index_dir: Str, doc_id: Str) -> Str {
    let path = index_docs_path(index_dir)
    if not path.exists() { return "" }
    let tab = "\t"
    let text = path.read()
    for line in text.lines() {
        let parts = line.split(tab)
        if parts.len() >= 2 and parts[0] == doc_id {
            return parts[1]
        }
    }
    ""
}

fn abs_src_path(p: Str) -> Str {
    if p.len() == 0 { return "-" }
    if p == "-" { return "-" }
    if p[0] == 47 { return p }
    path_join(fs_cwd(), p)
}

fn doc_known(index_dir: Str, doc_id: Str) -> Int {
    let ids: List<Str> = []
    let n = docs_list_into(index_dir, ids)
    for known_id in ids {
        if known_id == doc_id { return 1 }
    }
    0
}

# Streaming word counter with a capacity window: byte-scans whitespace-run
# tokenization (matching doc_term_counts_into) but guards the map before
# every fresh insert, so a document whose vocabulary exceeds the 4096 map
# window reports -2 instead of trapping the whole process.
fn doc_terms_guarded_into(body: Str, counts: Map<Str,Int>) -> Int {
    let n = body.len()
    let mut pos = 0
    let mut total = 0
    while pos < n {
        let b0 = body[pos]
        if b0 == 32 or b0 == 9 or b0 == 10 or b0 == 13 {
            pos += 1
        } else {
            let start = pos
            while pos < n {
                let b1 = body[pos]
                if b1 == 32 or b1 == 9 or b1 == 10 or b1 == 13 { break }
                pos += 1
            }
            let word = str_slice(body, start, pos - start)
            if counts.contains(word) {
                let prev = counts.get(word, 0)
                counts.insert(word, prev + 1)
            } else {
                if counts.len() >= 4096 { return 0 - 2 }
                counts.insert(word, 1)
            }
            total += 1
        }
    }
    total
}

fn ingest_doc(index_dir: Str, doc_id: Str, body: Str, src_path: Str) -> Int {
    let counts: Map<Str,Int> = {}
    let total = doc_terms_guarded_into(body, counts)
    if total < 0 { return 0 - 2 }
    if index_init(index_dir) != 0 { return 0 - 1 }
    let n = counts.len()
    let sc = shard_count()
    for s in 0..sc {
        let b = str_builder_new()
        let mut wrote = 0
        for i in 0..n {
            let term = counts.key_at(i)
            if term_shard(term) == s {
                let ab1 = str_builder_append(b, term)
                let ab2 = str_builder_append(b, "\t")
                let ab3 = str_builder_append(b, doc_id)
                let ab4 = str_builder_append(b, "\t")
                let ab5 = str_builder_append(b, Str(counts.value_at(i)))
                let ab6 = str_builder_append(b, "\n")
                wrote += 1
            }
        }
        let chunk = str_builder_finish(b)
        if wrote > 0 {
            if fs_append_text(index_shard_path(index_dir, s), chunk) != 0 { return 0 - 1 }
        }
    }
    if doc_known(index_dir, doc_id) != 1 {
        let src = abs_src_path(src_path)
        let mut stamp = 0
        if src != "-" { stamp = fs_mtime(src) }
        let entry = f"{doc_id}\t{src}\t{stamp}\n"
        if fs_append_text(index_docs_path(index_dir), entry) != 0 { return 0 - 1 }
    }
    total
}

# Stored ingest-time stamp for a doc; 0 for stdin docs, missing docs, and
# v2-era entries without a stamp (which reindex treats as always-stale).
fn doc_mtime(index_dir: Str, doc_id: Str) -> Int {
    let path = index_docs_path(index_dir)
    if not path.exists() { return 0 }
    let tab = "\t"
    let text = path.read()
    for line in text.lines() {
        let parts = line.split(tab)
        if parts.len() >= 3 and parts[0] == doc_id {
            return parse_int(parts[2])
        }
    }
    0
}

# Stream one shard for one query term, folding weight*count into scores.
# (Byte scan: a shard's posting volume is unbounded, so no line list.)
fn scan_term_scores(index_dir: Str, term: Str, weight: Int, scores: Map<Str,Int>) -> Int {
    let path = index_shard_path(index_dir, term_shard(term))
    if not path.exists() { return 0 }
    let tab = "\t"
    let text = path.read()
    let n = text.len()
    let mut pos = 0
    let mut hits = 0
    while pos < n {
        let mut le = pos
        while le < n {
            if text[le] == 10 { break }
            le += 1
        }
        if le > pos {
            let line = str_slice(text, pos, le - pos)
            let parts = line.split(tab)
            if parts.len() == 3 and parts[0] == term {
                let doc = parts[1]
                let prev = scores.get(doc, 0)
                scores.insert(doc, prev + weight * parse_int(parts[2]))
                hits += 1
            }
        }
        pos = le + 1
    }
    hits
}

fn query_scores_into(index_dir: Str, query: Map<Str,Int>, scores: Map<Str,Int>) -> Int {
    let n = query.len()
    for i in 0..n {
        let term = query.key_at(i)
        let weight = query.value_at(i)
        scan_term_scores(index_dir, term, weight, scores)
    }
    scores.len()
}

# Count of one term inside one document, read from the term's shard; 0
# when the pair has no posting. Backs the `why` per-term breakdown.
# (An odd `tick and the apostrophe above lock the comment-quote scanner
# regression: whole-text pass gates must never open string state here.)
fn term_doc_count(index_dir: Str, term: Str, doc_id: Str) -> Int {
    let path = index_shard_path(index_dir, term_shard(term))
    if not path.exists() { return 0 }
    let tab = str_byte(9)
    let body = path.read()
    for line in body.lines() {
        let parts = line.split(tab)
        if parts.len() == 3 and parts[0] == term and parts[1] == doc_id {
            return parse_int(parts[2])
        }
    }
    0
}

fn doc_score(index_dir: Str, doc_id: Str, query: Map<Str,Int>) -> Int {
    let scores: Map<Str,Int> = {}
    query_scores_into(index_dir, query, scores)
    scores.get(doc_id, 0)
}

# Rewrite every shard without that doc, returning the removed posting count.
# (Byte scan per shard for the same unbounded-volume reason as scanning.)
fn remove_doc(index_dir: Str, doc_id: Str) -> Int {
    if doc_known(index_dir, doc_id) != 1 { return 0 }
    let tab = "\t"
    let mut removed = 0
    let sc = shard_count()
    for s in 0..sc {
        let path = index_shard_path(index_dir, s)
        if path.exists() {
            let text = path.read()
            let b = str_builder_new()
            let n = text.len()
            let mut pos = 0
            while pos < n {
                let mut le = pos
                while le < n {
                    if text[le] == 10 { break }
                    le += 1
                }
                if le > pos {
                    let line = str_slice(text, pos, le - pos)
                    let parts = line.split(tab)
                    let mut keep = 1
                    if parts.len() == 3 and parts[1] == doc_id {
                        keep = 0
                        removed += 1
                    }
                    if keep == 1 {
                        let ab7 = str_builder_append(b, line)
                        let ab8 = str_builder_append(b, "\n")
                    }
                }
                pos = le + 1
            }
            let kept = str_builder_finish(b)
            if path.write(kept) != 0 { return 0 - 1 }
        }
    }
    # Rewrite docs.txt preserving full `id<TAB>path` lines.
    let docs_path = index_docs_path(index_dir)
    let docs_text = docs_path.read()
    let b2 = str_builder_new()
    for entry_line in docs_text.lines() {
        let entry_parts = entry_line.split(tab)
        let mut keep_doc = 1
        if entry_parts.len() >= 1 and entry_parts[0] == doc_id { keep_doc = 0 }
        if keep_doc == 1 {
            let ab9 = str_builder_append(b2, entry_line)
            let ab10 = str_builder_append(b2, "\n")
        }
    }
    let kept_docs = str_builder_finish(b2)
    if docs_path.write(kept_docs) != 0 { return 0 - 1 }
    removed
}

# Total posting lines across shards (streamed byte count, no line lists).
fn postings_count(index_dir: Str) -> Int {
    let mut total = 0
    let sc = shard_count()
    for s in 0..sc {
        let path = index_shard_path(index_dir, s)
        if path.exists() {
            let text = path.read()
            let n = text.len()
            for pos in 0..n {
                if text[pos] == 10 { total += 1 }
            }
        }
    }
    total
}

# Indexable text extensions; returns the suffix length to strip for the
# doc id (0 = not a text document).
fn text_suffix_len(name: Str) -> Int {
    if name.ends(".txt") { return 4 }
    if name.ends(".md") { return 3 }
    if name.ends(".vais") { return 5 }
    if name.ends(".sh") { return 3 }
    if name.ends(".c") { return 2 }
    if name.ends(".toml") { return 5 }
    if name.ends(".tsv") { return 4 }
    0
}

fn ingest_dir_into(index_dir: Str, dir: Str) -> Result<Str, Str> {
    let names: List<Str> = []
    let count = fs_list_files(dir, names)
    if count == 0 { return Err("no documents in directory") }
    let mut ingested = 0
    let mut failed = 0
    for name in names {
        let ext = text_suffix_len(name)
        if ext > 0 {
            let src = path_join(dir, name)
            let body = src.read()
            let doc_id = str_slice(name, 0, name.len() - ext)
            let total = ingest_doc(index_dir, doc_id, body, src)
            if total == 0 - 2 {
                let w1 = stderr_write(f"skipped (too large): {doc_id}\n")
            } else if total < 0 {
                failed = 1
                ingested += 1
            } else {
                ingested += 1
            }
        }
    }
    if failed == 1 { return Err("could not write index") }
    if ingested == 0 { return Err("no text documents in directory") }
    return Ok(Str(ingested))
}

# Incremental refresh: new files ingest, files whose current mtime moved
# past the stored stamp are removed and re-ingested, unchanged files skip.
# Ok payload is `added updated skipped` as space-separated digits.
fn reindex_dir_into(index_dir: Str, dir: Str) -> Result<Str, Str> {
    let names: List<Str> = []
    let count = fs_list_files(dir, names)
    if count == 0 { return Err("no documents in directory") }
    let mut added = 0
    let mut updated = 0
    let mut skipped = 0
    let mut touched = 0
    let mut failed = 0
    # Deletion sync: entries whose stored source path vanished are removed
    # before the walk, so deleted files stop surfacing as stale search hits.
    # Docs without an on-disk path (stdin ingests, bare-id/v2 lines) are
    # kept — there is nothing on disk to check them against — and an empty
    # target dir still errors above before any cleanup runs.
    let mut removed = 0
    let known: List<Str> = []
    let kn = docs_list_into(index_dir, known)
    for doc_id in known {
        let src_path = doc_src_path(index_dir, doc_id)
        if src_path.len() > 0 and src_path != "-" {
            let full = abs_src_path(src_path)
            if not full.exists() {
                if remove_doc(index_dir, doc_id) < 0 { failed = 1 } else { removed += 1 }
            }
        }
    }
    for name in names {
        let ext = text_suffix_len(name)
        if ext > 0 {
            touched += 1
            let src = path_join(dir, name)
            let cur = fs_mtime(abs_src_path(src))
            let walk_id = str_slice(name, 0, name.len() - ext)
            let mut mode = 0
            if doc_known(index_dir, walk_id) == 1 {
                let stored = doc_mtime(index_dir, walk_id)
                if stored > 0 and cur <= stored { mode = 2 }
                else { mode = 1 }
            }
            if mode == 2 {
                skipped += 1
            } else {
                if mode == 1 {
                    let dropped = remove_doc(index_dir, walk_id)
                    if dropped < 0 { failed = 1 }
                }
                let body = src.read()
                let total = ingest_doc(index_dir, walk_id, body, src)
                if total == 0 - 2 {
                    let w1 = stderr_write(f"skipped (too large): {walk_id}\n")
                } else if total < 0 {
                    failed = 1
                } else {
                    if mode == 1 { updated += 1 }
                    if mode == 0 { added += 1 }
                }
            }
        }
    }
    if failed == 1 { return Err("could not write index") }
    if touched == 0 { return Err("no text documents in directory") }
    return Ok(f"{added} {updated} {removed} {skipped}")
}

fn utf8_trim(line: Str, limit: Int) -> Str {
    if line.len() <= limit { return line }
    let mut end = limit
    while end > 0 {
        let b = line[end]
        if b >= 128 and b < 192 { end -= 1 } else { break }
    }
    str_slice(line, 0, end)
}

# First body line containing any query term, trimmed for display; empty
# when nothing matches (case-sensitive, substring semantics). Byte scan:
# the body is a whole document, so no line list here either.
fn snippet_from_text(body: Str, query: Map<Str,Int>) -> Str {
    let n = body.len()
    let qn = query.len()
    let mut pos = 0
    while pos < n {
        let mut le = pos
        while le < n {
            if body[le] == 10 { break }
            le += 1
        }
        if le > pos {
            let line = str_slice(body, pos, le - pos)
            for qi in 0..qn {
                let term = query.key_at(qi)
                if line.has(term) {
                    let shown = line.trim()
                    return utf8_trim(shown, 80)
                }
            }
        }
        pos = le + 1
    }
    ""
}

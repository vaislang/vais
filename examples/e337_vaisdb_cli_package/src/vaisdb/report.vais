# Top-document report helpers over the disk-first posting index.
import vaisdb.index

struct RankedDoc {
    doc_id: Str,
    score: Int,
}

fn top_doc_score(index_dir: Str, query: Map<Str,Int>) -> Int {
    let ids: List<Str> = []
    let count = docs_list_into(index_dir, ids)
    if count == 0 { return 0 - 1 }
    let scores: Map<Str,Int> = {}
    query_scores_into(index_dir, query, scores)
    let mut best_score = 0 - 1
    let mut i = 0
    while i < count {
        let doc_id = ids[i]
        let score = scores.get(doc_id, 0)
        if score > best_score { best_score = score }
        i = i + 1
    }
    return best_score
}

fn top_doc_id(index_dir: Str, query: Map<Str,Int>) -> Str {
    let ids: List<Str> = []
    let count = docs_list_into(index_dir, ids)
    let scores: Map<Str,Int> = {}
    query_scores_into(index_dir, query, scores)
    let mut best_doc = ""
    let mut best_score = 0 - 1
    let mut i = 0
    while i < count {
        let doc_id = ids[i]
        let score = scores.get(doc_id, 0)
        if score > best_score {
            best_score = score
            best_doc = doc_id
        }
        i = i + 1
    }
    return best_doc
}

fn ranked_docs_into(index_dir: Str, query: Map<Str,Int>, out: List<RankedDoc>) -> Int {
    let ids: List<Str> = []
    let count = docs_list_into(index_dir, ids)
    let scores: Map<Str,Int> = {}
    query_scores_into(index_dir, query, scores)
    let mut i = 0
    while i < count {
        let doc_id = ids[i]
        out.push(RankedDoc { doc_id: doc_id, score: scores.get(doc_id, 0) })
        i = i + 1
    }
    out.sort_by_desc(|d| d.score)
    return count
}

fn rank_lines(index_dir: Str, query: Map<Str,Int>, k: Int) -> Str {
    let ranked: List<RankedDoc> = []
    let count = ranked_docs_into(index_dir, query, ranked)
    let lf = str_byte(10)
    let mut report = ""
    let mut limit = k
    if ranked.len() < k { limit = ranked.len() }
    let mut j = 0
    while j < limit {
        let line = str_concat(Str(j + 1), str_concat(". ", str_concat(ranked[j].doc_id, str_concat("=", Str(ranked[j].score)))))
        if j == 0 { report = line } else { report = str_concat(report, str_concat(lf, line)) }
        j = j + 1
    }
    return report
}

# expect: 42
# Trailing .len() chains on user-defined Str function receivers emit on both
# engines, completing the e360 host-call chain family: return, let,
# if-condition, and arithmetic positions, with and without call arguments.

fn tag() -> Str {
    return "abc"
}

fn wrap(prefix: Str) -> Str {
    return str_concat(prefix, "!")
}

fn ret_chain() -> Int {
    return tag().len()
}

fn main() -> Int {
    # return-position chain through a helper.
    if ret_chain() != 3 { return 1 }

    # let-position chain, zero-arg receiver.
    let n = tag().len()
    if n != 3 { return 2 }

    # if-condition chain, one-arg receiver.
    if wrap("ab").len() != 3 { return 3 }

    # Arithmetic composition across two chained calls.
    if tag().len() + wrap("a").len() != 5 { return 4 }

    # (3 + 3) * 7 = 42
    return (n + wrap("xy").len()) * 7
}

# expect: 42
# vaislisp: an integer Lisp interpreter over token spans — no AST, the
# evaluator walks the token list recursively and returns (value, next)
# tuples, so the whole tree lives as `(Int, Int)` cursor math over one
# List<Str>. Surface: (+ - * / < > =), (if c a b), (define name e),
# (set name e), (defun name (params...) body), (while c body...),
# (begin e...), (print e). Values are Int; 0 is false, anything else is
# true. defun calls bind parameters dynamically with save/restore
# frames over one global Map<Str,Int>, so recursion unwinds correctly.
# Modes: no arguments runs the deterministic self-test (the
# release-corpus entry), `vaislisp <file.lisp>` evaluates a file and
# exits with the last value, `vaislisp repl` reads stdin lines until
# EOF (the demand source for the stdin_read_line promotion) and prints
# each top-level value.

fn is_ws(c: Int) -> Int {
    if c == 32 or c == 9 or c == 10 or c == 13 { return 1 }
    0
}

# Tokenize source into toks: parens as single tokens, `;` comments to
# end of line, atoms as non-ws non-paren runs (field-copy via builder
# keeps the copy O(token)).
fn tokenize_into(src: Str, toks: List<Str>) -> Int {
    let n = src.len()
    let mut pos = 0
    let mut count = 0
    while pos < n {
        let c = src[pos]
        if is_ws(c) == 1 {
            pos += 1
        } else if c == 40 {
            toks.push("(")
            pos += 1
            count += 1
        } else if c == 41 {
            toks.push(")")
            pos += 1
            count += 1
        } else if c == 59 {
            while pos < n {
                if src[pos] == 10 { break }
                pos += 1
            }
        } else {
            let start = pos
            while pos < n {
                let b = src[pos]
                if is_ws(b) == 1 or b == 40 or b == 41 or b == 59 { break }
                pos += 1
            }
            let b2 = str_builder_new()
            let mut i = start
            while i < pos {
                let pushed = str_builder_push(b2, src[i])
                i += 1
            }
            toks.push(str_builder_finish(b2))
            count += 1
        }
    }
    count
}

fn is_digit_atom(s: Str) -> Int {
    if s.len() == 0 { return 0 }
    let mut i = 0
    if s[0] == 45 {
        if s.len() == 1 { return 0 }
        i = 1
    }
    while i < s.len() {
        let c = s[i]
        if c < 48 or c > 57 { return 0 }
        i += 1
    }
    1
}

# Skip one complete expression starting at pos; returns the next pos.
fn skip_expr(toks: List<Str>, pos: Int) -> Int {
    if pos >= toks.len() { return pos }
    let t = toks[pos]
    if t != "(" { return pos + 1 }
    let mut p = pos + 1
    let mut depth = 1
    while p < toks.len() {
        let u = toks[p]
        if u == "(" { depth += 1 }
        if u == ")" {
            depth -= 1
            if depth == 0 { return p + 1 }
        }
        p += 1
    }
    p
}

# Evaluate one expression at pos; returns (value, next-pos). genv is
# the single environment map, and the defun tables map names to token
# indexes (param-list start / body start) inside the same token list.
fn eval_at(toks: List<Str>, pos: Int, genv: Map<Str,Int>, fnames: List<Str>, fparams: List<Int>, fbodies: List<Int>) -> (Int, Int) {
    if pos >= toks.len() { return (0, pos) }
    let t = toks[pos]
    if t != "(" {
        if is_digit_atom(t) == 1 {
            return (parse_int(t), pos + 1)
        }
        if genv.contains(t) {
            return (genv.get(t, 0), pos + 1)
        }
        print(f"error: unknown symbol {t}")
        return (0, pos + 1)
    }
    let head = toks[pos + 1]
    if head == "define" or head == "set" {
        let name = toks[pos + 2]
        let (v, np) = eval_at(toks, pos + 3, genv, fnames, fparams, fbodies)
        genv.insert(name, v)
        return (v, np + 1)
    }
    if head == "if" {
        let (c, cp) = eval_at(toks, pos + 2, genv, fnames, fparams, fbodies)
        if c != 0 {
            let (a, ap) = eval_at(toks, cp, genv, fnames, fparams, fbodies)
            let ep = skip_expr(toks, ap)
            return (a, ep + 1)
        }
        let sp = skip_expr(toks, cp)
        let (b, bp) = eval_at(toks, sp, genv, fnames, fparams, fbodies)
        return (b, bp + 1)
    }
    if head == "while" {
        let cond_pos = pos + 2
        let body_pos = skip_expr(toks, cond_pos)
        let mut last = 0
        let mut looping = 1
        while looping == 1 {
            let (c, cp) = eval_at(toks, cond_pos, genv, fnames, fparams, fbodies)
            if c == 0 {
                looping = 0
            } else {
                let mut bp = body_pos
                while toks[bp] != ")" {
                    let (v, np) = eval_at(toks, bp, genv, fnames, fparams, fbodies)
                    last = v
                    bp = np
                }
            }
        }
        let mut sp = body_pos
        while toks[sp] != ")" {
            sp = skip_expr(toks, sp)
        }
        return (last, sp + 1)
    }
    if head == "begin" {
        let mut p = pos + 2
        let mut last = 0
        while toks[p] != ")" {
            let (v, np) = eval_at(toks, p, genv, fnames, fparams, fbodies)
            last = v
            p = np
        }
        return (last, p + 1)
    }
    if head == "print" {
        let (v, np) = eval_at(toks, pos + 2, genv, fnames, fparams, fbodies)
        print(f"{v}")
        return (v, np + 1)
    }
    if head == "defun" {
        let name = toks[pos + 2]
        fnames.push(name)
        fparams.push(pos + 3)
        let body_start = skip_expr(toks, pos + 3)
        fbodies.push(body_start)
        let endp = skip_expr(toks, body_start)
        return (0, endp + 1)
    }
    if head == "+" or head == "-" or head == "*" or head == "/" or head == "<" or head == ">" or head == "=" {
        let (a, ap) = eval_at(toks, pos + 2, genv, fnames, fparams, fbodies)
        let (b, bp) = eval_at(toks, ap, genv, fnames, fparams, fbodies)
        let mut r = 0
        if head == "+" { r = a + b }
        if head == "-" { r = a - b }
        if head == "*" { r = a * b }
        if head == "/" {
            if b == 0 {
                print("error: division by zero")
            } else {
                r = a / b
            }
        }
        if head == "<" {
            if a < b { r = 1 }
        }
        if head == ">" {
            if a > b { r = 1 }
        }
        if head == "=" {
            if a == b { r = 1 }
        }
        return (r, bp + 1)
    }
    let fi = fnames.index_of(head)
    if fi < 0 {
        print(f"error: unknown form {head}")
        let ep = skip_expr(toks, pos)
        return (0, ep)
    }
    # Evaluate call arguments left to right, then bind parameters with
    # a save/restore frame so recursive calls unwind their shadows.
    let argv: List<Int> = []
    let mut ap2 = pos + 2
    while toks[ap2] != ")" {
        let (av, anp) = eval_at(toks, ap2, genv, fnames, fparams, fbodies)
        argv.push(av)
        ap2 = anp
    }
    let pstart = fparams[fi]
    let saved_names: List<Str> = []
    let saved_vals: List<Int> = []
    let saved_had: List<Int> = []
    let mut pp = pstart + 1
    let mut ai = 0
    while toks[pp] != ")" {
        let pname = toks[pp]
        saved_names.push(pname)
        if genv.contains(pname) {
            saved_had.push(1)
            saved_vals.push(genv.get(pname, 0))
        } else {
            saved_had.push(0)
            saved_vals.push(0)
        }
        let mut av2 = 0
        if ai < argv.len() { av2 = argv[ai] }
        genv.insert(pname, av2)
        pp += 1
        ai += 1
    }
    let (rv, rp) = eval_at(toks, fbodies[fi], genv, fnames, fparams, fbodies)
    let mut si = 0
    while si < saved_names.len() {
        if saved_had[si] == 1 {
            genv.insert(saved_names[si], saved_vals[si])
        } else {
            genv.remove(saved_names[si])
        }
        si += 1
    }
    return (rv, ap2 + 1)
}

# Evaluate every top-level expression in [start, toks.len()); returns
# the last value. The np <= p guard turns malformed input into a stop
# instead of a spin.
fn eval_program(toks: List<Str>, start: Int, genv: Map<Str,Int>, fnames: List<Str>, fparams: List<Int>, fbodies: List<Int>) -> Int {
    let mut p = start
    let mut last = 0
    while p < toks.len() {
        let (v, np) = eval_at(toks, p, genv, fnames, fparams, fbodies)
        last = v
        if np <= p { return last }
        p = np
    }
    last
}

fn eval_source(src: Str) -> Int {
    let toks: List<Str> = []
    let n = tokenize_into(src, toks)
    let genv: Map<Str,Int> = {}
    let fnames: List<Str> = []
    let fparams: List<Int> = []
    let fbodies: List<Int> = []
    eval_program(toks, 0, genv, fnames, fparams, fbodies)
}

# REPL: one growing token list keeps defun bodies addressable across
# lines; each new line evaluates from its own token offset and prints
# its last value. "" from stdin_read_line means EOF.
fn run_repl() -> Int {
    let toks: List<Str> = []
    let genv: Map<Str,Int> = {}
    let fnames: List<Str> = []
    let fparams: List<Int> = []
    let fbodies: List<Int> = []
    let mut last = 0
    let mut going = 1
    while going == 1 {
        let line = stdin_read_line()
        if line == "" {
            going = 0
        } else {
            let start = toks.len()
            let added = tokenize_into(line, toks)
            if added > 0 {
                last = eval_program(toks, start, genv, fnames, fparams, fbodies)
                print(f"= {last}")
            }
        }
    }
    last
}

fn run_file(path: Str) -> Int {
    if fs_exists(path) != 1 {
        print("error: file not found")
        return 3
    }
    eval_source(fs_read_text(path))
}

fn self_test() -> Int {
    if eval_source("(+ 40 2)") != 42 { return 1 }
    if eval_source("(- (* 6 8) 6)") != 42 { return 2 }
    if eval_source("(if (< 1 2) 42 0)") != 42 { return 3 }
    if eval_source("(if (> 1 2) 0 42)") != 42 { return 4 }
    if eval_source("(begin (define x 40) (+ x 2))") != 42 { return 5 }
    if eval_source("(begin (define n 0) (define acc 0) (while (< n 4) (set acc (+ acc n)) (set n (+ n 1))) (+ acc 36))") != 42 { return 6 }
    if eval_source("(begin (defun double (x) (* x 2)) (double 21))") != 42 { return 7 }
    if eval_source("(begin (defun fib (n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2))))) (fib 10))") != 55 { return 8 }
    if eval_source("(begin (defun fact (n) (if (< n 2) 1 (* n (fact (- n 1))))) (- (fact 5) 78))") != 42 { return 9 }
    # dynamic-scope save/restore: outer x survives a call that shadows it
    if eval_source("(begin (define x 42) (defun clobber (x) (* x 0)) (clobber 7) x)") != 42 { return 10 }
    if eval_source("(/ 84 2)") != 42 { return 11 }
    if eval_source("(begin (defun sum2 (a b) (+ a b)) (sum2 20 22))") != 42 { return 12 }
    42
}

fn usage() -> Int {
    print("usage: vaislisp                 (self-test)")
    print("       vaislisp <file.lisp>")
    print("       vaislisp repl")
    return 1
}

fn main() -> Int {
    if proc_argc() == 0 { return self_test() }
    let first = proc_arg(0)
    if first == "repl" {
        if proc_argc() != 1 { return usage() }
        return run_repl()
    }
    if proc_argc() != 1 { return usage() }
    run_file(first)
}

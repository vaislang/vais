# expect: 42
# vaislisp: a Lisp interpreter over token spans — no AST, the evaluator
# walks the token list recursively and returns (value, next) tuples.
# Values are tagged Ints so the (Int, Int) tuple contract carries every
# type: plain numbers live inside +/-1e15, string values index a global
# pool at the STR band, cons cells index parallel car/cdr heaps at the
# CONS band, function values index the defun/lambda table at the FN
# band, and nil is one reserved constant. Arithmetic outside the number
# band reports a loud error and yields 0. The string pool and cons
# heap are two-way partitioned (primary + overflow lists), so each
# holds 8190 entries; past that the overflow push traps loudly.
#
# Surface: (+ - * / < > =), (if c a b) with b optional (falsy without
# an else is nil), (cond (test body...) ... (else body...)), (and
# e...) / (or e...) short-circuiting with value semantics, (define
# name e), (set name e), (defun name (params...) body), (lambda
# (params...) body) as a first-class value — applications evaluate
# the head, so higher-order calls and immediate calls work — (while c
# body...), (begin e...), (let ((name e) ...) body...) with
# sequential bindings and shadow restore, (print e), (quote e) / 'e
# building data without evaluation (symbols intern as strings, spans
# become cons lists), string literals "..." with str-len / str-cat /
# str-ref / str-byte, and lists via cons / car / cdr / list / null? /
# nil. Scoping is dynamic with save/restore parameter frames (lambdas
# do not capture lexically); `'` is a token break, so atom names
# cannot contain it; `else` is reserved inside cond.
#
# Modes: no arguments runs the deterministic self-test (the
# release-corpus entry), `vaislisp <file.lisp>` evaluates a file and
# exits with the last value, `vaislisp repl` reads stdin lines until
# EOF and prints each top-level value. The sibling programs/ directory
# holds a .lisp corpus (fizzbuzz, vowels, assoc, hof, sort, words)
# run in file mode by the workflow gate.

fn int_band() -> Int { 1000000000000000 }

fn str_base() -> Int { 2000000000000000 }

fn cons_base() -> Int { 3000000000000000 }

fn fn_base() -> Int { 4000000000000000 }

fn nil_val() -> Int { 6000000000000000 }

fn is_num_val(v: Int) -> Int {
    if v < int_band() {
        if v > 0 - int_band() { return 1 }
    }
    0
}

fn is_str_val(v: Int) -> Int {
    if v >= str_base() {
        if v < cons_base() { return 1 }
    }
    0
}

fn is_cons_val(v: Int) -> Int {
    if v >= cons_base() {
        if v < fn_base() { return 1 }
    }
    0
}

fn is_fn_val(v: Int) -> Int {
    if v >= fn_base() {
        if v < 5000000000000000 { return 1 }
    }
    0
}

fn is_ws(c: Int) -> Int {
    if c == 32 or c == 9 or c == 10 or c == 13 { return 1 }
    0
}

# Tokenize source into toks: parens as single tokens, `;` comments to
# end of line, `"..."` string literals kept whole including the quotes
# (spaces and parens inside stay in the token), atoms as remaining
# runs.
fn tokenize_into(src: Str, toks: List<Str>) -> Int {
    let n = src.len()
    let mut pos = 0
    let mut count = 0
    while pos < n {
        let c = src[pos]
        if is_ws(c) == 1 {
            pos += 1
        } else if c == 40 {
            toks.push("(")
            pos += 1
            count += 1
        } else if c == 41 {
            toks.push(")")
            pos += 1
            count += 1
        } else if c == 39 {
            toks.push("'")
            pos += 1
            count += 1
        } else if c == 59 {
            while pos < n {
                if src[pos] == 10 { break }
                pos += 1
            }
        } else if c == 34 {
            let start = pos
            pos += 1
            while pos < n {
                if src[pos] == 34 { break }
                pos += 1
            }
            if pos < n { pos += 1 }
            let bq = str_builder_new()
            let mut qi = start
            while qi < pos {
                let pushed = str_builder_push(bq, src[qi])
                qi += 1
            }
            toks.push(str_builder_finish(bq))
            count += 1
        } else {
            let start = pos
            while pos < n {
                let b = src[pos]
                if is_ws(b) == 1 or b == 40 or b == 41 or b == 59 or b == 34 or b == 39 { break }
                pos += 1
            }
            let b2 = str_builder_new()
            let mut i = start
            while i < pos {
                let pushed2 = str_builder_push(b2, src[i])
                i += 1
            }
            toks.push(str_builder_finish(b2))
            count += 1
        }
    }
    count
}

fn is_digit_atom(s: Str) -> Int {
    if s.len() == 0 { return 0 }
    let mut i = 0
    if s[0] == 45 {
        if s.len() == 1 { return 0 }
        i = 1
    }
    while i < s.len() {
        let c = s[i]
        if c < 48 or c > 57 { return 0 }
        i += 1
    }
    1
}

# Skip one complete expression starting at pos; returns the next pos.
# A quote sugar token covers itself plus the expression it quotes.
fn skip_expr(toks: List<Str>, pos: Int) -> Int {
    if pos >= toks.len() { return pos }
    let t = toks[pos]
    if t == "'" { return skip_expr(toks, pos + 1) }
    if t != "(" { return pos + 1 }
    let mut p = pos + 1
    let mut depth = 1
    while p < toks.len() {
        let u = toks[p]
        if u == "(" { depth += 1 }
        if u == ")" {
            depth -= 1
            if depth == 0 { return p + 1 }
        }
        p += 1
    }
    p
}

# Two-way partitioned string pool and cons heap: the first 4095
# entries live in the primary lists, the next 4095 in the overflow
# lists, doubling each cap to 8190 (indexes stay dense, so tagged
# values are unchanged). Past 8190 the overflow push traps loudly.
fn pool_put(s: Str, spool: List<Str>, spool2: List<Str>) -> Int {
    let combined = spool.len() + spool2.len()
    if combined < 4095 {
        spool.push(s)
    } else {
        spool2.push(s)
    }
    str_base() + combined
}

fn pool_str(v: Int, spool: List<Str>, spool2: List<Str>) -> Str {
    let idx = v - str_base()
    if idx < 4095 { return spool[idx] }
    spool2[idx - 4095]
}

fn heap_cons(a: Int, d: Int, cars: List<Int>, cars2: List<Int>, cdrs: List<Int>, cdrs2: List<Int>) -> Int {
    let combined = cars.len() + cars2.len()
    if combined < 4095 {
        cars.push(a)
        cdrs.push(d)
    } else {
        cars2.push(a)
        cdrs2.push(d)
    }
    cons_base() + combined
}

fn heap_car(v: Int, cars: List<Int>, cars2: List<Int>) -> Int {
    let idx = v - cons_base()
    if idx < 4095 { return cars[idx] }
    cars2[idx - 4095]
}

fn heap_cdr(v: Int, cdrs: List<Int>, cdrs2: List<Int>) -> Int {
    let idx = v - cons_base()
    if idx < 4095 { return cdrs[idx] }
    cdrs2[idx - 4095]
}

# Build a value from the token span at pos without evaluating: numbers
# and string literals as themselves, nil as nil, any other symbol as
# its interned name, and parenthesized spans as cons lists built
# element by element. A nested quote token quotes the inner expression
# directly. Returns (value, next-pos).
fn quote_at(toks: List<Str>, pos: Int, spool: List<Str>, spool2: List<Str>, cars: List<Int>, cars2: List<Int>, cdrs: List<Int>, cdrs2: List<Int>) -> (Int, Int) {
    if pos >= toks.len() { return (nil_val(), pos) }
    let t = toks[pos]
    if t == "'" {
        return quote_at(toks, pos + 1, spool, spool2, cars, cars2, cdrs, cdrs2)
    }
    if t == "(" {
        let items: List<Int> = []
        let mut p = pos + 1
        while toks[p] != ")" {
            let (iv, np) = quote_at(toks, p, spool, spool2, cars, cars2, cdrs, cdrs2)
            items.push(iv)
            p = np
        }
        let mut acc = nil_val()
        let mut ri = items.len()
        while ri > 0 {
            ri -= 1
            acc = heap_cons(items[ri], acc, cars, cars2, cdrs, cdrs2)
        }
        return (acc, p + 1)
    }
    if is_digit_atom(t) == 1 {
        return (parse_int(t), pos + 1)
    }
    if t[0] == 34 {
        let inner = str_slice(t, 1, t.len() - 2)
        return (pool_put(inner, spool, spool2), pos + 1)
    }
    if t == "nil" {
        return (nil_val(), pos + 1)
    }
    (pool_put(t, spool, spool2), pos + 1)
}

# Render a value for printing: pool strings verbatim, cons chains as
# "(a b c)" with a dotted tail when the cdr is not nil or a cons,
# functions as "<fn>", nil as "nil", numbers as digits.
fn print_value(v: Int, spool: List<Str>, spool2: List<Str>, cars: List<Int>, cars2: List<Int>, cdrs: List<Int>, cdrs2: List<Int>) -> Str {
    if v == nil_val() { return "nil" }
    if is_str_val(v) == 1 { return pool_str(v, spool, spool2) }
    if is_fn_val(v) == 1 { return "<fn>" }
    if is_cons_val(v) == 1 {
        let b = str_builder_new()
        let o1 = str_builder_append(b, "(")
        let mut cur = v
        let mut first = 1
        let mut going = 1
        while going == 1 {
            if first == 0 {
                let sp = str_builder_append(b, " ")
            }
            first = 0
            let o2 = str_builder_append(b, @(heap_car(cur, cars, cars2), spool, spool2, cars, cars2, cdrs, cdrs2))
            let nxt = heap_cdr(cur, cdrs, cdrs2)
            if nxt == nil_val() {
                going = 0
            } else if is_cons_val(nxt) == 1 {
                cur = nxt
            } else {
                let o3 = str_builder_append(b, " . ")
                let o4 = str_builder_append(b, @(nxt, spool, spool2, cars, cars2, cdrs, cdrs2))
                going = 0
            }
        }
        let o5 = str_builder_append(b, ")")
        return str_builder_finish(b)
    }
    f"{v}"
}

# Apply function-table entry fi to already-evaluated argv: bind the
# parameter names with a save/restore frame over the one environment
# map, evaluate the body, restore the shadowed values, return the body
# value. Shared by named defun calls, lambda values, and higher-order
# applications.
fn apply_fn(toks: List<Str>, fi: Int, argv: List<Int>, genv: Map<Str,Int>, fnames: List<Str>, fparams: List<Int>, fbodies: List<Int>, spool: List<Str>, spool2: List<Str>, cars: List<Int>, cars2: List<Int>, cdrs: List<Int>, cdrs2: List<Int>) -> Int {
    let pstart = fparams[fi]
    let saved_names: List<Str> = []
    let saved_vals: List<Int> = []
    let saved_had: List<Int> = []
    let mut pp = pstart + 1
    let mut ai = 0
    while toks[pp] != ")" {
        let pname = toks[pp]
        saved_names.push(pname)
        if genv.contains(pname) {
            saved_had.push(1)
            saved_vals.push(genv.get(pname, 0))
        } else {
            saved_had.push(0)
            saved_vals.push(0)
        }
        let mut av = nil_val()
        if ai < argv.len() { av = argv[ai] }
        genv.insert(pname, av)
        pp += 1
        ai += 1
    }
    let (rv, rp) = eval_at(toks, fbodies[fi], genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
    let mut si = 0
    while si < saved_names.len() {
        if saved_had[si] == 1 {
            genv.insert(saved_names[si], saved_vals[si])
        } else {
            genv.remove(saved_names[si])
        }
        si += 1
    }
    rv
}

# Evaluate one expression at pos; returns (value, next-pos).
fn eval_at(toks: List<Str>, pos: Int, genv: Map<Str,Int>, fnames: List<Str>, fparams: List<Int>, fbodies: List<Int>, spool: List<Str>, spool2: List<Str>, cars: List<Int>, cars2: List<Int>, cdrs: List<Int>, cdrs2: List<Int>) -> (Int, Int) {
    if pos >= toks.len() { return (0, pos) }
    let t = toks[pos]
    if t == "'" {
        return quote_at(toks, pos + 1, spool, spool2, cars, cars2, cdrs, cdrs2)
    }
    if t != "(" {
        if is_digit_atom(t) == 1 {
            return (parse_int(t), pos + 1)
        }
        if t[0] == 34 {
            let inner = str_slice(t, 1, t.len() - 2)
            return (pool_put(inner, spool, spool2), pos + 1)
        }
        if t == "nil" {
            return (nil_val(), pos + 1)
        }
        if genv.contains(t) {
            return (genv.get(t, 0), pos + 1)
        }
        print(f"error: unknown symbol {t}")
        return (0, pos + 1)
    }
    let head = toks[pos + 1]
    if head == "define" or head == "set" {
        let name = toks[pos + 2]
        let (v, np) = eval_at(toks, pos + 3, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
        genv.insert(name, v)
        return (v, np + 1)
    }
    if head == "if" {
        # The else branch is optional: a falsy condition without one
        # yields nil.
        let (c, cp) = eval_at(toks, pos + 2, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
        if c != 0 {
            if c != nil_val() {
                let (a, ap) = eval_at(toks, cp, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
                if toks[ap] == ")" { return (a, ap + 1) }
                let ep = skip_expr(toks, ap)
                return (a, ep + 1)
            }
        }
        let sp = skip_expr(toks, cp)
        if toks[sp] == ")" { return (nil_val(), sp + 1) }
        let (b, bp) = eval_at(toks, sp, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
        return (b, bp + 1)
    }
    if head == "while" {
        let cond_pos = pos + 2
        let body_pos = skip_expr(toks, cond_pos)
        let mut last = 0
        let mut looping = 1
        while looping == 1 {
            let (c, cp) = eval_at(toks, cond_pos, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
            let mut truthy = 1
            if c == 0 { truthy = 0 }
            if c == nil_val() { truthy = 0 }
            if truthy == 0 {
                looping = 0
            } else {
                let mut bp = body_pos
                while toks[bp] != ")" {
                    let (v, np) = eval_at(toks, bp, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
                    last = v
                    bp = np
                }
            }
        }
        let mut sp = body_pos
        while toks[sp] != ")" {
            sp = skip_expr(toks, sp)
        }
        return (last, sp + 1)
    }
    if head == "begin" {
        let mut p = pos + 2
        let mut last = 0
        while toks[p] != ")" {
            let (v, np) = eval_at(toks, p, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
            last = v
            p = np
        }
        return (last, p + 1)
    }
    if head == "quote" {
        let (qv, qp) = quote_at(toks, pos + 2, spool, spool2, cars, cars2, cdrs, cdrs2)
        return (qv, qp + 1)
    }
    if head == "let" {
        # (let ((name expr) ...) body...) — bindings evaluate in
        # sequence with earlier ones visible (let* style), shadow the
        # environment through the same save/restore frame discipline as
        # apply_fn, and unwind after the body.
        let saved_names: List<Str> = []
        let saved_vals: List<Int> = []
        let saved_had: List<Int> = []
        let mut bp = pos + 3
        while toks[bp] != ")" {
            let bname = toks[bp + 1]
            let (bv, bnp) = eval_at(toks, bp + 2, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
            saved_names.push(bname)
            if genv.contains(bname) {
                saved_had.push(1)
                saved_vals.push(genv.get(bname, 0))
            } else {
                saved_had.push(0)
                saved_vals.push(0)
            }
            genv.insert(bname, bv)
            bp = bnp + 1
        }
        let mut lp2 = bp + 1
        let mut lastv = 0
        while toks[lp2] != ")" {
            let (v2, np2) = eval_at(toks, lp2, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
            lastv = v2
            lp2 = np2
        }
        let mut si = 0
        while si < saved_names.len() {
            if saved_had[si] == 1 {
                genv.insert(saved_names[si], saved_vals[si])
            } else {
                genv.remove(saved_names[si])
            }
            si += 1
        }
        return (lastv, lp2 + 1)
    }
    if head == "cond" {
        # (cond (test body...) ... (else body...)) — clauses evaluate
        # in order; the first truthy test (or the reserved else) runs
        # its body and the rest skip. A clause with an empty body
        # yields its test value; no matching clause yields nil.
        let mut ccp = pos + 2
        let mut cres = nil_val()
        let mut cdone = 0
        while toks[ccp] != ")" {
            if cdone == 1 {
                ccp = skip_expr(toks, ccp)
            } else {
                let mut ctruthy = 0
                let mut cbp = 0
                if toks[ccp + 1] == "else" {
                    cbp = ccp + 2
                    ctruthy = 1
                } else {
                    let (ctv, ctnp) = eval_at(toks, ccp + 1, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
                    cbp = ctnp
                    if ctv != 0 {
                        if ctv != nil_val() {
                            ctruthy = 1
                            cres = ctv
                        }
                    }
                }
                if ctruthy == 1 {
                    while toks[cbp] != ")" {
                        let (cbv, cbnp) = eval_at(toks, cbp, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
                        cres = cbv
                        cbp = cbnp
                    }
                    cdone = 1
                    ccp = cbp + 1
                } else {
                    let mut csp = cbp
                    while toks[csp] != ")" {
                        csp = skip_expr(toks, csp)
                    }
                    ccp = csp + 1
                }
            }
        }
        return (cres, ccp + 1)
    }
    if head == "and" or head == "or" {
        # Variadic short-circuit with value semantics: and stops at
        # the first falsy operand and or at the first truthy one,
        # returning that operand's value; the remaining expressions
        # skip unevaluated. Empty (and) is 1, empty (or) is 0.
        let mut sp2 = pos + 2
        let mut sres = 1
        if head == "or" { sres = 0 }
        let mut sdone = 0
        while toks[sp2] != ")" {
            if sdone == 1 {
                sp2 = skip_expr(toks, sp2)
            } else {
                let (ov, onp) = eval_at(toks, sp2, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
                sres = ov
                sp2 = onp
                let mut struthy = 1
                if ov == 0 { struthy = 0 }
                if ov == nil_val() { struthy = 0 }
                if head == "and" {
                    if struthy == 0 { sdone = 1 }
                }
                if head == "or" {
                    if struthy == 1 { sdone = 1 }
                }
            }
        }
        return (sres, sp2 + 1)
    }
    if head == "print" {
        let (v, np) = eval_at(toks, pos + 2, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
        print(print_value(v, spool, spool2, cars, cars2, cdrs, cdrs2))
        return (v, np + 1)
    }
    if head == "defun" {
        let name = toks[pos + 2]
        fnames.push(name)
        fparams.push(pos + 3)
        let body_start = skip_expr(toks, pos + 3)
        fbodies.push(body_start)
        let endp = skip_expr(toks, body_start)
        return (0, endp + 1)
    }
    if head == "lambda" {
        fnames.push("<lambda>")
        fparams.push(pos + 2)
        let lbody = skip_expr(toks, pos + 2)
        fbodies.push(lbody)
        let lend = skip_expr(toks, lbody)
        return (fn_base() + fnames.len() - 1, lend + 1)
    }
    if head == "cons" {
        let (a, ap) = eval_at(toks, pos + 2, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
        let (d, dp) = eval_at(toks, ap, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
        return (heap_cons(a, d, cars, cars2, cdrs, cdrs2), dp + 1)
    }
    if head == "car" or head == "cdr" {
        let (p1, np1) = eval_at(toks, pos + 2, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
        if is_cons_val(p1) == 0 {
            print(f"error: {head} needs a cons")
            return (nil_val(), np1 + 1)
        }
        if head == "car" {
            return (heap_car(p1, cars, cars2), np1 + 1)
        }
        return (heap_cdr(p1, cdrs, cdrs2), np1 + 1)
    }
    if head == "list" {
        let items: List<Int> = []
        let mut lp = pos + 2
        while toks[lp] != ")" {
            let (iv, inp) = eval_at(toks, lp, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
            items.push(iv)
            lp = inp
        }
        let mut acc = nil_val()
        let mut ri = items.len()
        while ri > 0 {
            ri -= 1
            acc = heap_cons(items[ri], acc, cars, cars2, cdrs, cdrs2)
        }
        return (acc, lp + 1)
    }
    if head == "null?" {
        let (nv, nnp) = eval_at(toks, pos + 2, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
        let mut isn = 0
        if nv == nil_val() { isn = 1 }
        return (isn, nnp + 1)
    }
    if head == "str-len" {
        let (sv, snp) = eval_at(toks, pos + 2, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
        if is_str_val(sv) == 0 {
            print("error: str-len needs a string")
            return (0, snp + 1)
        }
        let pooled = pool_str(sv, spool, spool2)
        return (pooled.len(), snp + 1)
    }
    if head == "str-cat" {
        let (s1, sp1) = eval_at(toks, pos + 2, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
        let (s2, sp2) = eval_at(toks, sp1, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
        if is_str_val(s1) == 0 or is_str_val(s2) == 0 {
            print("error: str-cat needs strings")
            return (0, sp2 + 1)
        }
        let joined = str_concat(pool_str(s1, spool, spool2), pool_str(s2, spool, spool2))
        return (pool_put(joined, spool, spool2), sp2 + 1)
    }
    if head == "str-ref" or head == "str-byte" {
        # (str-ref s i) is the one-byte string at i; (str-byte s i) is
        # that byte as a number. Both are loud on a non-string, a
        # non-number index, or an out-of-range index.
        let (sv, rp1) = eval_at(toks, pos + 2, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
        let (iv, rp2) = eval_at(toks, rp1, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
        if is_str_val(sv) == 0 or is_num_val(iv) == 0 {
            print(f"error: {head} needs a string and an index")
            return (0, rp2 + 1)
        }
        let pooled = pool_str(sv, spool, spool2)
        if iv < 0 or iv >= pooled.len() {
            print(f"error: {head} index out of range")
            return (0, rp2 + 1)
        }
        if head == "str-byte" {
            return (pooled[iv], rp2 + 1)
        }
        return (pool_put(str_slice(pooled, iv, 1), spool, spool2), rp2 + 1)
    }
    if head == "+" or head == "-" or head == "*" or head == "/" or head == "<" or head == ">" or head == "=" {
        let (a, ap) = eval_at(toks, pos + 2, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
        let (b, bp) = eval_at(toks, ap, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
        if head == "=" {
            if is_str_val(a) == 1 {
                if is_str_val(b) == 1 {
                    let mut eqv = 0
                    if pool_str(a, spool, spool2) == pool_str(b, spool, spool2) { eqv = 1 }
                    return (eqv, bp + 1)
                }
            }
        }
        if is_num_val(a) == 0 or is_num_val(b) == 0 {
            if head == "=" {
                let mut idv = 0
                if a == b { idv = 1 }
                return (idv, bp + 1)
            }
            print(f"error: {head} needs numbers")
            return (0, bp + 1)
        }
        let mut r = 0
        if head == "+" { r = a + b }
        if head == "-" { r = a - b }
        if head == "*" { r = a * b }
        if head == "/" {
            if b == 0 {
                print("error: division by zero")
            } else {
                r = a / b
            }
        }
        if head == "<" {
            if a < b { r = 1 }
        }
        if head == ">" {
            if a > b { r = 1 }
        }
        if head == "=" {
            if a == b { r = 1 }
        }
        return (r, bp + 1)
    }
    # Named defun fast path, then general application: evaluate the head
    # expression and apply its function value (lambdas, parameters and
    # variables holding functions, immediate (lambda ...) calls).
    let mut fi = 0 - 1
    if head != "(" {
        fi = fnames.index_of(head)
    }
    let mut hp = pos + 2
    if fi < 0 {
        let (hv, hnp) = eval_at(toks, pos + 1, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
        if is_fn_val(hv) == 0 {
            print(f"error: not a function: {head}")
            let ep = skip_expr(toks, pos)
            return (0, ep)
        }
        fi = hv - fn_base()
        hp = hnp
    }
    let argv: List<Int> = []
    let mut ap2 = hp
    while toks[ap2] != ")" {
        let (av, anp) = eval_at(toks, ap2, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
        argv.push(av)
        ap2 = anp
    }
    let rv = apply_fn(toks, fi, argv, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
    return (rv, ap2 + 1)
}

# Evaluate every top-level expression in [start, toks.len()); returns
# the last value. The np <= p guard turns malformed input into a stop
# instead of a spin.
fn eval_program(toks: List<Str>, start: Int, genv: Map<Str,Int>, fnames: List<Str>, fparams: List<Int>, fbodies: List<Int>, spool: List<Str>, spool2: List<Str>, cars: List<Int>, cars2: List<Int>, cdrs: List<Int>, cdrs2: List<Int>) -> Int {
    let mut p = start
    let mut last = 0
    while p < toks.len() {
        let (v, np) = eval_at(toks, p, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
        last = v
        if np <= p { return last }
        p = np
    }
    last
}

fn eval_source(src: Str) -> Int {
    let toks: List<Str> = []
    let n = tokenize_into(src, toks)
    let genv: Map<Str,Int> = {}
    let fnames: List<Str> = []
    let fparams: List<Int> = []
    let fbodies: List<Int> = []
    let spool: List<Str> = []
    let spool2: List<Str> = []
    let cars: List<Int> = []
    let cars2: List<Int> = []
    let cdrs: List<Int> = []
    let cdrs2: List<Int> = []
    eval_program(toks, 0, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
}

# REPL: one growing token list keeps defun and lambda bodies
# addressable across lines; each new line evaluates from its own token
# offset and prints its last value. "" from stdin_read_line means EOF.
fn run_repl() -> Int {
    let toks: List<Str> = []
    let genv: Map<Str,Int> = {}
    let fnames: List<Str> = []
    let fparams: List<Int> = []
    let fbodies: List<Int> = []
    let spool: List<Str> = []
    let spool2: List<Str> = []
    let cars: List<Int> = []
    let cars2: List<Int> = []
    let cdrs: List<Int> = []
    let cdrs2: List<Int> = []
    let mut last = 0
    let mut going = 1
    while going == 1 {
        let line = stdin_read_line()
        if line == "" {
            going = 0
        } else {
            let start = toks.len()
            let fns_before = fnames.len()
            let added = tokenize_into(line, toks)
            if added > 0 {
                last = eval_program(toks, start, genv, fnames, fparams, fbodies, spool, spool2, cars, cars2, cdrs, cdrs2)
                print(f"= {print_value(last, spool, spool2, cars, cars2, cdrs, cdrs2)}")
                # Only defun/lambda registrations keep token spans alive;
                # a line that registered none rolls its tokens back so a
                # long session of throwaway expressions never exhausts
                # the 4095-slot token list (interned strings and cons
                # cells live in their own pools, so values survive).
                if fnames.len() == fns_before {
                    while toks.len() > start {
                        toks.pop()
                    }
                }
            }
        }
    }
    # A tagged last value (string/cons/fn) is meaningless mod 256, so a
    # finished REPL session simply exits clean.
    0
}

fn run_file(path: Str) -> Int {
    if fs_exists(path) != 1 {
        print("error: file not found")
        return 3
    }
    eval_source(fs_read_text(path))
}

fn self_test() -> Int {
    if eval_source("(+ 40 2)") != 42 { return 1 }
    if eval_source("(- (* 6 8) 6)") != 42 { return 2 }
    if eval_source("(if (< 1 2) 42 0)") != 42 { return 3 }
    if eval_source("(if (> 1 2) 0 42)") != 42 { return 4 }
    if eval_source("(begin (define x 40) (+ x 2))") != 42 { return 5 }
    if eval_source("(begin (define n 0) (define acc 0) (while (< n 4) (set acc (+ acc n)) (set n (+ n 1))) (+ acc 36))") != 42 { return 6 }
    if eval_source("(begin (defun double (x) (* x 2)) (double 21))") != 42 { return 7 }
    if eval_source("(begin (defun fib (n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2))))) (fib 10))") != 55 { return 8 }
    if eval_source("(begin (defun fact (n) (if (< n 2) 1 (* n (fact (- n 1))))) (- (fact 5) 78))") != 42 { return 9 }
    # dynamic-scope save/restore: outer x survives a call that shadows it
    if eval_source("(begin (define x 42) (defun clobber (x) (* x 0)) (clobber 7) x)") != 42 { return 10 }
    if eval_source("(/ 84 2)") != 42 { return 11 }
    if eval_source("(begin (defun sum2 (a b) (+ a b)) (sum2 20 22))") != 42 { return 12 }
    # strings: pooled literals, length, concatenation, equality
    if eval_source("(str-len \"hello\")") != 5 { return 13 }
    if eval_source("(str-len (str-cat \"vais\" \"lisp\"))") != 8 { return 14 }
    if eval_source("(if (= \"ab\" (str-cat \"a\" \"b\")) 42 0)") != 42 { return 15 }
    if eval_source("(if (= \"ab\" \"ac\") 0 42)") != 42 { return 16 }
    # lists: cons cells, list sugar, recursive traversal
    if eval_source("(car (cons 41 nil))") != 41 { return 17 }
    if eval_source("(begin (define p (cons 1 (cons 2 nil))) (+ (car p) (car (cdr p))))") != 3 { return 18 }
    if eval_source("(if (null? nil) 42 0)") != 42 { return 19 }
    if eval_source("(begin (defun lsum (xs) (if (null? xs) 0 (+ (car xs) (lsum (cdr xs))))) (lsum (list 12 10 20)))") != 42 { return 20 }
    # lambda: immediate call, stored value, higher-order application
    if eval_source("((lambda (x) (* x 2)) 21)") != 42 { return 21 }
    if eval_source("(begin (define f (lambda (n) (+ n 2))) (f 40))") != 42 { return 22 }
    if eval_source("(begin (defun ap (g x) (g x)) (ap (lambda (n) (- n 8)) 50))") != 42 { return 23 }
    # let: local bindings, sequential visibility, shadow restore
    if eval_source("(let ((a 40) (b 2)) (+ a b))") != 42 { return 24 }
    if eval_source("(let ((a 6) (b (* a 7))) b)") != 42 { return 25 }
    if eval_source("(begin (define x 42) (let ((x 7)) x) x)") != 42 { return 26 }
    # quote: symbols intern as strings, lists build without evaluating
    if eval_source("(str-len (quote hello))") != 5 { return 27 }
    if eval_source("(car (cdr (quote (1 2 3))))") != 2 { return 28 }
    if eval_source("(car '(42 7))") != 42 { return 29 }
    if eval_source("(begin (defun lsum (xs) (if (null? xs) 0 (+ (car xs) (lsum (cdr xs))))) (lsum '(12 10 20)))") != 42 { return 30 }
    # string indexing: one-byte string vs byte number
    if eval_source("(str-byte \"abc\" 1)") != 98 { return 31 }
    if eval_source("(if (= (str-ref \"vais\" 0) \"v\") 42 0)") != 42 { return 32 }
    # cond: first truthy clause wins, else catches, no match is nil
    if eval_source("(cond (0 1) (1 42) (else 7))") != 42 { return 33 }
    if eval_source("(cond (0 1) (else 42))") != 42 { return 34 }
    if eval_source("(if (null? (cond (0 1))) 42 0)") != 42 { return 35 }
    # and/or: value semantics with short-circuit skips
    if eval_source("(and 1 42)") != 42 { return 36 }
    if eval_source("(begin (define t 0) (and 0 (set t 1)) (+ t 42))") != 42 { return 37 }
    if eval_source("(or 0 42)") != 42 { return 38 }
    if eval_source("(begin (define u 40) (or 1 (set u 0)) (+ u 2))") != 42 { return 39 }
    # if without else: falsy condition yields nil
    if eval_source("(if (null? (if 0 7)) 42 0)") != 42 { return 40 }
    42
}

fn usage() -> Int {
    print("usage: vaislisp                 (self-test)")
    print("       vaislisp <file.lisp>")
    print("       vaislisp repl")
    return 1
}

fn main() -> Int {
    if proc_argc() == 0 { return self_test() }
    let first = proc_arg(0)
    if first == "repl" {
        if proc_argc() != 1 { return usage() }
        return run_repl()
    }
    if proc_argc() != 1 { return usage() }
    run_file(first)
}

# expect: 42
# Tenth installable Vais tool: `scripts/vaisc package` builds dist/bin/vaisenv
# printing process environment variables:
#   vaisenv <NAME...>
# Each set variable prints its value on one line (the first product use of
# env_get). An unset or empty variable reports to stderr and sets the exit
# code to 3 while the remaining names still print; errors and usage never
# touch stdout. env_get is total — unset and empty-valued variables are both
# read as the empty string. Run without arguments it executes a deterministic
# self-test (the release-corpus entry).

fn eprint(msg: Str) -> Int {
    let w = stderr_write(msg)
    let lf = stderr_write(str_byte(10))
    return 0
}

fn run_env(names: List<Str>) -> Int {
    let mut status = 0
    let mut i = 0
    while i < names.len() {
        let name = names[i]
        let value = env_get(name)
        if value.len() == 0 {
            eprint(str_concat("error: variable not set: ", name))
            status = 3
        } else {
            print(value)
        }
        i = i + 1
    }
    return status
}

fn usage() -> Int {
    eprint("usage: vaisenv <NAME...>")
    return 2
}

fn self_test() -> Int {
    # Unset sentinel reads back as the empty string.
    let missing = env_get("VAIS_E359_DEFINITELY_UNSET")
    if missing.len() != 0 { return 1 }

    # Direct call-operand comparison against a literal stays runtime-true.
    if env_get("VAIS_E359_DEFINITELY_UNSET") != "" { return 2 }

    # A shell-provided variable reads back non-empty (the gates run under a
    # shell, so PATH is always set).
    let path_value = env_get("PATH")
    if path_value.len() == 0 { return 3 }

    # Empty names are total too.
    if env_get("") != "" { return 4 }

    # 6 * 7 = 42
    return 6 * 7
}

fn main() -> Int {
    if proc_argc() == 0 { return self_test() }
    let names: List<Str> = []
    let mut i = 0
    while i < proc_argc() {
        names.push(proc_arg(i))
        i = i + 1
    }
    if names.len() == 0 { return usage() }
    return run_env(names)
}

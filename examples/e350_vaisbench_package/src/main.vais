# expect: 42
# Fifth installable Vais tool: `scripts/vaisc package` builds dist/bin/vaisbench
# timing a child command over repeated runs:
#   vaisbench <n> <cmd> [args...]
# runs the command n times through proc_run, measuring each run with
# time_millis, and reports `runs=N min=A median=B avg=C max=D ms`. A child
# that exits non-zero stops the loop and that exit code is propagated;
# n < 1 exits 2. Run without arguments it executes a deterministic self-test
# (the release-corpus entry).
import bench.stats

fn tail_argv(from: Int, out: List<Str>) -> Int {
    let argv = args()
    for i in from..argv.len() {
        out.push(argv[i])
    }
    out.len()
}

fn timed_runs(n: Int, argv: List<Str>, durations: List<Int>) -> Int {
    for i in 0..n {
        let t0 = time_millis()
        let code = proc_run(argv)
        let t1 = time_millis()
        if code != 0 { return code }
        durations.push(t1 - t0)
    }
    0
}

fn run_bench_budget(n: Int, budget_ms: Int, argv: List<Str>) -> Int {
    let durations: List<Int> = []
    let code = timed_runs(n, argv, durations)
    if code != 0 { return code }
    let med = stats_median(durations)
    print(f"runs={durations.len()} median={med} budget={budget_ms} ms")
    if med > budget_ms {
        print(f"budget exceeded: median={med} > {budget_ms} ms")
        return 3
    }
    0
}

fn run_bench(n: Int, argv: List<Str>) -> Int {
    let durations: List<Int> = []
    let code = timed_runs(n, argv, durations)
    if code != 0 { return code }
    print(f"runs={durations.len()} min={stats_min(durations)} median={stats_median(durations)} avg={stats_avg(durations)} max={stats_max(durations)} ms")
    0
}

fn usage() -> Int {
    print("usage: vaisbench <n> <cmd> [args...]")
    print("       vaisbench -b <budget-ms> <n> <cmd> [args...]")
    2
}

fn self_test() -> Int {
    # Statistics over a fixed sample: sort/median/avg/min/max stay exact.
    let xs: List<Int> = [9, 3, 7, 5]
    if stats_min(xs) != 3 { return 1 }
    if stats_max(xs) != 9 { return 2 }
    if stats_avg(xs) != 6 { return 3 }
    if stats_median(xs) != 5 { return 4 }
    let one: List<Int> = [11]
    if stats_median(one) != 11 { return 5 }

    # Real timed runs: /usr/bin/true three times, all zero exits.
    let argv: List<Str> = ["/usr/bin/true"]
    let durations: List<Int> = []
    if timed_runs(3, argv, durations) != 0 { return 6 }
    if durations.len() != 3 { return 8 }
    if stats_min(durations) < 0 { return 7 }
    if stats_min(durations) > stats_max(durations) { return 9 }

    # A failing child propagates its exit.
    let bad: List<Str> = ["/usr/bin/false"]
    if proc_run(bad) != 1 { return 10 }

    # Budget mode: a generous budget passes, an impossible one exits 3.
    if run_bench_budget(2, 60000, argv) != 0 { return 11 }
    if run_bench_budget(2, 0 - 1, argv) != 3 { return 12 }

    42
}

fn main() -> Int {
    if proc_argc() == 0 { return self_test() }
    let first = proc_arg(0)
    if first == "-b" {
        if proc_argc() < 4 { return usage() }
        let budget = parse_int(proc_arg(1))
        let n = parse_int(proc_arg(2))
        if n < 1 { return usage() }
        let argv: List<Str> = []
        if tail_argv(3, argv) == 0 { return usage() }
        return run_bench_budget(n, budget, argv)
    }
    if proc_argc() < 2 { return usage() }
    let n = parse_int(first)
    if n < 1 { return usage() }
    let argv: List<Str> = []
    if tail_argv(1, argv) == 0 { return usage() }
    run_bench(n, argv)
}

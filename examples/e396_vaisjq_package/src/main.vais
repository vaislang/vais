# expect: 42
# vaisjq: an integer JSON parser and jq-subset query tool. JSON values
# are tagged Ints (the vaislisp encoding pattern): plain numbers live
# inside +/-1e15, string values index a pool at the STR band, arrays
# and objects index a shared cell heap through per-container head
# slots at the ARR/OBJ bands, and true/false/null are reserved
# constants. Cells are (key, val, next) triples in parallel lists —
# arrays leave key at -1, objects point key at the pool — so one
# recursive-descent parser and one renderer serve both shapes.
#
# Scope: integers only (a '.', 'e', or 'E' in a number is a loud
# error, as is any |n| >= 1e15), string escapes \" \\ \/ \n \t \r
# (\b, \f, and \uXXXX are loud errors), single top-level document
# with trailing-garbage detection.
#
# Filters: `.` identity, `.name` field chains, `[N]`/`[-N]` array
# indexes (negatives count from the end), `[]` iteration (arrays emit
# elements, objects emit values), multi-stage pipes (pure path stages
# concatenate), `select(<cond> [and|or <cond>]...)` stages — each
# condition is `<path> [op <literal>]` with == != < > <= >= against
# integer/string/true/false/null literals or bare truthiness
# (false/null drop), `and` binds tighter than `or`, short-circuit
# left to right; select paths cannot iterate and string literals are
# verbatim (a `has("key")`/`has(N)` atom tests the piped value) —
# `map(<path>)` building a new array from each element's
# single-valued walk, `has("key")` / `has(N)` emitting true/false,
# `first`/`last` as sugar for indexes 0 / -1, `add` (number sums or
# string concatenation; empty is null, mixed is loud, sums stay
# inside the integer band), `join("sep")` (strings verbatim, numbers
# stringified, null empty), `min`/`max` (numbers only, empty is
# null), `sort`/`unique` over homogeneous number or string arrays,
# object construction `{key: <path>, "quoted": <path>, shorthand}`
# (shorthand walks `.key`, later duplicate keys overwrite, missing
# paths turn null), string templates `"text \(.path) more"` whose
# holes render strings raw and everything else as compact JSON
# (escapes: \\ and \" only, \( opens a hole), and a terminal
# `| length` or `| keys` stage (keys sorts). Missing fields and out-of-range indexes emit null
# and keep chaining (null indexes to null, jq-style); indexing or
# iterating a value of the wrong type is a loud error with exit 3.
#
# Modes: no arguments runs the deterministic self-test (the
# release-corpus entry), `vaisjq [-c] <filter> [file]` queries a file
# or stdin (`-` or no file argument), printing pretty two-space JSON
# by default and compact JSON with -c. Exits: 0 query ok, 2 usage,
# 3 parse/type/file error.

fn num_band() -> Int { 1000000000000000 }

fn str_base() -> Int { 2000000000000000 }

fn arr_base() -> Int { 3000000000000000 }

fn obj_base() -> Int { 4000000000000000 }

fn true_val() -> Int { 5000000000000000 }

fn false_val() -> Int { 5000000000000001 }

fn null_val() -> Int { 6000000000000000 }

fn err_val() -> Int { 6000000000000001 }

fn is_num_val(v: Int) -> Int {
    if v < num_band() {
        if v > 0 - num_band() { return 1 }
    }
    0
}

fn is_str_val(v: Int) -> Int {
    if v >= str_base() {
        if v < arr_base() { return 1 }
    }
    0
}

fn is_arr_val(v: Int) -> Int {
    if v >= arr_base() {
        if v < obj_base() { return 1 }
    }
    0
}

fn is_obj_val(v: Int) -> Int {
    if v >= obj_base() {
        if v < true_val() { return 1 }
    }
    0
}

fn eprint(msg: Str) -> Int {
    let w = stderr_write(msg)
    let lf = stderr_write(str_byte(10))
    0
}

fn intern(s: Str, spool: List<Str>) -> Int {
    spool.push(s)
    str_base() + spool.len() - 1
}

fn is_json_ws(c: Int) -> Int {
    if c == 32 or c == 9 or c == 10 or c == 13 { return 1 }
    0
}

fn is_ident_byte(b: Int) -> Int {
    if b >= 97 {
        if b <= 122 { return 1 }
    }
    if b >= 65 {
        if b <= 90 { return 1 }
    }
    if b >= 48 {
        if b <= 57 { return 1 }
    }
    if b == 95 { return 1 }
    0
}

fn skip_json_ws(src: Str, pos: Int) -> Int {
    let n = src.len()
    let mut p = pos
    while p < n {
        if is_json_ws(src[p]) == 0 { return p }
        p += 1
    }
    p
}

# Parse a JSON string literal starting at the opening quote; returns
# (STR value, next-pos) or (err, pos) after a loud message.
fn parse_json_string(src: Str, pos: Int, spool: List<Str>) -> (Int, Int) {
    let n = src.len()
    let b = str_builder_new()
    let mut p = pos + 1
    while p < n {
        let c = src[p]
        if c == 34 {
            return (intern(str_builder_finish(b), spool), p + 1)
        }
        if c == 92 {
            if p + 1 >= n {
                eprint("error: unterminated escape in string")
                return (err_val(), p)
            }
            let e = src[p + 1]
            let mut mapped = 0 - 1
            if e == 34 { mapped = 34 }
            if e == 92 { mapped = 92 }
            if e == 47 { mapped = 47 }
            if e == 110 { mapped = 10 }
            if e == 116 { mapped = 9 }
            if e == 114 { mapped = 13 }
            if mapped < 0 {
                eprint("error: unsupported string escape")
                return (err_val(), p)
            }
            let pushed = str_builder_push(b, mapped)
            p += 2
        } else {
            if c < 32 {
                eprint("error: raw control byte in string")
                return (err_val(), p)
            }
            let pushed2 = str_builder_push(b, c)
            p += 1
        }
    }
    eprint("error: unterminated string")
    (err_val(), p)
}

# Parse an integer; a fraction or exponent marker is a loud error.
fn parse_json_number(src: Str, pos: Int) -> (Int, Int) {
    let n = src.len()
    let mut p = pos
    let mut neg = 0
    if src[p] == 45 {
        neg = 1
        p += 1
    }
    if p >= n {
        eprint("error: lone minus sign")
        return (err_val(), p)
    }
    let mut digits = 0
    let mut acc = 0
    while p < n {
        let c = src[p]
        if c >= 48 {
            if c <= 57 {
                acc = acc * 10 + (c - 48)
                digits += 1
                p += 1
            } else { break }
        } else { break }
    }
    if digits == 0 {
        eprint("error: expected digits in number")
        return (err_val(), p)
    }
    if digits > 15 {
        eprint("error: number out of integer range")
        return (err_val(), p)
    }
    if p < n {
        let nx = src[p]
        if nx == 46 or nx == 101 or nx == 69 {
            eprint("error: non-integer numbers are unsupported")
            return (err_val(), p)
        }
    }
    if acc >= num_band() {
        eprint("error: number out of integer range")
        return (err_val(), p)
    }
    if neg == 1 {
        return (0 - acc, p)
    }
    (acc, p)
}

fn match_word(src: Str, pos: Int, w: Str) -> Int {
    let n = src.len()
    let m = w.len()
    if pos + m > n { return 0 }
    let mut i = 0
    while i < m {
        if src[pos + i] != w[i] { return 0 }
        i += 1
    }
    1
}

# Parse one JSON value at pos; returns (value, next-pos). Containers
# allocate a head slot (first-cell index or -1) and chain cells of
# (key, val, next): arrays keep key at -1, objects intern their keys.
fn parse_json_value(src: Str, pos: Int, spool: List<Str>, heads: List<Int>, ckeys: List<Int>, cvals: List<Int>, cnexts: List<Int>) -> (Int, Int) {
    let n = src.len()
    let p0 = skip_json_ws(src, pos)
    if p0 >= n {
        eprint("error: unexpected end of input")
        return (err_val(), p0)
    }
    let c = src[p0]
    if c == 34 {
        let (sv, sp) = parse_json_string(src, p0, spool)
        return (sv, sp)
    }
    let mut numeric = 0
    if c == 45 { numeric = 1 }
    if c >= 48 {
        if c <= 57 { numeric = 1 }
    }
    if numeric == 1 {
        let (nv, np) = parse_json_number(src, p0)
        return (nv, np)
    }
    if c == 116 {
        if match_word(src, p0, "true") == 1 { return (true_val(), p0 + 4) }
        eprint("error: bad literal")
        return (err_val(), p0)
    }
    if c == 102 {
        if match_word(src, p0, "false") == 1 { return (false_val(), p0 + 5) }
        eprint("error: bad literal")
        return (err_val(), p0)
    }
    if c == 110 {
        if match_word(src, p0, "null") == 1 { return (null_val(), p0 + 4) }
        eprint("error: bad literal")
        return (err_val(), p0)
    }
    if c == 91 {
        heads.push(0 - 1)
        let hidx = heads.len() - 1
        let mut p = skip_json_ws(src, p0 + 1)
        if p < n {
            if src[p] == 93 {
                return (arr_base() + hidx, p + 1)
            }
        }
        let mut prev = 0 - 1
        let mut going = 1
        while going == 1 {
            let (ev, ep) = parse_json_value(src, p, spool, heads, ckeys, cvals, cnexts)
            if ev == err_val() { return (err_val(), ep) }
            ckeys.push(0 - 1)
            cvals.push(ev)
            cnexts.push(0 - 1)
            let cell = cvals.len() - 1
            if prev < 0 {
                heads[hidx] = cell
            } else {
                cnexts[prev] = cell
            }
            prev = cell
            p = skip_json_ws(src, ep)
            if p >= n {
                eprint("error: unterminated array")
                return (err_val(), p)
            }
            if src[p] == 44 {
                p = skip_json_ws(src, p + 1)
            } else {
                if src[p] == 93 {
                    going = 0
                } else {
                    eprint("error: expected , or ] in array")
                    return (err_val(), p)
                }
            }
        }
        return (arr_base() + hidx, p + 1)
    }
    if c == 123 {
        heads.push(0 - 1)
        let hidx2 = heads.len() - 1
        let mut p2 = skip_json_ws(src, p0 + 1)
        if p2 < n {
            if src[p2] == 125 {
                return (obj_base() + hidx2, p2 + 1)
            }
        }
        let mut prev2 = 0 - 1
        let mut going2 = 1
        while going2 == 1 {
            if p2 >= n {
                eprint("error: unterminated object")
                return (err_val(), p2)
            }
            if src[p2] != 34 {
                eprint("error: object keys must be strings")
                return (err_val(), p2)
            }
            let (kv, kp) = parse_json_string(src, p2, spool)
            if kv == err_val() { return (err_val(), kp) }
            let pc = skip_json_ws(src, kp)
            if pc >= n {
                eprint("error: unterminated object")
                return (err_val(), pc)
            }
            if src[pc] != 58 {
                eprint("error: expected : after object key")
                return (err_val(), pc)
            }
            let (vv, vp) = parse_json_value(src, pc + 1, spool, heads, ckeys, cvals, cnexts)
            if vv == err_val() { return (err_val(), vp) }
            ckeys.push(kv)
            cvals.push(vv)
            cnexts.push(0 - 1)
            let cell2 = cvals.len() - 1
            if prev2 < 0 {
                heads[hidx2] = cell2
            } else {
                cnexts[prev2] = cell2
            }
            prev2 = cell2
            p2 = skip_json_ws(src, vp)
            if p2 >= n {
                eprint("error: unterminated object")
                return (err_val(), p2)
            }
            if src[p2] == 44 {
                p2 = skip_json_ws(src, p2 + 1)
            } else {
                if src[p2] == 125 {
                    going2 = 0
                } else {
                    eprint("error: expected , or } in object")
                    return (err_val(), p2)
                }
            }
        }
        return (obj_base() + hidx2, p2 + 1)
    }
    eprint("error: unexpected byte in JSON")
    (err_val(), p0)
}

# Escape a pool string back into JSON literal form (no quotes).
fn json_escape(s: Str) -> Str {
    let b = str_builder_new()
    let n = s.len()
    let mut i = 0
    while i < n {
        let c = s[i]
        if c == 34 {
            let o1 = str_builder_append(b, "\\\"")
        } else if c == 92 {
            let o2 = str_builder_append(b, "\\\\")
        } else if c == 10 {
            let o3 = str_builder_append(b, "\\n")
        } else if c == 9 {
            let o4 = str_builder_append(b, "\\t")
        } else if c == 13 {
            let o5 = str_builder_append(b, "\\r")
        } else {
            let o6 = str_builder_push(b, c)
        }
        i += 1
    }
    str_builder_finish(b)
}

fn render_compact(v: Int, spool: List<Str>, heads: List<Int>, ckeys: List<Int>, cvals: List<Int>, cnexts: List<Int>) -> Str {
    if v == true_val() { return "true" }
    if v == false_val() { return "false" }
    if v == null_val() { return "null" }
    if is_str_val(v) == 1 {
        let esc = json_escape(spool[v - str_base()])
        return f"\"{esc}\""
    }
    if is_arr_val(v) == 1 {
        let b = str_builder_new()
        let o1 = str_builder_append(b, "[")
        let mut cell = heads[v - arr_base()]
        let mut first = 1
        while cell >= 0 {
            if first == 0 {
                let oc = str_builder_append(b, ",")
            }
            first = 0
            let o2 = str_builder_append(b, @(cvals[cell], spool, heads, ckeys, cvals, cnexts))
            cell = cnexts[cell]
        }
        let o3 = str_builder_append(b, "]")
        return str_builder_finish(b)
    }
    if is_obj_val(v) == 1 {
        let b2 = str_builder_new()
        let o4 = str_builder_append(b2, "{")
        let mut cell2 = heads[v - obj_base()]
        let mut first2 = 1
        while cell2 >= 0 {
            if first2 == 0 {
                let oc2 = str_builder_append(b2, ",")
            }
            first2 = 0
            let kesc = json_escape(spool[ckeys[cell2] - str_base()])
            let o5 = str_builder_append(b2, f"\"{kesc}\":")
            let o6 = str_builder_append(b2, @(cvals[cell2], spool, heads, ckeys, cvals, cnexts))
            cell2 = cnexts[cell2]
        }
        let o7 = str_builder_append(b2, "}")
        return str_builder_finish(b2)
    }
    f"{v}"
}

fn indent_of(ind: Int) -> Str {
    let b = str_builder_new()
    let mut i = 0
    while i < ind {
        let o = str_builder_append(b, "  ")
        i += 1
    }
    str_builder_finish(b)
}

fn render_pretty(v: Int, ind: Int, spool: List<Str>, heads: List<Int>, ckeys: List<Int>, cvals: List<Int>, cnexts: List<Int>) -> Str {
    if is_arr_val(v) == 1 {
        let cell0 = heads[v - arr_base()]
        if cell0 < 0 { return "[]" }
        let b = str_builder_new()
        let o1 = str_builder_append(b, "[\n")
        let mut cell = cell0
        while cell >= 0 {
            let o2 = str_builder_append(b, indent_of(ind + 1))
            let o3 = str_builder_append(b, @(cvals[cell], ind + 1, spool, heads, ckeys, cvals, cnexts))
            cell = cnexts[cell]
            if cell >= 0 {
                let o4 = str_builder_append(b, ",")
            }
            let o5 = str_builder_append(b, "\n")
        }
        let o6 = str_builder_append(b, indent_of(ind))
        let o7 = str_builder_append(b, "]")
        return str_builder_finish(b)
    }
    if is_obj_val(v) == 1 {
        let cellz = heads[v - obj_base()]
        if cellz < 0 { return "{}" }
        let b2 = str_builder_new()
        let o8 = str_builder_append(b2, "{\n")
        let mut cell2 = cellz
        while cell2 >= 0 {
            let o9 = str_builder_append(b2, indent_of(ind + 1))
            let kesc2 = json_escape(spool[ckeys[cell2] - str_base()])
            let oa = str_builder_append(b2, f"\"{kesc2}\": ")
            let ob = str_builder_append(b2, @(cvals[cell2], ind + 1, spool, heads, ckeys, cvals, cnexts))
            cell2 = cnexts[cell2]
            if cell2 >= 0 {
                let oc = str_builder_append(b2, ",")
            }
            let od = str_builder_append(b2, "\n")
        }
        let oe = str_builder_append(b2, indent_of(ind))
        let of = str_builder_append(b2, "}")
        return str_builder_finish(b2)
    }
    render_compact(v, spool, heads, ckeys, cvals, cnexts)
}

fn render_value(v: Int, compact: Int, spool: List<Str>, heads: List<Int>, ckeys: List<Int>, cvals: List<Int>, cnexts: List<Int>) -> Str {
    if compact == 1 {
        return render_compact(v, spool, heads, ckeys, cvals, cnexts)
    }
    render_pretty(v, 0, spool, heads, ckeys, cvals, cnexts)
}

fn count_cells(v: Int, base: Int, heads: List<Int>, cnexts: List<Int>) -> Int {
    let mut cell = heads[v - base]
    let mut cnt = 0
    while cell >= 0 {
        cnt += 1
        cell = cnexts[cell]
    }
    cnt
}

# Parse one path expression (`.`, `.name` chains, `[N]`/`[-N]`
# indexes, `[]` iteration) into the parallel segment lists. Kinds:
# 0 = field (payload interns the name), 1 = index (payload may be
# negative — counted from the end), 2 = iterate, 3 = select (payload
# indexes the select tables; emitted by parse_filter, never here).
# allow_iter 0 rejects `[]` (select inner paths stay single-valued).
# Returns 0 ok, -1 after a loud error.
fn parse_path_into(path: Str, seg_kind: List<Int>, seg_pay: List<Int>, spool: List<Str>, allow_iter: Int) -> Int {
    let n = path.len()
    if n == 0 {
        eprint("error: empty path in filter")
        return 0 - 1
    }
    if path[0] != 46 {
        eprint("error: filter paths must start with .")
        return 0 - 1
    }
    let mut i = 1
    while i < n {
        let c = path[i]
        if c == 46 {
            i += 1
            if i >= n {
                eprint("error: trailing . in filter")
                return 0 - 1
            }
            if path[i] != 91 {
                let start = i
                while i < n {
                    if is_ident_byte(path[i]) == 0 { break }
                    i += 1
                }
                if i == start {
                    eprint("error: expected field name after .")
                    return 0 - 1
                }
                seg_kind.push(0)
                seg_pay.push(intern(str_slice(path, start, i - start), spool))
            }
        } else if c == 91 {
            let close = i + 1
            let mut cl = close
            let mut found = 0 - 1
            while cl < n {
                if path[cl] == 93 {
                    found = cl
                    break
                }
                cl += 1
            }
            if found < 0 {
                eprint("error: unterminated [ in filter")
                return 0 - 1
            }
            if found == i + 1 {
                if allow_iter == 0 {
                    eprint("error: select paths cannot iterate")
                    return 0 - 1
                }
                seg_kind.push(2)
                seg_pay.push(0)
            } else {
                let mut j = i + 1
                let mut neg = 0
                if path[j] == 45 {
                    neg = 1
                    j += 1
                }
                let mut idx = 0
                let mut digs = 0
                while j < found {
                    let d = path[j]
                    if d < 48 or d > 57 {
                        eprint("error: index must be an integer")
                        return 0 - 1
                    }
                    idx = idx * 10 + (d - 48)
                    digs += 1
                    j += 1
                }
                if digs == 0 {
                    eprint("error: empty index")
                    return 0 - 1
                }
                if neg == 1 { idx = 0 - idx }
                seg_kind.push(1)
                seg_pay.push(idx)
            }
            i = found + 1
        } else {
            if i == 1 {
                let start2 = i
                while i < n {
                    if is_ident_byte(path[i]) == 0 { break }
                    i += 1
                }
                if i == start2 {
                    eprint("error: unexpected byte in filter")
                    return 0 - 1
                }
                seg_kind.push(0)
                seg_pay.push(intern(str_slice(path, start2, i - start2), spool))
            } else {
                eprint("error: unexpected byte in filter")
                return 0 - 1
            }
        }
    }
    0
}

# Parse one select condition atom (`<path>` bare or
# `<path> op <literal>`) into the shared atom tables. gflag 1 marks
# the atom as starting a new OR group (packed as +128 on the meta).
# Returns 0 ok, -1 after a loud error.
fn parse_select_atom(inner: Str, sel_meta: List<Int>, sel_lit: List<Int>, pend_paths: List<Str>, spool: List<Str>, gflag: Int) -> Int {
    # `has("key")` / `has(N)` as an atom tests the piped value itself
    # (op 8 — metas 128/129; the group flag sits at +256 to stay clear
# of the op field; the pend path stays identity).
    if inner.len() >= 6 and str_slice(inner, 0, 4) == "has(" {
        if inner[inner.len() - 1] != 41 {
            eprint("error: has is missing its closing parenthesis")
            return 0 - 1
        }
        let harg = str_slice(inner, 4, inner.len() - 5).trim()
        let mut hlitk = 0
        let mut hlit = 0
        if harg.len() >= 2 and harg[0] == 34 {
            if harg[harg.len() - 1] != 34 {
                eprint("error: unterminated string literal in has")
                return 0 - 1
            }
            hlitk = 1
            hlit = intern(str_slice(harg, 1, harg.len() - 2), spool)
        } else {
            let mut hj = 0
            let mut hdigs = 0
            let mut hacc = 0
            while hj < harg.len() {
                let hd = harg[hj]
                if hd < 48 or hd > 57 {
                    eprint("error: has needs a string key or a non-negative index")
                    return 0 - 1
                }
                hacc = hacc * 10 + (hd - 48)
                hdigs += 1
                hj += 1
            }
            if hdigs == 0 {
                eprint("error: has needs a string key or a non-negative index")
                return 0 - 1
            }
            hlit = hacc
        }
        let mut hmeta = 8 * 16 + hlitk
        if gflag == 1 { hmeta = hmeta + 256 }
        sel_meta.push(hmeta)
        sel_lit.push(hlit)
        pend_paths.push(".")
        return 0
    }
    let mut op = 6
    let mut opat = 0 - 1
    let mut oplen = 0
    let mut k = 0
    let mut kinq = 0
    while k < inner.len() {
        let b = inner[k]
        if b == 34 {
            if kinq == 1 { kinq = 0 } else { kinq = 1 }
        }
        if kinq == 0 and opat < 0 {
            if b == 61 and k + 1 < inner.len() {
                if inner[k + 1] == 61 { op = 0; opat = k; oplen = 2 }
            }
            if b == 33 and k + 1 < inner.len() {
                if inner[k + 1] == 61 { op = 1; opat = k; oplen = 2 }
            }
            if b == 60 {
                if k + 1 < inner.len() and inner[k + 1] == 61 { op = 4; opat = k; oplen = 2 }
                else { op = 2; opat = k; oplen = 1 }
            }
            if b == 62 {
                if k + 1 < inner.len() and inner[k + 1] == 61 { op = 5; opat = k; oplen = 2 }
                else { op = 3; opat = k; oplen = 1 }
            }
        }
        k += 1
    }
    let mut lhs = inner
    let mut litk = 0
    let mut litv = 0
    if opat >= 0 {
        lhs = str_slice(inner, 0, opat).trim()
        let rhs = str_slice(inner, opat + oplen, inner.len() - opat - oplen).trim()
        if rhs.len() == 0 {
            eprint("error: select comparison needs a literal")
            return 0 - 1
        }
        if rhs == "true" {
            litk = 2
        } else if rhs == "false" {
            litk = 3
        } else if rhs == "null" {
            litk = 4
        } else if rhs[0] == 34 {
            if rhs.len() < 2 or rhs[rhs.len() - 1] != 34 {
                eprint("error: unterminated string literal in select")
                return 0 - 1
            }
            litk = 1
            litv = intern(str_slice(rhs, 1, rhs.len() - 2), spool)
        } else {
            let mut rj = 0
            let mut rneg = 0
            if rhs[0] == 45 {
                rneg = 1
                rj = 1
            }
            let mut racc = 0
            let mut rdigs = 0
            while rj < rhs.len() {
                let rd = rhs[rj]
                if rd < 48 or rd > 57 {
                    eprint("error: select literals are integers, strings, true, false, or null")
                    return 0 - 1
                }
                racc = racc * 10 + (rd - 48)
                rdigs += 1
                rj += 1
            }
            if rdigs == 0 {
                eprint("error: select literals are integers, strings, true, false, or null")
                return 0 - 1
            }
            litk = 0
            if rneg == 1 { racc = 0 - racc }
            litv = racc
        }
        if op >= 2 and litk != 0 {
            eprint("error: ordered select comparisons need integer literals")
            return 0 - 1
        }
    }
    let mut meta = op * 16 + litk
    if gflag == 1 { meta = meta + 256 }
    sel_meta.push(meta)
    sel_lit.push(litv)
    pend_paths.push(lhs)
    0
}

# Split the filter on top-level pipes and parse each stage. Pure path
# stages concatenate (`.users[] | .name` walks like `.users[].name`),
# `select(<cond> [and|or <cond>]...)` becomes a kind-3 segment whose
# payload packs its atom span (start * 4096 + count) into the shared
# atom tables — `and` binds tighter than `or` (sum of products, left
# to right with short-circuit), each atom is `<path> [op <literal>]`,
# and inner paths append to the shared segment lists after the main
# walk so the [0, n_main) prefix stays contiguous. `map(<path>)` is a
# kind-4 segment building a new array (atom op 7), `has("key")` /
# `has(N)` is a kind-5 segment emitting true/false (atom op 8), and
# `first`/`last` are sugar for index segments 0 / -1. A final
# `length`/`keys` stage becomes the emission tail. Atom ops: 0 ==,
# 1 !=, 2 <, 3 >, 4 <=, 5 >=, 6 bare truthiness (false/null drop);
# +256 marks an atom starting a new OR group (op 8 itself packs to
# 128+litk, so the flag lives above the op field). Literal kinds:
# 0 integer, 1 verbatim string (no escapes), 2 true, 3 false,
# 4 null. Pushes the main-walk segment count into meta_out; returns
# the tail (0 none, 1 length, 2 keys) or -1 after a loud error.
fn parse_filter(f: Str, seg_kind: List<Int>, seg_pay: List<Int>, sel_meta: List<Int>, sel_lit: List<Int>, sel_span: List<Int>, spool: List<Str>, meta_out: List<Int>) -> Int {
    let src = f.trim()
    let n = src.len()
    let mut tail = 0
    let pend_paths: List<Str> = []
    let mut i = 0
    let mut part_start = 0
    let mut inq = 0
    let mut done_tail = 0
    while i <= n {
        let mut split = 0
        if i == n {
            split = 1
        } else {
            let c = src[i]
            if c == 34 {
                if inq == 1 { inq = 0 } else { inq = 1 }
            }
            if c == 124 {
                if inq == 0 { split = 1 }
            }
        }
        if split == 1 {
            let part = str_slice(src, part_start, i - part_start).trim()
            if done_tail == 1 {
                eprint("error: length/keys must be the last pipe stage")
                return 0 - 1
            }
            if part == "length" {
                tail = 1
                done_tail = 1
            } else if part == "keys" {
                tail = 2
                done_tail = 1
            } else if part.len() >= 8 and str_slice(part, 0, 7) == "select(" {
                if part[part.len() - 1] != 41 {
                    eprint("error: select is missing its closing parenthesis")
                    return 0 - 1
                }
                let inner = str_slice(part, 7, part.len() - 8).trim()
                if inner.len() == 0 {
                    eprint("error: select needs a condition")
                    return 0 - 1
                }
                # split the condition on top-level ` and ` / ` or `
                # connectors outside quotes; each piece is one atom and
                # an `or` connector starts a new group on the next atom.
                let astart = sel_meta.len()
                let mut afrom = 0
                let mut gflag = 0
                let mut k = 0
                let mut kinq = 0
                while k <= inner.len() {
                    let mut cut = 0
                    let mut clen = 0
                    let mut next_gflag = 0
                    if k == inner.len() {
                        cut = 1
                    } else {
                        let b = inner[k]
                        if b == 34 {
                            if kinq == 1 { kinq = 0 } else { kinq = 1 }
                        }
                        if kinq == 0 and b == 32 {
                            if k + 5 <= inner.len() and str_slice(inner, k, 5) == " and " {
                                cut = 1
                                clen = 5
                            } else if k + 4 <= inner.len() and str_slice(inner, k, 4) == " or " {
                                cut = 1
                                clen = 4
                                next_gflag = 1
                            }
                        }
                    }
                    if cut == 1 {
                        let atom = str_slice(inner, afrom, k - afrom).trim()
                        if atom.len() == 0 {
                            eprint("error: select needs a condition on both connector sides")
                            return 0 - 1
                        }
                        if parse_select_atom(atom, sel_meta, sel_lit, pend_paths, spool, gflag) != 0 { return 0 - 1 }
                        gflag = next_gflag
                        afrom = k + clen
                        if clen > 0 { k = k + clen } else { k += 1 }
                    } else {
                        k += 1
                    }
                }
                let acount = sel_meta.len() - astart
                seg_kind.push(3)
                seg_pay.push(astart * 4096 + acount)
            } else if part.len() >= 6 and str_slice(part, 0, 4) == "map(" {
                if part[part.len() - 1] != 41 {
                    eprint("error: map is missing its closing parenthesis")
                    return 0 - 1
                }
                let minner = str_slice(part, 4, part.len() - 5).trim()
                if minner.len() == 0 {
                    eprint("error: map needs a path")
                    return 0 - 1
                }
                sel_meta.push(7 * 16)
                sel_lit.push(0)
                pend_paths.push(minner)
                seg_kind.push(4)
                seg_pay.push(sel_meta.len() - 1)
            } else if part.len() >= 6 and str_slice(part, 0, 4) == "has(" {
                if part[part.len() - 1] != 41 {
                    eprint("error: has is missing its closing parenthesis")
                    return 0 - 1
                }
                let hinner = str_slice(part, 4, part.len() - 5).trim()
                let mut hlitk = 0
                let mut hlit = 0
                if hinner.len() >= 2 and hinner[0] == 34 {
                    if hinner[hinner.len() - 1] != 34 {
                        eprint("error: unterminated string literal in has")
                        return 0 - 1
                    }
                    hlitk = 1
                    hlit = intern(str_slice(hinner, 1, hinner.len() - 2), spool)
                } else {
                    let mut hj = 0
                    let mut hdigs = 0
                    let mut hacc = 0
                    while hj < hinner.len() {
                        let hd = hinner[hj]
                        if hd < 48 or hd > 57 {
                            eprint("error: has needs a string key or a non-negative index")
                            return 0 - 1
                        }
                        hacc = hacc * 10 + (hd - 48)
                        hdigs += 1
                        hj += 1
                    }
                    if hdigs == 0 {
                        eprint("error: has needs a string key or a non-negative index")
                        return 0 - 1
                    }
                    hlit = hacc
                }
                sel_meta.push(8 * 16 + hlitk)
                sel_lit.push(hlit)
                pend_paths.push(".")
                seg_kind.push(5)
                seg_pay.push(sel_meta.len() - 1)
            } else if part == "first" {
                seg_kind.push(1)
                seg_pay.push(0)
            } else if part == "last" {
                seg_kind.push(1)
                seg_pay.push(0 - 1)
            } else if part == "add" {
                seg_kind.push(6)
                seg_pay.push(0)
            } else if part == "sort" {
                seg_kind.push(10)
                seg_pay.push(0)
            } else if part == "unique" {
                seg_kind.push(11)
                seg_pay.push(0)
            } else if part.len() >= 2 and part[0] == 123 {
                # object construction: {key: <path>, "quoted": <path>,
                # shorthand} — each entry is one atom (op 9) carrying
                # the interned key and its value path (shorthand `key`
                # walks `.key`). Later duplicate keys overwrite.
                if part[part.len() - 1] != 125 {
                    eprint("error: object construction is missing }")
                    return 0 - 1
                }
                let oinner = str_slice(part, 1, part.len() - 2).trim()
                let oastart = sel_meta.len()
                if oinner.len() > 0 {
                    let mut oi = 0
                    let mut ofrom = 0
                    let mut oinq = 0
                    while oi <= oinner.len() {
                        let mut ocut = 0
                        if oi == oinner.len() {
                            ocut = 1
                        } else {
                            let ob = oinner[oi]
                            if ob == 34 {
                                if oinq == 1 { oinq = 0 } else { oinq = 1 }
                            }
                            if oinq == 0 and ob == 44 { ocut = 1 }
                        }
                        if ocut == 1 {
                            let entry = str_slice(oinner, ofrom, oi - ofrom).trim()
                            if entry.len() == 0 {
                                eprint("error: empty object construction entry")
                                return 0 - 1
                            }
                            # split entry into key [: path]
                            let mut kend = 0
                            let mut kname = ""
                            if entry[0] == 34 {
                                let mut qk = 1
                                let mut qfound = 0 - 1
                                while qk < entry.len() {
                                    if entry[qk] == 34 {
                                        qfound = qk
                                        qk = entry.len()
                                    } else {
                                        qk += 1
                                    }
                                }
                                if qfound < 0 {
                                    eprint("error: unterminated object key")
                                    return 0 - 1
                                }
                                kname = str_slice(entry, 1, qfound - 1)
                                kend = qfound + 1
                            } else {
                                let mut ik = 0
                                while ik < entry.len() {
                                    if is_ident_byte(entry[ik]) == 0 { break }
                                    ik += 1
                                }
                                if ik == 0 {
                                    eprint("error: object keys are identifiers or quoted strings")
                                    return 0 - 1
                                }
                                kname = str_slice(entry, 0, ik)
                                kend = ik
                            }
                            let rest = str_slice(entry, kend, entry.len() - kend).trim()
                            let mut vpath = f".{kname}"
                            if rest.len() > 0 {
                                if rest[0] != 58 {
                                    eprint("error: object entries need a : before the value path")
                                    return 0 - 1
                                }
                                vpath = str_slice(rest, 1, rest.len() - 1).trim()
                            }
                            sel_meta.push(9 * 16)
                            sel_lit.push(intern(kname, spool))
                            pend_paths.push(vpath)
                            ofrom = oi + 1
                        }
                        oi += 1
                    }
                }
                let oacount = sel_meta.len() - oastart
                seg_kind.push(12)
                seg_pay.push(oastart * 4096 + oacount)
            } else if part.len() >= 2 and part[0] == 34 {
                # string interpolation: a quoted template whose \(...)
                # holes carry single-valued paths. Each hole is one
                # atom (op 10) holding the literal chunk before it and
                # the hole path; the trailing literal rides a litk-1
                # atom with no hole. Escapes: \\ and \" only, \( opens
                # a hole, everything else is verbatim.
                if part[part.len() - 1] != 34 {
                    eprint("error: unterminated string template")
                    return 0 - 1
                }
                let tastart = sel_meta.len()
                let mut tb = str_builder_new()
                let mut ti = 1
                let tend = part.len() - 1
                while ti < tend {
                    let tc = part[ti]
                    if tc == 92 and ti + 1 < tend {
                        let tn = part[ti + 1]
                        if tn == 40 {
                            let mut tclose = ti + 2
                            let mut tfound = 0 - 1
                            while tclose < tend {
                                if part[tclose] == 41 {
                                    tfound = tclose
                                    tclose = tend
                                } else {
                                    tclose += 1
                                }
                            }
                            if tfound < 0 {
                                eprint("error: unterminated \\( hole in template")
                                return 0 - 1
                            }
                            let hpath = str_slice(part, ti + 2, tfound - ti - 2).trim()
                            if hpath.len() == 0 {
                                eprint("error: empty \\( hole in template")
                                return 0 - 1
                            }
                            sel_meta.push(10 * 16)
                            sel_lit.push(intern(str_builder_finish(tb), spool))
                            pend_paths.push(hpath)
                            tb = str_builder_new()
                            ti = tfound + 1
                        } else if tn == 92 {
                            let tp1 = str_builder_push(tb, 92)
                            ti += 2
                        } else if tn == 34 {
                            let tp2 = str_builder_push(tb, 34)
                            ti += 2
                        } else {
                            let tp3 = str_builder_push(tb, 92)
                            ti += 1
                        }
                    } else {
                        let tp4 = str_builder_push(tb, tc)
                        ti += 1
                    }
                }
                sel_meta.push(10 * 16 + 1)
                sel_lit.push(intern(str_builder_finish(tb), spool))
                pend_paths.push(".")
                let tacount = sel_meta.len() - tastart
                seg_kind.push(13)
                seg_pay.push(tastart * 4096 + tacount)
            } else if part == "min" {
                seg_kind.push(8)
                seg_pay.push(0)
            } else if part == "max" {
                seg_kind.push(9)
                seg_pay.push(0)
            } else if part.len() >= 8 and str_slice(part, 0, 5) == "join(" {
                if part[part.len() - 1] != 41 {
                    eprint("error: join is missing its closing parenthesis")
                    return 0 - 1
                }
                let jinner = str_slice(part, 5, part.len() - 6).trim()
                if jinner.len() < 2 or jinner[0] != 34 or jinner[jinner.len() - 1] != 34 {
                    eprint("error: join needs a string separator")
                    return 0 - 1
                }
                seg_kind.push(7)
                seg_pay.push(intern(str_slice(jinner, 1, jinner.len() - 2), spool))
            } else {
                if parse_path_into(part, seg_kind, seg_pay, spool, 1) != 0 { return 0 - 1 }
            }
            part_start = i + 1
        }
        i += 1
    }
    let n_main = seg_kind.len()
    let mut pj = 0
    while pj < pend_paths.len() {
        let span_start = seg_kind.len()
        if parse_path_into(pend_paths[pj], seg_kind, seg_pay, spool, 0) != 0 { return 0 - 1 }
        sel_span.push(span_start)
        sel_span.push(seg_kind.len())
        pj += 1
    }
    meta_out.push(n_main)
    tail
}

# Walk a single-valued path span (fields and indexes only) from v.
# Missing fields and out-of-range indexes turn into null; indexing a
# value of the wrong type is a loud error returned as the err value.
fn walk_path(v: Int, from: Int, to: Int, seg_kind: List<Int>, seg_pay: List<Int>, spool: List<Str>, heads: List<Int>, ckeys: List<Int>, cvals: List<Int>, cnexts: List<Int>) -> Int {
    let mut cur = v
    let mut si = from
    while si < to {
        let kind = seg_kind[si]
        if kind == 0 {
            if cur == null_val() { }
            else if is_obj_val(cur) == 0 {
                eprint("error: cannot index a non-object with a field name")
                return err_val()
            } else {
                let want = spool[seg_pay[si] - str_base()]
                let mut cell = heads[cur - obj_base()]
                let mut found = null_val()
                while cell >= 0 {
                    if spool[ckeys[cell] - str_base()] == want {
                        found = cvals[cell]
                        cell = 0 - 1
                    } else {
                        cell = cnexts[cell]
                    }
                }
                cur = found
            }
        } else {
            if cur == null_val() { }
            else if is_arr_val(cur) == 0 {
                eprint("error: cannot index a non-array with a number")
                return err_val()
            } else {
                let mut want2 = seg_pay[si]
                if want2 < 0 {
                    want2 = count_cells(cur, arr_base(), heads, cnexts) + want2
                }
                let mut cell2 = heads[cur - arr_base()]
                let mut at = 0
                let mut found2 = null_val()
                while cell2 >= 0 {
                    if at == want2 {
                        found2 = cvals[cell2]
                        cell2 = 0 - 1
                    } else {
                        at += 1
                        cell2 = cnexts[cell2]
                    }
                }
                cur = found2
            }
        }
        si += 1
    }
    cur
}

# Evaluate a select's atom span [astart, astart+acount) as a sum of
# products: `and` chains atoms inside a group, an atom carrying the
# +128 flag starts a new OR group, and the first passing group wins
# (left to right, short-circuit — later atoms stay unevaluated once a
# group fails or the whole select passes). Returns 1 pass, 0 drop,
# 3 on a loud error.
fn select_groups_pass(v: Int, astart: Int, acount: Int, seg_kind: List<Int>, seg_pay: List<Int>, sel_meta: List<Int>, sel_lit: List<Int>, sel_span: List<Int>, spool: List<Str>, heads: List<Int>, ckeys: List<Int>, cvals: List<Int>, cnexts: List<Int>) -> Int {
    let aend = astart + acount
    let mut ai = astart
    let mut overall = 0
    while ai < aend {
        if overall == 1 {
            ai = aend
        } else {
            let mut group_ok = 1
            let mut aj = ai
            let mut scanning = 1
            while scanning == 1 {
                if aj >= aend {
                    scanning = 0
                } else {
                    let meta = sel_meta[aj]
                    if aj > ai and meta >= 256 {
                        scanning = 0
                    } else {
                        if group_ok == 1 {
                            let mut m2 = meta
                            if m2 >= 256 { m2 = m2 - 256 }
                            let aop = m2 / 16
                            if aop == 8 {
                                # has atom: test the piped value directly.
                                let hlitk2 = m2 - aop * 16
                                let mut hfound = 0
                                if hlitk2 == 1 {
                                    if is_obj_val(v) == 0 {
                                        eprint("error: has with a string key needs an object")
                                        return 3
                                    }
                                    let hwant = spool[sel_lit[aj] - str_base()]
                                    let mut hcell = heads[v - obj_base()]
                                    while hcell >= 0 {
                                        if spool[ckeys[hcell] - str_base()] == hwant {
                                            hfound = 1
                                            hcell = 0 - 1
                                        } else {
                                            hcell = cnexts[hcell]
                                        }
                                    }
                                } else {
                                    if is_arr_val(v) == 0 {
                                        eprint("error: has with an index needs an array")
                                        return 3
                                    }
                                    if sel_lit[aj] < count_cells(v, arr_base(), heads, cnexts) {
                                        hfound = 1
                                    }
                                }
                                if hfound == 0 { group_ok = 0 }
                            } else {
                                let pv = walk_path(v, sel_span[aj * 2], sel_span[aj * 2 + 1], seg_kind, seg_pay, spool, heads, ckeys, cvals, cnexts)
                                if pv == err_val() { return 3 }
                                let r = select_passes(pv, m2, sel_lit[aj], spool)
                                if r == 3 { return 3 }
                                if r == 0 { group_ok = 0 }
                            }
                        }
                        aj += 1
                    }
                }
            }
            if group_ok == 1 { overall = 1 }
            ai = aj
        }
    }
    overall
}

# Decide whether the selected value passes the packed op/literal.
# Returns 1 pass, 0 drop, 3 on a loud type error.
fn select_passes(pv: Int, meta: Int, lit: Int, spool: List<Str>) -> Int {
    let op = meta / 16
    let litk = meta - op * 16
    if op == 6 {
        if pv == false_val() { return 0 }
        if pv == null_val() { return 0 }
        return 1
    }
    if op <= 1 {
        let mut same = 0
        if litk == 0 {
            if is_num_val(pv) == 1 {
                if pv == lit { same = 1 }
            }
        } else if litk == 1 {
            if is_str_val(pv) == 1 {
                if spool[pv - str_base()] == spool[lit - str_base()] { same = 1 }
            }
        } else if litk == 2 {
            if pv == true_val() { same = 1 }
        } else if litk == 3 {
            if pv == false_val() { same = 1 }
        } else {
            if pv == null_val() { same = 1 }
        }
        if op == 0 { return same }
        if same == 1 { return 0 }
        return 1
    }
    if is_num_val(pv) == 0 {
        eprint("error: ordered select comparisons need a number on the left")
        return 3
    }
    let mut pass = 0
    if op == 2 {
        if pv < lit { pass = 1 }
    }
    if op == 3 {
        if pv > lit { pass = 1 }
    }
    if op == 4 {
        if pv <= lit { pass = 1 }
    }
    if op == 5 {
        if pv >= lit { pass = 1 }
    }
    pass
}

# Apply the pipe tail and push the rendered result. Returns 0 ok,
# 3 on a type error.
fn emit_tail(v: Int, tail: Int, compact: Int, out: List<Str>, spool: List<Str>, heads: List<Int>, ckeys: List<Int>, cvals: List<Int>, cnexts: List<Int>) -> Int {
    if tail == 1 {
        if is_str_val(v) == 1 {
            let slen = spool[v - str_base()].len()
            out.push(f"{slen}")
            return 0
        }
        if is_arr_val(v) == 1 {
            let acnt = count_cells(v, arr_base(), heads, cnexts)
            out.push(f"{acnt}")
            return 0
        }
        if is_obj_val(v) == 1 {
            let ocnt = count_cells(v, obj_base(), heads, cnexts)
            out.push(f"{ocnt}")
            return 0
        }
        if v == null_val() {
            out.push("0")
            return 0
        }
        eprint("error: length needs a string, array, object, or null")
        return 3
    }
    if tail == 2 {
        if is_obj_val(v) == 0 {
            eprint("error: keys needs an object")
            return 3
        }
        let names: List<Str> = []
        let mut cell = heads[v - obj_base()]
        while cell >= 0 {
            names.push(spool[ckeys[cell] - str_base()])
            cell = cnexts[cell]
        }
        names.sort()
        heads.push(0 - 1)
        let hidx = heads.len() - 1
        let mut prev = 0 - 1
        let mut i = 0
        while i < names.len() {
            ckeys.push(0 - 1)
            cvals.push(intern(names[i], spool))
            cnexts.push(0 - 1)
            let ncell = cvals.len() - 1
            if prev < 0 {
                heads[hidx] = ncell
            } else {
                cnexts[prev] = ncell
            }
            prev = ncell
            i += 1
        }
        out.push(render_value(arr_base() + hidx, compact, spool, heads, ckeys, cvals, cnexts))
        return 0
    }
    out.push(render_value(v, compact, spool, heads, ckeys, cvals, cnexts))
    0
}

# Walk the value through the main filter segments [si, n_main),
# emitting one output per reached leaf. Missing fields and
# out-of-range indexes continue as null; select segments drop values
# that fail their condition; the wrong container type is a loud
# error (3). Sixteen parameters — the compiler's post-extension slot
# ceiling, locked by e397.
fn eval_filter(v: Int, si: Int, n_main: Int, seg_kind: List<Int>, seg_pay: List<Int>, sel_meta: List<Int>, sel_lit: List<Int>, sel_span: List<Int>, tail: Int, compact: Int, out: List<Str>, spool: List<Str>, heads: List<Int>, ckeys: List<Int>, cvals: List<Int>, cnexts: List<Int>) -> Int {
    if si >= n_main {
        return emit_tail(v, tail, compact, out, spool, heads, ckeys, cvals, cnexts)
    }
    let kind = seg_kind[si]
    if kind == 0 {
        if v == null_val() {
            return eval_filter(null_val(), si + 1, n_main, seg_kind, seg_pay, sel_meta, sel_lit, sel_span, tail, compact, out, spool, heads, ckeys, cvals, cnexts)
        }
        if is_obj_val(v) == 0 {
            eprint("error: cannot index a non-object with a field name")
            return 3
        }
        let want = spool[seg_pay[si] - str_base()]
        let mut cell = heads[v - obj_base()]
        let mut found = null_val()
        while cell >= 0 {
            if spool[ckeys[cell] - str_base()] == want {
                found = cvals[cell]
                cell = 0 - 1
            } else {
                cell = cnexts[cell]
            }
        }
        return eval_filter(found, si + 1, n_main, seg_kind, seg_pay, sel_meta, sel_lit, sel_span, tail, compact, out, spool, heads, ckeys, cvals, cnexts)
    }
    if kind == 1 {
        if v == null_val() {
            return eval_filter(null_val(), si + 1, n_main, seg_kind, seg_pay, sel_meta, sel_lit, sel_span, tail, compact, out, spool, heads, ckeys, cvals, cnexts)
        }
        if is_arr_val(v) == 0 {
            eprint("error: cannot index a non-array with a number")
            return 3
        }
        let mut want2 = seg_pay[si]
        if want2 < 0 {
            want2 = count_cells(v, arr_base(), heads, cnexts) + want2
        }
        let mut cell2 = heads[v - arr_base()]
        let mut at = 0
        let mut found2 = null_val()
        while cell2 >= 0 {
            if at == want2 {
                found2 = cvals[cell2]
                cell2 = 0 - 1
            } else {
                at += 1
                cell2 = cnexts[cell2]
            }
        }
        return eval_filter(found2, si + 1, n_main, seg_kind, seg_pay, sel_meta, sel_lit, sel_span, tail, compact, out, spool, heads, ckeys, cvals, cnexts)
    }
    if kind == 3 {
        let pay = seg_pay[si]
        let astart = pay / 4096
        let acount = pay - astart * 4096
        let verdict = select_groups_pass(v, astart, acount, seg_kind, seg_pay, sel_meta, sel_lit, sel_span, spool, heads, ckeys, cvals, cnexts)
        if verdict == 3 { return 3 }
        if verdict == 0 { return 0 }
        return eval_filter(v, si + 1, n_main, seg_kind, seg_pay, sel_meta, sel_lit, sel_span, tail, compact, out, spool, heads, ckeys, cvals, cnexts)
    }
    if kind == 4 {
        # map(<path>): materialize a fresh array from each element's
        # single-valued walk. Arrays only, loud otherwise.
        let mj = seg_pay[si]
        if is_arr_val(v) == 0 {
            eprint("error: map needs an array")
            return 3
        }
        heads.push(0 - 1)
        let hidx = heads.len() - 1
        let mut prev = 0 - 1
        let mut cellm = heads[v - arr_base()]
        while cellm >= 0 {
            let mv = walk_path(cvals[cellm], sel_span[mj * 2], sel_span[mj * 2 + 1], seg_kind, seg_pay, spool, heads, ckeys, cvals, cnexts)
            if mv == err_val() { return 3 }
            ckeys.push(0 - 1)
            cvals.push(mv)
            cnexts.push(0 - 1)
            let ncell = cvals.len() - 1
            if prev < 0 {
                heads[hidx] = ncell
            } else {
                cnexts[prev] = ncell
            }
            prev = ncell
            cellm = cnexts[cellm]
        }
        return eval_filter(arr_base() + hidx, si + 1, n_main, seg_kind, seg_pay, sel_meta, sel_lit, sel_span, tail, compact, out, spool, heads, ckeys, cvals, cnexts)
    }
    if kind == 5 {
        # has("key") on objects / has(N) on arrays, emitting a boolean.
        let hj = seg_pay[si]
        let hlitk = sel_meta[hj] - 8 * 16
        let mut ans = false_val()
        if hlitk == 1 {
            if is_obj_val(v) == 0 {
                eprint("error: has with a string key needs an object")
                return 3
            }
            let want3 = spool[sel_lit[hj] - str_base()]
            let mut cellh = heads[v - obj_base()]
            while cellh >= 0 {
                if spool[ckeys[cellh] - str_base()] == want3 {
                    ans = true_val()
                    cellh = 0 - 1
                } else {
                    cellh = cnexts[cellh]
                }
            }
        } else {
            if is_arr_val(v) == 0 {
                eprint("error: has with an index needs an array")
                return 3
            }
            if sel_lit[hj] < count_cells(v, arr_base(), heads, cnexts) {
                ans = true_val()
            }
        }
        return eval_filter(ans, si + 1, n_main, seg_kind, seg_pay, sel_meta, sel_lit, sel_span, tail, compact, out, spool, heads, ckeys, cvals, cnexts)
    }
    if kind == 6 or kind == 8 or kind == 9 {
        # add sums numbers or concatenates strings; min/max reduce
        # number arrays. Empty arrays yield null, mixed or unsupported
        # element types are loud.
        if is_arr_val(v) == 0 {
            eprint("error: add, min, and max need an array")
            return 3
        }
        let mut cnt = 0
        let mut nums = 1
        let mut strs = 1
        let mut acc = 0
        let mut best = 0
        let mut cella = heads[v - arr_base()]
        let sb = str_builder_new()
        while cella >= 0 {
            let ev = cvals[cella]
            if is_num_val(ev) == 1 {
                strs = 0
                if cnt == 0 { best = ev }
                acc = acc + ev
                if kind == 8 {
                    if ev < best { best = ev }
                }
                if kind == 9 {
                    if ev > best { best = ev }
                }
            } else if is_str_val(ev) == 1 {
                nums = 0
                let piece = spool[ev - str_base()]
                let oadd = str_builder_append(sb, piece)
            } else {
                nums = 0
                strs = 0
            }
            cnt += 1
            cella = cnexts[cella]
        }
        if cnt == 0 {
            return eval_filter(null_val(), si + 1, n_main, seg_kind, seg_pay, sel_meta, sel_lit, sel_span, tail, compact, out, spool, heads, ckeys, cvals, cnexts)
        }
        if kind == 6 {
            if nums == 1 {
                if acc >= num_band() or acc <= 0 - num_band() {
                    eprint("error: add overflows the integer band")
                    return 3
                }
                return eval_filter(acc, si + 1, n_main, seg_kind, seg_pay, sel_meta, sel_lit, sel_span, tail, compact, out, spool, heads, ckeys, cvals, cnexts)
            }
            if strs == 1 {
                return eval_filter(intern(str_builder_finish(sb), spool), si + 1, n_main, seg_kind, seg_pay, sel_meta, sel_lit, sel_span, tail, compact, out, spool, heads, ckeys, cvals, cnexts)
            }
            eprint("error: add needs all numbers or all strings")
            return 3
        }
        if nums == 0 {
            eprint("error: min and max need numbers")
            return 3
        }
        return eval_filter(best, si + 1, n_main, seg_kind, seg_pay, sel_meta, sel_lit, sel_span, tail, compact, out, spool, heads, ckeys, cvals, cnexts)
    }
    if kind == 10 or kind == 11 {
        # sort orders a homogeneous array of numbers or strings;
        # unique also drops adjacent duplicates after the sort.
        if is_arr_val(v) == 0 {
            eprint("error: sort and unique need an array")
            return 3
        }
        let ints: List<Int> = []
        let ss: List<Str> = []
        let mut scnt = 0
        let mut snums = 1
        let mut sstrs = 1
        let mut cells = heads[v - arr_base()]
        while cells >= 0 {
            let sv = cvals[cells]
            if is_num_val(sv) == 1 {
                sstrs = 0
                ints.push(sv)
            } else if is_str_val(sv) == 1 {
                snums = 0
                ss.push(spool[sv - str_base()])
            } else {
                snums = 0
                sstrs = 0
            }
            scnt += 1
            cells = cnexts[cells]
        }
        if scnt <= 1 {
            return eval_filter(v, si + 1, n_main, seg_kind, seg_pay, sel_meta, sel_lit, sel_span, tail, compact, out, spool, heads, ckeys, cvals, cnexts)
        }
        if snums == 0 and sstrs == 0 {
            eprint("error: sort and unique need all numbers or all strings")
            return 3
        }
        heads.push(0 - 1)
        let shidx = heads.len() - 1
        let mut sprev = 0 - 1
        if snums == 1 {
            ints.sort()
            let mut ii = 0
            while ii < ints.len() {
                let mut keep = 1
                if kind == 11 {
                    if ii > 0 {
                        if ints[ii] == ints[ii - 1] { keep = 0 }
                    }
                }
                if keep == 1 {
                    ckeys.push(0 - 1)
                    cvals.push(ints[ii])
                    cnexts.push(0 - 1)
                    let scell = cvals.len() - 1
                    if sprev < 0 {
                        heads[shidx] = scell
                    } else {
                        cnexts[sprev] = scell
                    }
                    sprev = scell
                }
                ii += 1
            }
        } else {
            ss.sort()
            let mut si2 = 0
            while si2 < ss.len() {
                let mut keep2 = 1
                if kind == 11 {
                    if si2 > 0 {
                        if ss[si2] == ss[si2 - 1] { keep2 = 0 }
                    }
                }
                if keep2 == 1 {
                    ckeys.push(0 - 1)
                    cvals.push(intern(ss[si2], spool))
                    cnexts.push(0 - 1)
                    let scell2 = cvals.len() - 1
                    if sprev < 0 {
                        heads[shidx] = scell2
                    } else {
                        cnexts[sprev] = scell2
                    }
                    sprev = scell2
                }
                si2 += 1
            }
        }
        return eval_filter(arr_base() + shidx, si + 1, n_main, seg_kind, seg_pay, sel_meta, sel_lit, sel_span, tail, compact, out, spool, heads, ckeys, cvals, cnexts)
    }
    if kind == 12 {
        # object construction: walk each entry's path from the piped
        # value; later duplicate keys overwrite earlier ones.
        let opay = seg_pay[si]
        let oastart = opay / 4096
        let oacount = opay - oastart * 4096
        heads.push(0 - 1)
        let ohidx = heads.len() - 1
        let mut oprev = 0 - 1
        let mut oa = oastart
        while oa < oastart + oacount {
            let oval = walk_path(v, sel_span[oa * 2], sel_span[oa * 2 + 1], seg_kind, seg_pay, spool, heads, ckeys, cvals, cnexts)
            if oval == err_val() { return 3 }
            let okey = sel_lit[oa]
            let oname = spool[okey - str_base()]
            let mut dup = 0 - 1
            let mut ocell = heads[ohidx]
            while ocell >= 0 {
                if spool[ckeys[ocell] - str_base()] == oname {
                    dup = ocell
                    ocell = 0 - 1
                } else {
                    ocell = cnexts[ocell]
                }
            }
            if dup >= 0 {
                cvals[dup] = oval
            } else {
                ckeys.push(okey)
                cvals.push(oval)
                cnexts.push(0 - 1)
                let ncell2 = cvals.len() - 1
                if oprev < 0 {
                    heads[ohidx] = ncell2
                } else {
                    cnexts[oprev] = ncell2
                }
                oprev = ncell2
            }
            oa += 1
        }
        return eval_filter(obj_base() + ohidx, si + 1, n_main, seg_kind, seg_pay, sel_meta, sel_lit, sel_span, tail, compact, out, spool, heads, ckeys, cvals, cnexts)
    }
    if kind == 13 {
        # string template: literal chunks interleave with rendered
        # holes — hole strings render raw, everything else renders as
        # compact JSON.
        let tpay = seg_pay[si]
        let tastart = tpay / 4096
        let tacount = tpay - tastart * 4096
        let rb = str_builder_new()
        let mut ta = tastart
        while ta < tastart + tacount {
            let ochunk = str_builder_append(rb, spool[sel_lit[ta] - str_base()])
            if sel_meta[ta] == 10 * 16 {
                let hv = walk_path(v, sel_span[ta * 2], sel_span[ta * 2 + 1], seg_kind, seg_pay, spool, heads, ckeys, cvals, cnexts)
                if hv == err_val() { return 3 }
                if is_str_val(hv) == 1 {
                    let oraw = str_builder_append(rb, spool[hv - str_base()])
                } else {
                    let ojson = str_builder_append(rb, render_compact(hv, spool, heads, ckeys, cvals, cnexts))
                }
            }
            ta += 1
        }
        return eval_filter(intern(str_builder_finish(rb), spool), si + 1, n_main, seg_kind, seg_pay, sel_meta, sel_lit, sel_span, tail, compact, out, spool, heads, ckeys, cvals, cnexts)
    }
    if kind == 7 {
        # join("sep"): strings verbatim, numbers stringified, null
        # empty; anything else is loud.
        if is_arr_val(v) == 0 {
            eprint("error: join needs an array")
            return 3
        }
        let sep = spool[seg_pay[si] - str_base()]
        let jb = str_builder_new()
        let mut firstj = 1
        let mut cellj = heads[v - arr_base()]
        while cellj >= 0 {
            if firstj == 0 {
                let osep = str_builder_append(jb, sep)
            }
            firstj = 0
            let jv = cvals[cellj]
            if is_str_val(jv) == 1 {
                let ostr = str_builder_append(jb, spool[jv - str_base()])
            } else if is_num_val(jv) == 1 {
                let onum = str_builder_append(jb, f"{jv}")
            } else {
                if jv != null_val() {
                    eprint("error: join elements must be strings, numbers, or null")
                    return 3
                }
            }
            cellj = cnexts[cellj]
        }
        return eval_filter(intern(str_builder_finish(jb), spool), si + 1, n_main, seg_kind, seg_pay, sel_meta, sel_lit, sel_span, tail, compact, out, spool, heads, ckeys, cvals, cnexts)
    }
    let mut base = arr_base()
    if is_obj_val(v) == 1 {
        base = obj_base()
    } else {
        if is_arr_val(v) == 0 {
            eprint("error: cannot iterate a non-container")
            return 3
        }
    }
    let mut cell3 = heads[v - base]
    while cell3 >= 0 {
        let st = eval_filter(cvals[cell3], si + 1, n_main, seg_kind, seg_pay, sel_meta, sel_lit, sel_span, tail, compact, out, spool, heads, ckeys, cvals, cnexts)
        if st != 0 { return st }
        cell3 = cnexts[cell3]
    }
    0
}

# Parse the document and run the filter; outputs collect into out.
# Returns 0 ok, 3 on any parse/filter/type error.
fn run_query(src: Str, filter: Str, compact: Int, out: List<Str>) -> Int {
    let spool: List<Str> = []
    let heads: List<Int> = []
    let ckeys: List<Int> = []
    let cvals: List<Int> = []
    let cnexts: List<Int> = []
    let seg_kind: List<Int> = []
    let seg_pay: List<Int> = []
    let sel_meta: List<Int> = []
    let sel_lit: List<Int> = []
    let sel_span: List<Int> = []
    let meta_out: List<Int> = []
    let tail = parse_filter(filter, seg_kind, seg_pay, sel_meta, sel_lit, sel_span, spool, meta_out)
    if tail < 0 { return 3 }
    let n_main = meta_out[0]
    let (v, np) = parse_json_value(src, 0, spool, heads, ckeys, cvals, cnexts)
    if v == err_val() { return 3 }
    let rest = skip_json_ws(src, np)
    if rest < src.len() {
        eprint("error: trailing bytes after JSON document")
        return 3
    }
    eval_filter(v, 0, n_main, seg_kind, seg_pay, sel_meta, sel_lit, sel_span, tail, compact, out, spool, heads, ckeys, cvals, cnexts)
}

fn check_query(src: Str, filter: Str, compact: Int, want_status: Int, want_lines: Str) -> Int {
    let out: List<Str> = []
    let st = run_query(src, filter, compact, out)
    if st != want_status { return 0 }
    let b = str_builder_new()
    let mut i = 0
    while i < out.len() {
        if i > 0 {
            let nl = str_builder_append(b, "\n")
        }
        let o = str_builder_append(b, out[i])
        i += 1
    }
    if str_builder_finish(b) != want_lines { return 0 }
    1
}

fn self_test() -> Int {
    # parser + identity (compact)
    if check_query("{\"a\":1}", ".", 1, 0, "{\"a\":1}") != 1 { return 1 }
    if check_query(" { \"a\" : [ 1 , -2 , true , false , null ] } ", ".", 1, 0, "{\"a\":[1,-2,true,false,null]}") != 1 { return 2 }
    if check_query("\"a\\\"b\\nc\"", ".", 1, 0, "\"a\\\"b\\nc\"") != 1 { return 3 }
    if check_query("[]", ".", 1, 0, "[]") != 1 { return 4 }
    if check_query("{}", ".", 1, 0, "{}") != 1 { return 5 }
    if check_query("-42", ".", 1, 0, "-42") != 1 { return 6 }
    # field chains, indexes, iteration
    if check_query("{\"a\":{\"b\":[10,20,30]}}", ".a.b[1]", 1, 0, "20") != 1 { return 7 }
    if check_query("[1,2,3]", ".[]", 1, 0, "1\n2\n3") != 1 { return 8 }
    if check_query("{\"x\":1,\"y\":2}", ".[]", 1, 0, "1\n2") != 1 { return 9 }
    if check_query("{\"users\":[{\"name\":\"ann\"},{\"name\":\"bo\"}]}", ".users[].name", 1, 0, "\"ann\"\n\"bo\"") != 1 { return 10 }
    if check_query("[[1,2],[3,4]]", ".[1][0]", 1, 0, "3") != 1 { return 11 }
    # missing fields and out-of-range indexes chain as null
    if check_query("{\"a\":1}", ".missing", 1, 0, "null") != 1 { return 12 }
    if check_query("{\"a\":1}", ".missing.deeper", 1, 0, "null") != 1 { return 13 }
    if check_query("[1]", ".[9]", 1, 0, "null") != 1 { return 14 }
    # pipe tails
    if check_query("[10,20]", ". | length", 1, 0, "2") != 1 { return 15 }
    if check_query("\"abc\"", ". | length", 1, 0, "3") != 1 { return 16 }
    if check_query("{\"a\":1,\"b\":2}", ". | length", 1, 0, "2") != 1 { return 17 }
    if check_query("null", ". | length", 1, 0, "0") != 1 { return 18 }
    if check_query("{\"b\":1,\"a\":2}", ". | keys", 1, 0, "[\"a\",\"b\"]") != 1 { return 19 }
    if check_query("{\"users\":[1,2,3]}", ".users | length", 1, 0, "3") != 1 { return 20 }
    # pretty rendering
    if check_query("{\"a\":[1]}", ".", 0, 0, "{\n  \"a\": [\n    1\n  ]\n}") != 1 { return 21 }
    # loud rejections: parse, number, type, filter, trailing
    if check_query("{\"a\":", ".", 1, 3, "") != 1 { return 22 }
    if check_query("1.5", ".", 1, 3, "") != 1 { return 23 }
    if check_query("1e3", ".", 1, 3, "") != 1 { return 24 }
    if check_query("\"a\\u0041\"", ".", 1, 3, "") != 1 { return 25 }
    if check_query("[1] 2", ".", 1, 3, "") != 1 { return 26 }
    if check_query("[1]", ".a", 1, 3, "") != 1 { return 27 }
    if check_query("42", ".[]", 1, 3, "") != 1 { return 28 }
    if check_query("{\"a\":1}", ".a | keys", 1, 3, "") != 1 { return 29 }
    if check_query("{\"a\":1}", "a", 1, 3, "") != 1 { return 30 }
    if check_query("{\"a\":1}", ". | nope", 1, 3, "") != 1 { return 31 }
    # pipe stages: pure paths concatenate, tails stay terminal
    if check_query("{\"users\":[{\"name\":\"ann\"},{\"name\":\"bo\"}]}", ".users[] | .name", 1, 0, "\"ann\"\n\"bo\"") != 1 { return 32 }
    if check_query("{\"a\":{\"b\":[7,8]}}", ".a | .b | length", 1, 0, "2") != 1 { return 33 }
    # select: ordered, equality, string, bare truthiness
    if check_query("[{\"n\":1},{\"n\":5},{\"n\":9}]", ".[] | select(.n > 4) | .n", 1, 0, "5\n9") != 1 { return 34 }
    if check_query("[{\"n\":1},{\"n\":5}]", ".[] | select(.n == 5)", 1, 0, "{\"n\":5}") != 1 { return 35 }
    if check_query("[{\"t\":\"a\"},{\"t\":\"b\"}]", ".[] | select(.t == \"b\") | .t", 1, 0, "\"b\"") != 1 { return 36 }
    if check_query("[{\"t\":\"a\"},{\"t\":\"b\"}]", ".[] | select(.t != \"b\") | .t", 1, 0, "\"a\"") != 1 { return 37 }
    if check_query("[{\"ok\":true,\"n\":1},{\"ok\":false,\"n\":2},{\"n\":3}]", ".[] | select(.ok) | .n", 1, 0, "1") != 1 { return 38 }
    # negative indexes count from the end
    if check_query("[10,20,30]", ".[-1]", 1, 0, "30") != 1 { return 39 }
    if check_query("[10,20,30]", ".[-4]", 1, 0, "null") != 1 { return 40 }
    if check_query("{\"xs\":[1,2,3]}", ".xs[-2]", 1, 0, "2") != 1 { return 41 }
    # loud select rejections: iteration inside, bad literal, type error
    if check_query("[1]", ".[] | select(.a[] > 1)", 1, 3, "") != 1 { return 42 }
    if check_query("[1]", ".[] | select(.a > x)", 1, 3, "") != 1 { return 43 }
    if check_query("[{\"a\":\"s\"}]", ".[] | select(.a > 1)", 1, 3, "") != 1 { return 44 }
    if check_query("{\"a\":1}", ". | length | .a", 1, 3, "") != 1 { return 45 }
    # map: projection, null for missing, non-array is loud
    if check_query("{\"users\":[{\"n\":1},{\"n\":2}]}", ".users | map(.n)", 1, 0, "[1,2]") != 1 { return 46 }
    if check_query("[{\"n\":1},{}]", ". | map(.n)", 1, 0, "[1,null]") != 1 { return 47 }
    if check_query("{\"a\":1}", ". | map(.a)", 1, 3, "") != 1 { return 48 }
    if check_query("{\"users\":[{\"n\":1},{\"n\":2}]}", ".users | map(.n) | length", 1, 0, "2") != 1 { return 49 }
    # has: object keys, array indexes, wrong types are loud
    if check_query("{\"a\":1}", ". | has(\"a\")", 1, 0, "true") != 1 { return 50 }
    if check_query("{\"a\":1}", ". | has(\"b\")", 1, 0, "false") != 1 { return 51 }
    if check_query("[10,20]", ". | has(1)", 1, 0, "true") != 1 { return 52 }
    if check_query("[10,20]", ". | has(2)", 1, 0, "false") != 1 { return 53 }
    if check_query("[10]", ". | has(\"a\")", 1, 3, "") != 1 { return 54 }
    # first/last sugar over indexes
    if check_query("[10,20,30]", ". | first", 1, 0, "10") != 1 { return 55 }
    if check_query("[10,20,30]", ". | last", 1, 0, "30") != 1 { return 56 }
    if check_query("[]", ". | first", 1, 0, "null") != 1 { return 57 }
    # select multi-condition: and, or, and-over-or precedence
    if check_query("[{\"n\":5,\"ok\":true},{\"n\":9,\"ok\":false},{\"n\":9,\"ok\":true}]", ".[] | select(.n > 6 and .ok) | .n", 1, 0, "9") != 1 { return 58 }
    if check_query("[{\"n\":1},{\"n\":5},{\"n\":9}]", ".[] | select(.n == 1 or .n == 9) | .n", 1, 0, "1\n9") != 1 { return 59 }
    if check_query("[{\"n\":2,\"t\":\"a\"},{\"n\":9,\"t\":\"b\"},{\"n\":9,\"t\":\"a\"}]", ".[] | select(.n > 8 and .t == \"a\" or .n < 3) | .n", 1, 0, "2\n9") != 1 { return 60 }
    # add: number sums, string concatenation, empty null, mixed loud
    if check_query("[1,2,3]", ". | add", 1, 0, "6") != 1 { return 61 }
    if check_query("[\"a\",\"b\",\"c\"]", ". | add", 1, 0, "\"abc\"") != 1 { return 62 }
    if check_query("[]", ". | add", 1, 0, "null") != 1 { return 63 }
    if check_query("[1,\"a\"]", ". | add", 1, 3, "") != 1 { return 64 }
    if check_query("{\"xs\":[{\"n\":20},{\"n\":22}]}", ".xs | map(.n) | add", 1, 0, "42") != 1 { return 65 }
    # join: strings, stringified numbers, null empties, loud otherwise
    if check_query("[\"a\",\"b\",\"c\"]", ". | join(\", \")", 1, 0, "\"a, b, c\"") != 1 { return 66 }
    if check_query("[1,null,\"x\"]", ". | join(\"-\")", 1, 0, "\"1--x\"") != 1 { return 67 }
    if check_query("[]", ". | join(\",\")", 1, 0, "\"\"") != 1 { return 68 }
    if check_query("[[1]]", ". | join(\",\")", 1, 3, "") != 1 { return 69 }
    # min/max: numbers only, empty null
    if check_query("[5,2,9]", ". | min", 1, 0, "2") != 1 { return 70 }
    if check_query("[5,2,9]", ". | max", 1, 0, "9") != 1 { return 71 }
    if check_query("[]", ". | min", 1, 0, "null") != 1 { return 72 }
    if check_query("[\"a\"]", ". | max", 1, 3, "") != 1 { return 73 }
    # has nested in select, alone and chained
    if check_query("[{\"a\":1},{\"b\":2},{\"a\":3}]", ".[] | select(has(\"a\")) | . | length", 1, 0, "1\n1") != 1 { return 74 }
    if check_query("[{\"a\":9},{\"b\":2},{\"a\":1}]", ".[] | select(has(\"a\") and .a > 5) | .a", 1, 0, "9") != 1 { return 75 }
    # sort/unique: numbers, strings, small arrays, mixed is loud
    if check_query("[5,2,9,2]", ". | sort", 1, 0, "[2,2,5,9]") != 1 { return 76 }
    if check_query("[\"b\",\"a\",\"c\"]", ". | sort", 1, 0, "[\"a\",\"b\",\"c\"]") != 1 { return 77 }
    if check_query("[5,2,9,2]", ". | unique", 1, 0, "[2,5,9]") != 1 { return 78 }
    if check_query("[\"b\",\"a\",\"b\"]", ". | unique", 1, 0, "[\"a\",\"b\"]") != 1 { return 79 }
    if check_query("[]", ". | sort", 1, 0, "[]") != 1 { return 80 }
    if check_query("[1,\"a\"]", ". | sort", 1, 3, "") != 1 { return 81 }
    if check_query("{\"xs\":[3,1,2]}", ".xs | sort | last", 1, 0, "3") != 1 { return 82 }
    # object construction: explicit paths, shorthand, quoted keys,
    # duplicate keys overwrite, missing paths turn null
    if check_query("{\"user\":{\"name\":\"ann\",\"age\":30}}", ".user | {name: .name}", 1, 0, "{\"name\":\"ann\"}") != 1 { return 83 }
    if check_query("{\"name\":\"bo\",\"age\":25}", ". | {name, age}", 1, 0, "{\"name\":\"bo\",\"age\":25}") != 1 { return 84 }
    if check_query("{\"a\":1}", ". | {\"k v\": .a}", 1, 0, "{\"k v\":1}") != 1 { return 85 }
    if check_query("{\"a\":1,\"b\":2}", ". | {x: .a, x: .b}", 1, 0, "{\"x\":2}") != 1 { return 86 }
    if check_query("{\"a\":1}", ". | {z: .missing}", 1, 0, "{\"z\":null}") != 1 { return 87 }
    if check_query("{\"users\":[{\"name\":\"ann\",\"age\":30},{\"name\":\"bo\",\"age\":25}]}", ".users[] | {who: .name}", 1, 0, "{\"who\":\"ann\"}\n{\"who\":\"bo\"}") != 1 { return 88 }
    # string templates: raw strings, compact JSON for the rest
    if check_query("{\"name\":\"ann\",\"age\":30}", ". | \"\\(.name) is \\(.age)\"", 1, 0, "\"ann is 30\"") != 1 { return 89 }
    if check_query("{\"users\":[{\"name\":\"ann\"},{\"name\":\"bo\"}]}", ".users[] | \"hi \\(.name)\"", 1, 0, "\"hi ann\"\n\"hi bo\"") != 1 { return 90 }
    if check_query("{\"a\":[1,2]}", ". | \"xs=\\(.a)\"", 1, 0, "\"xs=[1,2]\"") != 1 { return 91 }
    if check_query("{\"a\":1}", ". | \"m=\\(.missing)\"", 1, 0, "\"m=null\"") != 1 { return 92 }
    if check_query("{\"a\":1}", ". | \"plain\"", 1, 0, "\"plain\"") != 1 { return 93 }
    if check_query("{\"a\":1}", ". | \"b=\\\\z\"", 1, 0, "\"b=\\\\z\"") != 1 { return 94 }
    if check_query("{\"name\":\"bo\",\"age\":25}", ". | \"\\(.name)/\\(.age)\" | length", 1, 0, "5") != 1 { return 95 }
    42
}

fn read_stdin_all() -> Str {
    let b = str_builder_new()
    let mut going = 1
    while going == 1 {
        let line = stdin_read_line()
        if line == "" {
            going = 0
        } else {
            let o = str_builder_append(b, line)
        }
    }
    str_builder_finish(b)
}

fn usage() -> Int {
    print("usage: vaisjq                 (self-test)")
    print("       vaisjq [-c] <filter> [file|-]")
    2
}

fn main() -> Int {
    if proc_argc() == 0 { return self_test() }
    let mut ai = 0
    let mut compact = 0
    if proc_arg(0) == "-c" {
        compact = 1
        ai = 1
    }
    if proc_argc() < ai + 1 { return usage() }
    if proc_argc() > ai + 2 { return usage() }
    let filter = proc_arg(ai)
    let mut src = ""
    if proc_argc() == ai + 2 {
        let path = proc_arg(ai + 1)
        if path == "-" {
            src = read_stdin_all()
        } else {
            if fs_exists(path) != 1 {
                eprint(f"error: file not found: {path}")
                return 3
            }
            src = fs_read_text(path)
        }
    } else {
        src = read_stdin_all()
    }
    let out: List<Str> = []
    let st = run_query(src, filter, compact, out)
    if st != 0 { return st }
    let mut i = 0
    while i < out.len() {
        print(out[i])
        i += 1
    }
    0
}

# expect: 42
# Mixed-type tuple returns: `fn f(...) -> (T1, T2)` with Int and Str
# elements lowers through a generated struct on both engines, `return
# (a, b)` builds it positionally, and `let (x, y) = f(...)` destructures
# through a hidden temp. Int-only tuples (e59) stay covered; this adds
# the general element mix that was deferred until struct-field Str
# reads were verified.
fn split_head(s: Str) -> (Str, Int) {
    return (s, s.len())
}

fn label_pair(n: Int) -> (Int, Str) {
    if n > 0 { return (n, "plus") }
    return (0 - n, "minus")
}

fn word_stats(a: Str, b: Str) -> (Str, Str) {
    if a.len() >= b.len() { return (a, b) }
    return (b, a)
}

fn main() -> Int {
    let (head, n) = split_head("vais")
    if head != "vais" { return 1 }
    if n != 4 { return 2 }

    let (mag, sign) = label_pair(0 - 7)
    if mag != 7 { return 3 }
    if sign != "minus" { return 4 }

    let (longer, shorter) = word_stats("alpha", "of")
    if longer != "alpha" { return 5 }
    if shorter != "of" { return 6 }

    let (m2, s2) = label_pair(30)
    if s2 != "plus" { return 7 }

    # 30 + 4 + 7 + 5 - 2 - 2 = 42
    m2 + n + mag + longer.len() - shorter.len() - 2
}

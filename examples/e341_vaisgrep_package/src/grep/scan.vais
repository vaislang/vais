# Line scanning helpers shared by the vaisgrep subcommand paths.

fn match_lines_into(body: Str, pattern: Str, out: List<Str>) -> Int {
    for (i, line) in body.lines().enumerate() {
        if line.has(pattern) {
            out.push(f"{i + 1}: {line}")
        }
    }
    out.len()
}

fn count_matches(body: Str, pattern: Str) -> Int {
    let mut hits = 0
    for line in body.lines() {
        if line.has(pattern) { hits += 1 }
    }
    hits
}

fn is_text_name(name: Str) -> Int {
    if name.ends(".txt") or name.ends(".vais") or name.ends(".md") { return 1 }
    0
}

fn tree_matches(pattern: Str, dir: Str) -> Int {
    let mut total = 0
    for name in dir.files() {
        if is_text_name(name) == 1 {
            let fp = path_join(dir, name)
            total += count_matches(fp.read(), pattern)
        }
    }
    for sub in dir.dirs() {
        total += @(pattern, path_join(dir, sub))
    }
    total
}

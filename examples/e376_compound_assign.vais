# expect: 42
# Compound assignment (Token-Density Stage 1c): `place += expr` and the -=,
# *=, /=, %= family lower in the shared driver pass to
# `place = place op (expr)`, so both engines keep their single assignment
# lowering and the parenthesized right side preserves precedence. The left
# side must be a plain place — a local, list index, or struct field chain —
# and call results or string keys on the left are loud front errors, so the
# textual duplication can never duplicate side effects. Previously `x += 2`
# was rejected by vais-check but the full engine silently ignored the
# increment; both silent paths are closed.

struct Acc {
    total: Int,
    hits: Int,
}

fn main() -> Int {
    let mut x = 40
    x += 2
    if x != 42 { return 1 }
    x -= 12
    if x != 30 { return 2 }
    x *= 3
    if x != 90 { return 3 }
    x /= 2
    if x != 45 { return 4 }
    x %= 7
    if x != 3 { return 5 }

    # List index and struct field places compound-assign on both engines.
    let xs: List<Int> = [40, 1]
    xs[0] += 2
    if xs[0] != 42 { return 6 }
    let mut a = Acc { total: 40, hits: 0 }
    a.total += 2
    a.hits += 1
    if a.total != 42 { return 7 }
    if a.hits != 1 { return 8 }

    # Loop accumulation with inline-brace statements.
    let mut total = 0
    let mut i = 0
    while i < 5 {
        if i != 2 { total += i * 2 }
        i += 1
    }
    if total != 16 { return 9 }

    # The parenthesized right side keeps precedence: sum -= n - 5 subtracts 2.
    let n = 7
    let mut sum = 0
    sum += n + 1
    sum -= n - 5
    if sum != 6 { return 10 }

    # 36 + 6 = 42.
    return 36 + sum
}

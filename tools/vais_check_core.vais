    if word_token_at(src, i, 105, 115, 105, 122, 101, 0, 0, 5) == 1 { return 1 }
    return 0
}

fn method_call_at(src: Str, i: Int, name: Str) -> Int {
    if src[i] != 46 { return 0 }
    if text_at(src, i + 1, name) == 0 { return 0 }
    let mut j = i + 1 + name.len()
    while j < src.len() {
        if is_space(src[j]) == 1 { j = j + 1 }
        else {
            if src[j] == 40 { return 1 }
            return 0
        }
    }
    return 0
}

fn if_let_at(src: Str, i: Int) -> Int {
    if word_text_at(src, i, "if") == 0 { return 0 }
    let mut j = i + 2
    let mut saw_space = 0
    while j < src.len() {
        if is_space(src[j]) == 1 {
            saw_space = 1
            j = j + 1
        } else {
            if saw_space == 1 {
                if word_text_at(src, j, "let") == 1 { return 1 }
            }
            return 0
        }
    }
    return 0
}

# Last significant char of the line [ls, le): string-aware, trailing
# comments stripped; 0 when blank or comment-only.
fn line_last_sig(src: Str, ls: Int, le: Int) -> Int {
    let mut delim = 0
    let mut last = 0
    let mut i = ls
    while i < le {
        let c = src[i]
        if delim == 34 {
            if c == 92 {
                i = i + 2
                last = 120
                continue
            }
            if c == 34 { delim = 0 }
            last = c
            i = i + 1
        } else if delim == 96 {
            if c == 96 { delim = 0 }
            last = c
            i = i + 1
        } else if c == 35 {
            return last
        } else if c == 34 or c == 96 {
            delim = c
            last = c
            i = i + 1
        } else {
            if c != 32 and c != 9 { last = c }
            i = i + 1
        }
    }
    return last
}

# The significant character preceding position i: same-line non-space, or
# the last significant char of the nearest earlier non-blank line.
fn prev_sig_char(src: Str, i: Int) -> Int {
    let mut j = i - 1
    while j >= 0 and (src[j] == 32 or src[j] == 9) { j = j - 1 }
    if j < 0 { return 0 }
    if src[j] != 10 { return src[j] }
    # walk earlier lines until one carries a significant char
    let mut le = j
    while le > 0 {
        let mut ls = le - 1
        while ls > 0 and src[ls - 1] != 10 { ls = ls - 1 }
        let last = line_last_sig(src, ls, le)
        if last != 0 { return last }
        le = ls - 1
    }
    return 0
}

# A `then` word earlier on the same line marks an if-expression, whose
# `else` is not block-attached.
fn then_before_on_line(src: Str, i: Int) -> Int {
    let mut ls = i
    while ls > 0 and src[ls - 1] != 10 { ls = ls - 1 }
    let mut j = ls
    while j + 4 <= i {
        if word_text_at(src, j, "then") == 1 { return 1 }
        j = j + 1
    }
    return 0
}

fn dangling_else_at(src: Str, i: Int) -> Int {
    if word_text_at(src, i, "else") == 0 { return 0 }
    if then_before_on_line(src, i) == 1 { return 0 }
    if prev_sig_char(src, i) == 125 { return 0 }
    return 1
}

fn else_if_typo_at(src: Str, i: Int) -> Int {
    if word_text_at(src, i, "elsif") == 1 { return 1 }
    if word_text_at(src, i, "elif") == 1 { return 1 }
    return 0
}

# A compound-assign left side must be a plain place — a local, list index, or
# struct field chain without calls or string keys — mirroring the driver
# lowering rule so the textual `place = place op (expr)` desugar cannot
# duplicate side effects.
fn compound_lhs_plain_at(src: Str, i: Int) -> Int {
    let mut b = i - 1
    let mut scan = true
    while scan {
        if b < 0 { scan = false }
        else {
            let c = src[b]
            if c == 10 or c == 123 or c == 125 or c == 59 { scan = false }
            else { b = b - 1 }
        }
    }
    let mut j = b + 1
    while j < i and (src[j] == 32 or src[j] == 9) { j = j + 1 }
    if j >= i { return 0 }
    if is_ident_start(src[j]) == 0 { return 0 }
    let mut brackets = 0
    while j < i {
        let c = src[j]
        if is_ident_char(c) == 1 { j = j + 1 }
        else if c == 46 or c == 32 or c == 9 { j = j + 1 }
        else if c == 91 { brackets = brackets + 1; j = j + 1 }
        else if c == 93 {
            brackets = brackets - 1
            if brackets < 0 { return 0 }
            j = j + 1
        }
        else { return 0 }
    }
    if brackets != 0 { return 0 }
    return 1
}

fn compound_assign_at(src: Str, i: Int) -> Int {
    let c = src[i]
    if c == 43 or c == 45 or c == 42 or c == 47 or c == 37 {
        if i + 1 < src.len() {
            if src[i + 1] == 61 {
                if i + 2 < src.len() {
                    if src[i + 2] == 61 { return 0 }
                }
                return 1
            }
        }
    }
    return 0
}

fn is_verified_escape(c: Int) -> Int {
    if c == 110 { return 1 }
    if c == 116 { return 1 }
    if c == 114 { return 1 }
    if c == 34 { return 1 }
    if c == 92 { return 1 }
    return 0
}

fn is_verified_char_escape(c: Int) -> Int {
    if c == 110 { return 1 }
    if c == 116 { return 1 }
    if c == 114 { return 1 }
    if c == 48 { return 1 }
    if c == 39 { return 1 }
    if c == 92 { return 1 }
    return 0
}

# Walk one f-string literal whose opening quote sits at src[i] and report
# invalid holes: empty holes, holes containing quotes/backticks/braces/
# backslashes, unterminated holes, and lone `}` (a literal brace is `{{` or
# `}}`). Valid f-strings pass silently; the driver lowers them to
# str_concat/Str chains.
fn fstring_issues(path: Str, src: Str, i: Int) -> Int {
    let mut issues = 0
    let mut j = i + 1
    while j < src.len() {
        let c = src[j]
        if c == 92 {
            j = j + 2
        } else if c == 34 {
            return issues
        } else if c == 123 {
            if j + 1 < src.len() and src[j + 1] == 123 {
                j = j + 2
            } else {
                let mut k = j + 1
                let mut close = 0 - 1
                let mut bad = 0 - 1
                let mut scan = true
                while scan and k < src.len() {
                    let h = src[k]
                    if h == 125 { close = k; scan = false }
                    else if h == 34 { scan = false }
                    else if h == 123 or h == 96 or h == 92 { bad = k; scan = false }
                    else { k = k + 1 }
                }
                if bad >= 0 {
                    issues = issues + report_issue_at(path, src, bad, "error: f-string hole cannot contain quotes, backticks, braces, or backslashes", "  help: keep the hole a plain expression; move string literals into a local first")
                    j = bad + 1
                } else if close < 0 {
                    issues = issues + report_issue_at(path, src, j, "error: f-string hole is missing }", "  help: close the {expr} hole inside the f-string")
                    return issues + 0
                } else {
                    let mut empty = 1
                    let mut e = j + 1
                    while e < close {
                        if src[e] != 32 and src[e] != 9 { empty = 0 }
                        e = e + 1
                    }
                    if empty == 1 {
                        issues = issues + report_issue_at(path, src, j, "error: f-string hole is empty", "  help: write {expr} with an Int or Str expression inside")
                    }
                    j = close + 1
                }
            }
        } else if c == 125 {
            if j + 1 < src.len() and src[j + 1] == 125 {
                j = j + 2
            } else {
                issues = issues + report_issue_at(path, src, j, "error: unmatched } in f-string", "  help: write a literal brace as }} or open a {expr} hole")
                j = j + 1
            }
        } else {
            j = j + 1
        }
    }
    return issues
}

# Walk one double-quoted literal starting at src[i] == 34 and report every
# escape outside the verified \n, \t, \r, \", \\ set. Backtick literals stay
# raw and are never escape-checked.
fn string_escape_issues(path: Str, src: Str, i: Int) -> Int {
    let mut issues = 0
    let mut j = i + 1
    while j < src.len() {
        let c = src[j]
        if c == 92 {
            if j + 1 < src.len() {
                if is_verified_escape(src[j + 1]) == 0 {
                    issues = issues + report_issue_at(path, src, j, "error: unknown string escape", "  help: use \\n, \\t, \\r, \\\", or \\\\; write a literal backslash as \\\\")
                }
            }
            j = j + 2
        } else if c == 34 {
            return issues
        } else {
            j = j + 1
        }
    }
    return issues
}

fn skip_quoted(src: Str, i: Int, delim: Int) -> Int {
    let mut j = i + 1
    while j < src.len() {
        let c = src[j]
        if c == 92 {
            j = j + 2
        } else if c == delim {
            return j + 1
        } else {
            j = j + 1
        }
    }
    return j
}

fn skip_to_line_end(src: Str, i: Int) -> Int {
    let mut j = i
    while j < src.len() {
        if src[j] == 10 { return j }
        j = j + 1
    }
    return j
}

fn line_no_at(src: Str, pos: Int) -> Int {
    let mut line = 1
    let mut i = 0
    while i < pos {
        if src[i] == 10 { line = line + 1 }
        i = i + 1
    }
    return line
}

fn col_no_at(src: Str, pos: Int) -> Int {
    let mut col = 1
    let mut i = 0
    while i < pos {
        if src[i] == 10 { col = 1 } else { col = col + 1 }
        i = i + 1
    }
    return col
}

fn report_issue_at(path: Str, src: Str, pos: Int, message: Str, help: Str) -> Int {
    let line = line_no_at(src, pos)
    let col = col_no_at(src, pos)
    print(message)
    print(`  --> {path}:{line}:{col}`)
    print(help)
    return 1
}

# ---- heterotype local rebinding (mirrors the native front check) ----
# The emitters key local storage by name with first-match lookup, so a name
# rebound to a provably different kind silently reuses the first layout.
# Kinds come only from unambiguous spellings; anything else is unknown and
# never reported, which keeps the long-verified same-type aliasing idiom.

fn rebind_upper_ident(a: Str) -> Int {
    if a.len() == 0 { return 0 }
    let c0 = a[0]
    if c0 < 65 or c0 > 90 { return 0 }
    let an = a.len()
    for ci in 1..an {
        if is_ident_char(a[ci]) == 0 { return 0 }
    }
    return 1
}

fn rebind_anno_kind(anno: Str) -> Str {
    let a = anno.trim()
    if a == "Int" { return "INT" }
    if a == "Str" { return "STR" }
    if a.starts("Map<") { return "MAP" }
    if a.starts("List<") and a.ends(">") and a.len() > 6 {
        let inner = str_slice(a, 5, a.len() - 6)
        let inner_t = inner.trim()
        return f"LIST:{inner_t}"
    }
    if rebind_upper_ident(a) == 1 { return f"STRUCT:{a}" }
    return ""
}

# Line prefix up to any comment, tracking string state so quote characters
# inside literals never hide or fake a `#`.
fn rebind_strip_comment(line: Str) -> Str {
    let mut delim = 0
    let mut esc = 0
    let mut j = 0
    let n = line.len()
    while j < n {
        let c = line[j]
        if esc == 1 { esc = 0 }
        else if delim == 34 and c == 92 { esc = 1 }
        else if delim != 0 {
            if c == delim { delim = 0 }
        } else if c == 35 {
            return str_slice(line, 0, j)
        } else if c == 34 or c == 96 or c == 39 {
            delim = c
        }
        j = j + 1
    }
    return line
}

fn rebind_int_literal(r: Str) -> Int {
    let mut j = 0
    if r.len() > 0 and r[0] == 45 { j = 1 }
    if j >= r.len() { return 0 }
    let rn = r.len()
    for dj in j..rn {
        let dc = r[dj]
        if dc < 48 or dc > 57 { return 0 }
    }
    return 1
}

# RHS shape without table access: "INT", "STR", "STRUCT:X", "IDX:head" (an
# index into a possibly tracked list local), or "" when unresolvable.
fn rebind_rhs_shape(rhs_in: Str) -> Str {
    let mut r = rhs_in.trim()
    if r.ends(";") {
        let cut = str_slice(r, 0, r.len() - 1)
        r = cut.trim()
    }
    if r.len() == 0 { return "" }
    if rebind_int_literal(r) == 1 { return "INT" }
    if r.starts("\"") { return "STR" }
    if r.starts("f\"") { return "STR" }
    let rn = r.len()
    let mut ie = 0
    while ie < rn and is_ident_char(r[ie]) == 1 { ie = ie + 1 }
    if ie > 0 {
        let head = str_slice(r, 0, ie)
        let mut ws = ie
        while ws < rn and r[ws] == 32 { ws = ws + 1 }
        if ws < rn and r[ws] == 123 and rebind_upper_ident(head) == 1 {
            return f"STRUCT:{head}"
        }
        if ie < rn and r[ie] == 91 and r[rn - 1] == 93 {
            let mut nested = 0
            for qi in (ie + 1)..(rn - 1) {
                if r[qi] == 93 { nested = 1 }
            }
            if nested == 0 { return f"IDX:{head}" }
        }
    }
    return ""
}

# Kind strings are interned to Int ids so every table stays on the
# battle-tested Map<Str,Int> surface: 0 = not bound, 1 = bound with an
# unknown kind, 2+ = a concrete kind.
fn rebind_kind_id(reg: Map<Str,Int>, names: List<Str>, kind: Str) -> Int {
    if kind == "" { return 1 }
    let known = reg.get(kind, 0)
    if known != 0 { return known }
    let fresh = names.len() + 2
    reg.insert(kind, fresh)
    names.push(kind)
    return fresh
}

fn rebind_scan(path: Str, src: Str) -> Int {
    let mut issues = 0
    let binds: Map<Str,Int> = {}
    let lists: Map<Str,Int> = {}
    let reg: Map<Str,Int> = {}
    let regn: List<Str> = []
    let mut fidx = 0
    let mut off = 0
    for raw in src.lines() {
        let clean = rebind_strip_comment(raw)
        let cn = clean.len()
        let mut p = 0
        # up to two bindings per line (the tuple for-head); kind ids use
        # 0 = no binding parsed, 1 = bound with unknown kind, 2+ = concrete
        let mut name1 = ""
        let mut kid1 = 1
        let mut pos1 = 0
        let mut name2 = ""
        let mut pos2 = 0
        while p < cn and (clean[p] == 32 or clean[p] == 9) { p = p + 1 }
        if word_text_at(clean, p, "fn") == 1 {
            fidx += 1
        } else if word_text_at(clean, p, "let") == 1 {
            let mut q = p + 3
            while q < cn and clean[q] == 32 { q = q + 1 }
            if word_text_at(clean, q, "mut") == 1 {
                q = q + 3
                while q < cn and clean[q] == 32 { q = q + 1 }
            }
            let ns = q
            while q < cn and is_ident_char(clean[q]) == 1 { q = q + 1 }
            if q > ns {
                let mut ws2 = q
                while ws2 < cn and clean[ws2] == 32 { ws2 = ws2 + 1 }
                let mut eq = 0 - 1
                let mut anno = ""
                if ws2 < cn and clean[ws2] == 58 {
                    let mut ae = ws2 + 1
                    while ae < cn and clean[ae] != 61 { ae = ae + 1 }
                    if ae < cn {
                        anno = str_slice(clean, ws2 + 1, ae - ws2 - 1)
                        eq = ae
                    }
                } else if ws2 < cn and clean[ws2] == 61 {
                    eq = ws2
                }
                let mut usable = 0
                if eq >= 0 { usable = 1 }
                if usable == 1 and eq + 1 < cn and clean[eq + 1] == 61 { usable = 0 }
                if usable == 1 {
                    name1 = str_slice(clean, ns, q - ns)
                    pos1 = off + ns
                    let anno_t = anno.trim()
                    if anno_t.len() > 0 {
                        let akind = rebind_anno_kind(anno)
                        kid1 = rebind_kind_id(reg, regn, akind)
                        if akind.starts("LIST:") {
                            let lkey = f"{fidx}.{name1}"
                            let inner = str_slice(akind, 5, akind.len() - 5)
                            let ekind = rebind_anno_kind(inner)
                            lists.insert(lkey, rebind_kind_id(reg, regn, ekind))
                        }
                    } else {
                        let rhs = str_slice(clean, eq + 1, cn - eq - 1)
                        let shape = rebind_rhs_shape(rhs)
                        if shape.starts("IDX:") {
                            let head = str_slice(shape, 4, shape.len() - 4)
                            let hkey = f"{fidx}.{head}"
                            let hid = lists.get(hkey, 0)
                            if hid != 0 { kid1 = hid }
                        } else {
                            kid1 = rebind_kind_id(reg, regn, shape)
                        }
                    }
                }
            }
        } else if word_text_at(clean, p, "for") == 1 {
            let mut fq = p + 3
            while fq < cn and clean[fq] == 32 { fq = fq + 1 }
            if fq < cn and clean[fq] == 40 {
                let mut ta = fq + 1
                while ta < cn and clean[ta] == 32 { ta = ta + 1 }
                let tas = ta
                while ta < cn and is_ident_char(clean[ta]) == 1 { ta = ta + 1 }
                let mut tb = ta
                while tb < cn and (clean[tb] == 32 or clean[tb] == 44) { tb = tb + 1 }
                let tbs = tb
                while tb < cn and is_ident_char(clean[tb]) == 1 { tb = tb + 1 }
                if ta > tas and tb > tbs {
                    name1 = str_slice(clean, tas, ta - tas)
                    kid1 = rebind_kind_id(reg, regn, "INT")
                    pos1 = off + tas
                    name2 = str_slice(clean, tbs, tb - tbs)
                    pos2 = off + tbs
                }
            } else {
                let fns = fq
                while fq < cn and is_ident_char(clean[fq]) == 1 { fq = fq + 1 }
                if fq > fns {
                    let mut iw = fq
                    while iw < cn and clean[iw] == 32 { iw = iw + 1 }
                    if word_text_at(clean, iw, "in") == 1 {
                        let mut cs = iw + 2
                        while cs < cn and clean[cs] == 32 { cs = cs + 1 }
                        let mut ce = cs
                        while ce < cn and clean[ce] != 123 { ce = ce + 1 }
                        if ce < cn {
                            name1 = str_slice(clean, fns, fq - fns)
                            pos1 = off + fns
                            let coll_raw = str_slice(clean, cs, ce - cs)
                            let coll = coll_raw.trim()
                            if coll.has("..") { kid1 = rebind_kind_id(reg, regn, "INT") }
                            else {
                                let mut pure = 1
                                let coln = coll.len()
                                if coln == 0 { pure = 0 }
                                for pj in 0..coln {
                                    if is_ident_char(coll[pj]) == 0 { pure = 0 }
                                }
                                if pure == 1 {
                                    let ckey = f"{fidx}.{coll}"
                                    let cid = lists.get(ckey, 0)
                                    if cid != 0 { kid1 = cid }
                                }
                            }
                        }
                    }
                }
            }
        }
        if name1 != "" {
            let key1 = f"{fidx}.{name1}"
            let old1 = binds.get(key1, 0)
            if old1 >= 2 and kid1 >= 2 and old1 != kid1 {
                let msg1 = f"error: local {name1} is rebound with a different type"
                issues = issues + report_issue_at(path, src, pos1, msg1, "  help: the first binding fixes this name's storage layout for the whole function; use a distinct name for the second binding")
            }
            if old1 == 0 { binds.insert(key1, kid1) }
            else if old1 == 1 and kid1 >= 2 { binds.insert(key1, kid1) }
        }
        if name2 != "" {
            let key2 = f"{fidx}.{name2}"
            let old2 = binds.get(key2, 0)
            if old2 == 0 { binds.insert(key2, 1) }
        }
        off = off + raw.len() + 1
    }
    return issues
}

fn check_text(src: Str) -> Int {
    return check_text_at("memory", src)
}

fn check_text_at(path: Str, src: Str) -> Int {
    let mut issues = rebind_scan(path, src)
    let mut i = 0
    let mut at_line_start = 1
    while i < src.len() {
        let c = src[i]
        let mut handled = 0

        if c == 10 {
            at_line_start = 1
            i = i + 1
            handled = 1
        } else if c == 34 {
            issues = issues + string_escape_issues(path, src, i)
            if i > 0 and src[i - 1] == 102 {
                if i < 2 or is_ident_char(src[i - 2]) == 0 {
                    issues = issues + fstring_issues(path, src, i)
                }
            }
            i = skip_quoted(src, i, 34)
            at_line_start = 0
            handled = 1
        } else if c == 96 {
            i = skip_quoted(src, i, 96)
            at_line_start = 0
            handled = 1
        } else if c == 35 {
            i = skip_to_line_end(src, i)
            handled = 1
        } else if c == 39 and i + 3 < src.len() and src[i + 1] == 92 and src[i + 3] == 39 {
            if is_verified_char_escape(src[i + 2]) == 0 {
                issues = issues + report_issue_at(path, src, i + 1, "error: unknown char escape", "  help: use '\\n', '\\t', '\\r', '\\0', '\\\\', or '\\''")
            }
            i = i + 4
            at_line_start = 0
            handled = 1
        } else if at_line_start == 1 {
            if c == 32 or c == 9 or c == 13 {
                i = i + 1
                handled = 1
            } else if word_token_at(src, i, 109, 111, 100, 117, 108, 101, 0, 6) == 1 {
                issues = issues + report_issue_at(path, src, i, "error: module declarations are not implemented yet", "  help: omit this declaration now")
                i = skip_to_line_end(src, i)
                handled = 1
            } else if word_token_at(src, i, 112, 97, 99, 107, 97, 103, 101, 7) == 1 {
                issues = issues + report_issue_at(path, src, i, "error: package declarations are not implemented yet", "  help: omit this declaration now")
                i = skip_to_line_end(src, i)
                handled = 1
            } else if word_token_at(src, i, 117, 115, 101, 0, 0, 0, 0, 3) == 1 {
                issues = issues + report_issue_at(path, src, i, "error: use declarations are not Vais imports", "  help: use import path")
                i = skip_to_line_end(src, i)
                handled = 1
            } else if word_token_at(src, i, 105, 109, 112, 111, 114, 116, 0, 6) == 1 {
                if invalid_import_path_at(src, i) == 1 {
                    issues = issues + report_issue_at(path, src, i, "error: invalid import path", "  help: write a static dotted local import such as import math.add")
                }
                i = skip_to_line_end(src, i)
                handled = 1
            } else {
                at_line_start = 0
            }
        }

        if handled == 0 {
            if i + 1 < src.len() {
                if src[i] == 38 and src[i + 1] == 38 {
                    issues = issues + report_issue_at(path, src, i, "error: logical AND uses word and", "  help: use the word and")
                    i = i + 2
                    handled = 1
                } else if src[i] == 124 and src[i + 1] == 124 {
                    issues = issues + report_issue_at(path, src, i, "error: logical OR uses word or", "  help: use the word or")
                    i = i + 2
                    handled = 1
                }
            }
        }

        if handled == 0 {
            if src[i] == 46 and word_text_at(src, i + 1, "contains_key") == 1 {
                issues = issues + report_issue_at(path, src, i + 1, "error: contains_key is not a Map method", "  help: use contains(key); verified Map methods are insert, remove, clear, get, get_opt, contains, len, key_at, and value_at")
                i = i + 13
                handled = 1
            }
        }

        if handled == 0 {
            if logical_not_at(src, i) == 1 {
                issues = issues + report_issue_at(path, src, i, "error: logical NOT uses word not", "  help: use the word not")
                i = i + 1
                handled = 1
            } else if as_cast_at(src, i) == 1 {
                issues = issues + report_issue_at(path, src, i, "error: type conversion uses a constructor call", "  help: use the target type as a call")
                i = i + 2
                handled = 1
            } else if generic_ctor_at(src, i) == 1 {
                issues = issues + report_issue_at(path, src, i, "error: generic constructor uses a literal", "  help: use a collection literal")
                i = skip_to_line_end(src, i)
                handled = 1
            } else if invalid_main_signature_at(src, i) == 1 {
                issues = issues + report_issue_at(path, src, i, "error: main must be fn main() -> Int", "  help: write the entrypoint as fn main() -> Int")
                i = skip_to_line_end(src, i)
                handled = 1
            } else if fn_missing_return_type_at(src, i) == 1 {
                issues = issues + report_issue_at(path, src, i, "error: helper functions must return a verified type", "  help: write fn name(args) -> Int, -> Bool, -> Char, -> Str, a declared struct type, or another verified return type")
                i = skip_to_line_end(src, i)
                handled = 1
            } else if i + 1 < src.len() {
                if src[i] == 58 and src[i + 1] == 58 {
                    issues = issues + report_issue_at(path, src, i, "error: double colon path uses dot", "  help: use dot path access")
                    i = i + 2
                    handled = 1
                }
            }
        }

        if handled == 0 {
            if unsupported_option_generic_at(src, i) == 1 {
                issues = issues + report_issue_at(path, src, i, "error: only Option<Int> is verified for now", "  help: use Option<Int> in this slice; generic Option<T> and nested Option/Result payloads are not verified yet")
                i = skip_generic_or_line_end(src, i)
                handled = 1
            } else if unsupported_result_generic_at(src, i) == 1 {
                issues = issues + report_issue_at(path, src, i, "error: only Result<Int,Int>, Result<Str,Int>, Result<Str,Str>, and Result<DeclaredStruct,Int> are verified for now", "  help: use Result<Int,Int>, Result<Str,Int>, Result<Str,Str>, or Result<DeclaredStruct,Int> where the payload struct is declared in this file; generic Result<T,E>, other non-Int error payloads, and nested Option/Result payloads are not verified yet")
                i = skip_generic_or_line_end(src, i)
                handled = 1
            } else if unsupported_map_generic_at(src, i) == 1 {
                issues = issues + report_issue_at(path, src, i, "error: only concrete Map<Int,Int>, Map<Int,Bool>, Map<Int,Char>, Map<Str,Int>, Map<Str,Bool>, Map<Str,Char>, and Map<Str,Str> are verified for now", "  help: use one of the verified concrete Map<K,V> shapes in this slice; broader generic Map forms are not verified yet")
                i = skip_generic_or_line_end(src, i)
                handled = 1
            } else if vec_macro_at(src, i) == 1 {
                issues = issues + report_issue_at(path, src, i, "error: list macro spelling is not Vais", "  help: use a list literal")
                i = i + 3
                handled = 1
            } else if word_token_at(src, i, 83, 116, 114, 105, 110, 103, 0, 6) == 1 {
                issues = issues + report_issue_at(path, src, i, "error: string type spelling is Str", "  help: use Str")
                i = i + 6
                handled = 1
            } else if vec_type_at(src, i) == 1 {
                issues = issues + report_issue_at(path, src, i, "error: list type spelling is List", "  help: use List")
                i = i + 3
                handled = 1
            } else if hashmap_type_at(src, i) == 1 {
                issues = issues + report_issue_at(path, src, i, "error: map type spelling is Map", "  help: use Map")
                i = i + 7
                handled = 1
            } else if rust_scalar_type_at(src, i) == 1 {
                issues = issues + report_issue_at(path, src, i, "error: scalar type spelling is capitalized", "  help: use Vais scalar type names")
                i = i + 1
                handled = 1
            }
        }

        if handled == 0 {
            if method_call_at(src, i, "to_string") == 1 {
                issues = issues + report_issue_at(path, src, i, "error: string conversion uses Str call", "  help: use Str as a conversion call")
                i = i + 1
                handled = 1
            } else if method_call_at(src, i, "unwrap") == 1 {
                issues = issues + report_issue_at(path, src, i, "error: unchecked option access is not Vais", "  help: use branching or propagation")
                i = i + 1
                handled = 1
            } else if method_call_at(src, i, "expect") == 1 {
                issues = issues + report_issue_at(path, src, i, "error: unchecked result access is not Vais", "  help: use branching or propagation")
                i = i + 1
                handled = 1
            } else if if_let_at(src, i) == 1 {
                issues = issues + report_issue_at(path, src, i, "error: pattern conditional uses match", "  help: use pattern branching")
                i = i + 2
                handled = 1
            } else if else_if_typo_at(src, i) == 1 {
                issues = issues + report_issue_at(path, src, i, "error: else if is two words", "  help: write else if")
                i = i + 4
                handled = 1
            } else if dangling_else_at(src, i) == 1 {
                issues = issues + report_issue_at(path, src, i, "error: else must follow a closed block", "  help: write } else if cond { or } else { after the closing brace, or close the previous block first")
                i = i + 4
                handled = 1
            } else if compound_assign_at(src, i) == 1 {
                if compound_lhs_plain_at(src, i) == 0 {
                    issues = issues + report_issue_at(path, src, i, "error: compound assignment needs a plain place on the left", "  help: write a local, list index, or struct field on the left; call results cannot be compound-assigned")
                }
                i = i + 2
                handled = 1
            }
        }

        if handled == 0 {
            i = i + 1
        }
    }
    return issues
}

fn check_file(path: Str) -> Int {
    let src = fs_read_text(path)
    return check_text_at(path, src)
}
